---
import '@fontsource-variable/urbanist';
import { SITE, NAV } from '../config';
import { TEMAS_DO_SITE, atributo, type Tema } from '../lib/temas';
import Arroba from '../components/marca/Arroba.astro';
import Completo from '../components/marca/Completo.astro';
// Arquivo da fonte usado em quase todo o texto: pedido logo no início do carregamento.
import fonteLatina from '@fontsource-variable/urbanist/files/urbanist-latin-wght-normal.woff2?url';

interface Props {
  titulo?: string;
  descricao?: string;
  // Tema inicial da página. Sem ele, a página sorteia um par da marca a cada visita.
  tema?: Tema;
  // Imagem que aparece quando o link da página é compartilhado (caminho do site ou endereço completo).
  imagem?: string;
  // Página que não deve aparecer em buscadores (a de erro, por exemplo).
  semIndice?: boolean;
}
const { titulo, descricao = SITE.descricao, tema, imagem, semIndice = false } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${SITE.nome}` : `${SITE.nome}, ${SITE.lema.toLowerCase()}`;
const inicial = tema ?? TEMAS_DO_SITE[0];
const sorteio = TEMAS_DO_SITE.map(atributo);
const caminho = Astro.url.pathname;
// Endereço oficial da página, sem barra no fim (a Home fica só com o domínio).
const canonico = new URL(caminho.replace(/(?:\/index)?(?:\.html)?\/?$/, '') || '/', Astro.site).href;
const imagemCompleta = imagem ? new URL(imagem, Astro.site).href : undefined;
---
<!doctype html>
<html lang="pt-BR" style={`--fundo:${inicial.fundo};--texto:${inicial.texto};--destaque:${inicial.destaque};--enfeite:${inicial.destaque}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    {semIndice ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonico} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    {!semIndice && <meta property="og:url" content={canonico} />}
    {imagemCompleta && <meta property="og:image" content={imagemCompleta} />}
    <meta name="twitter:card" content={imagemCompleta ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={fonteLatina} as="font" type="font/woff2" crossorigin />
    <script is:inline define:vars={{ sorteio, sortear: !tema }}>
      // Roda antes de a página aparecer, para não piscar a cor errada.
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add('js');
        // Aparelho de toque (celular, tablet). No iPhone com iOS 26, o Safari desenha uma banda
        // sólida atrás das suas barras sempre que existe um elemento preso (sticky ou fixed)
        // encostado na borda da tela, mesmo invisível. Por isso, no toque, as cenas que param
        // na tela inteira (parede da Home, fotos do Trio no Sobre) não usam sticky:
        // - pino-novo: a cena fica parada por uma animação ligada à rolagem;
        // - toque: navegador sem essa animação; a cena simplesmente rola com a página.
        if (window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
          raiz.classList.add(window.CSS && CSS.supports('animation-timeline: view()') ? 'pino-novo' : 'toque');
        }
        // Cor de enfeite: o destaque usado sobre uma superfície da cor do texto (faixa,
        // menu, rodapé). Enfeite não precisa de contraste de leitura, mas também não pode
        // sumir: se o destaque fica perto demais da superfície, mantém o matiz e a
        // saturação e anda só na luminosidade até se destacar (3:1).
        var lin = function (v) { v /= 255; return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
        var rgb = function (h) { h = h.trim(); var m = h.match(/^rgba?\(([^)]+)\)/); if (m) return m[1].split(/[ ,\/]+/).slice(0, 3).map(Number); h = h.replace('#', ''); if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2]; var c = [0, 2, 4].map(function (i) { return parseInt(h.substr(i, 2), 16); }); if (c.some(isNaN)) throw 0; return c; };
        var lum = function (c) { return 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]); };
        var razao = function (a, b) { var x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
        var paraLab = function (c) {
          var r = lin(c[0]), g = lin(c[1]), b = lin(c[2]);
          var l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b), m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b), s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
          return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
        };
        var deLab = function (L, A, B) {
          var l = Math.pow(L + 0.3963377774 * A + 0.2158037573 * B, 3), m = Math.pow(L - 0.1055613458 * A - 0.0638541728 * B, 3), s = Math.pow(L - 0.0894841775 * A - 1.291485548 * B, 3);
          return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
        };
        var gama = function (v) { v = Math.min(1, Math.max(0, v)); return Math.round(255 * (v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055)); };
        window.__enfeite = function (destaque, superficie, minimo) {
          minimo = minimo || 3;
          try {
            var d = rgb(destaque), s = rgb(superficie);
            if (razao(d, s) >= minimo) return destaque;
            var lab = paraLab(d), passo = lum(s) > 0.35 ? -0.02 : 0.02, cor = d;
            for (var L = lab[0]; L > 0.12 && L < 0.97; L += passo) {
              // Fora do que a tela mostra, cede saturação aos poucos em vez de mudar de matiz.
              for (var k = 1; k > 0; k -= 0.05) {
                var x = deLab(L, lab[1] * k, lab[2] * k);
                if (x.every(function (v) { return v > -0.002 && v < 1.002; })) { cor = x.map(gama); break; }
              }
              if (razao(cor, s) >= minimo) break;
            }
            return 'rgb(' + cor.join(',') + ')';
          } catch (e) { return destaque; }
        };
        // Cores derivadas do tema. A regra (do Gui): texto que se lê precisa de contraste de
        // leitura; enfeite pode ousar, desde que continue visível.
        // --enfeite: o destaque sobre uma superfície da cor do texto, só visível (3:1).
        // --destaque-texto: o destaque quando colore texto pequeno sobre o fundo (4,5:1).
        // --suave: o texto secundário, também de leitura (4,5:1).
        // Quando o tema já passa, as cores ficam como são: só anda quem ficaria ilegível.
        window.__derivadas = function (fundo, texto, destaque) {
          var raiz = document.documentElement;
          raiz.style.setProperty('--enfeite', window.__enfeite(destaque, texto));
          raiz.style.setProperty('--destaque-texto', window.__enfeite(destaque, fundo, 4.5));
          var suave = destaque;
          try { var t = rgb(texto), f = rgb(fundo); suave = 'rgb(' + [0, 1, 2].map(function (i) { return Math.round(t[i] * 0.72 + f[i] * 0.28); }).join(',') + ')'; } catch (e) { suave = texto; }
          raiz.style.setProperty('--suave', window.__enfeite(suave, fundo, 4.5));
        };
        // Cada página sorteia um tema do site ao abrir, nunca o mesmo da página anterior.
        // Páginas sem tema próprio já abrem nele; nas outras, ele entra nos
        // trechos marcados com data-tema="sorteio".
        var anterior = null;
        try { anterior = sessionStorage.getItem('ultimo-tema'); } catch (e) {}
        var opcoes = sorteio.filter(function (t) { return t !== anterior; });
        var escolhido = opcoes[Math.floor(Math.random() * opcoes.length)];
        try { sessionStorage.setItem('ultimo-tema', escolhido); } catch (e) {}
        raiz.dataset.temaSorteado = escolhido;
        if (sortear) {
          var t = escolhido.split('|');
          raiz.style.setProperty('--fundo', t[0]);
          raiz.style.setProperty('--texto', t[1]);
          raiz.style.setProperty('--destaque', t[2]);
        }
        window.__derivadas(raiz.style.getPropertyValue('--fundo'), raiz.style.getPropertyValue('--texto'), raiz.style.getPropertyValue('--destaque'));
      })();
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <a class="topo-marca" href="/" aria-label="@bsurda, página inicial">
        <span class="tm-eco tm-eco1" aria-hidden="true"><Arroba /></span>
        <span class="tm-eco tm-eco2" aria-hidden="true"><Arroba /></span>
        <Arroba />
      </a>
      <button class="menu-abre" type="button" aria-haspopup="dialog" aria-controls="menu-celular">
        Menu<span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav class="topo-nav" aria-label="Principal">
        {NAV.map((item) => (
          <a href={item.href} aria-current={caminho.startsWith(item.href) ? 'page' : undefined}>{item.rotulo}</a>
        ))}
        <a class="nav-fora" href={SITE.fotos} target="_blank" rel="noopener">Fotos<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h8v8M12.5 3.5 3.5 12.5" /></svg><span class="so-leitor"> (abre em outra aba)</span></a>
      </nav>
    </header>

    <!-- Menu do celular: abre em tela cheia -->
    <dialog class="menu" id="menu-celular" aria-label="Menu">
      <div class="menu-topo">
        <a class="topo-marca" href="/" aria-label="@bsurda, página inicial"><Arroba /></a>
        <button class="menu-fecha" type="button" autofocus>Fechar<span aria-hidden="true"></span><span aria-hidden="true"></span></button>
      </div>
      <nav aria-label="Principal">
        <ul>
          {NAV.map((item, i) => (
            <li style={`--i:${i}`}><a href={item.href} aria-current={caminho.startsWith(item.href) ? 'page' : undefined}>{item.rotulo}</a></li>
          ))}
        </ul>
      </nav>
      <ul class="menu-fora">
        <li><a href={SITE.ingressos} target="_blank" rel="noopener">Ingressos</a></li>
        <li><a class="nav-fora" href={SITE.fotos} target="_blank" rel="noopener">Fotos<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h8v8M12.5 3.5 3.5 12.5" /></svg></a></li>
        <li><a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </dialog>

    <main id="conteudo">
      <slot />
    </main>

    <!-- Rodapé: um bloco próprio, com as cores invertidas em relação à página -->
    <footer class="rodape">
      <div class="rodape-topo">
        <nav class="rodape-nav" aria-label="Rodapé">
          <ul>
            {NAV.map((item, i) => (
              <li><a href={item.href} data-anima="sobe" style={`--i:${i}`}>{item.rotulo}</a></li>
            ))}
          </ul>
        </nav>
        <div class="rodape-lado">
          <div data-anima="surge">
            <h2>Fora daqui</h2>
            <ul>
              <li><a href={SITE.ingressos} target="_blank" rel="noopener">Ingressos na Shotgun</a></li>
              <li><a href={SITE.fotos} target="_blank" rel="noopener">Fotos no Pixieset</a></li>
              <li><a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
              <li><a href={SITE.redes.tiktok} target="_blank" rel="noopener">TikTok</a></li>
              <li><a href={SITE.redes.x} target="_blank" rel="noopener">X</a></li>
            </ul>
          </div>
          <div data-anima="surge" style="--i:1">
            <h2>Fale com a gente</h2>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><a href="/parceiros">Sua marca na @bsurda</a></li>
            </ul>
          </div>
        </div>
      </div>
      <p class="rodape-fim"><span aria-hidden="true"></span><b><em>© {new Date().getFullYear()} @bsurda.</em> <em>{SITE.lema}, desde 2009.</em> <em>Belo Horizonte.</em></b><span aria-hidden="true"></span></p>
      <a class="rodape-marca" href="/" aria-label="@bsurda, página inicial" data-anima="rodape">
        <span class="rm-eco rm-eco2" aria-hidden="true"><Completo /></span>
        <span class="rm-eco rm-eco1" aria-hidden="true"><Completo /></span>
        <Completo />
      </a>
    </footer>


    <script>
      // Troca o tema conforme o trecho que está no meio da tela.
      const raiz = document.documentElement;
      const aplicar = (texto: string | undefined) => {
        if (!texto) return;
        const [fundo, cor, destaque] = texto.split('|');
        raiz.style.setProperty('--fundo', fundo);
        raiz.style.setProperty('--texto', cor);
        raiz.style.setProperty('--destaque', destaque);
        (window as any).__derivadas?.(fundo, cor, destaque);
        conferirBarra(900);
      };
      setTimeout(() => raiz.classList.add('troca-viva'), 500);

      // Barras do Safari no iPhone. Elas copiam a cor de fundo do <html>, mas a cor da página
      // troca aos poucos (0,7s) e o Safari às vezes fica com uma cor do meio do caminho. Aí,
      // quando as barras reaparecem (ao rolar para cima, por exemplo), surge uma faixa de cor
      // diferente da página. Quando a troca termina e a rolagem para, o fundo do <html> recebe
      // por dois quadros a mesma cor com uma diferença invisível (1 em 255) e volta: é só um
      // aviso para o Safari olhar de novo. A cor continua sendo a da página.
      let espera = 0;
      const olharDeNovo = () => {
        const canais = getComputedStyle(raiz).backgroundColor.match(/\d+/g);
        if (!canais || canais.length < 3) return;
        const azul = Number(canais[2]);
        raiz.style.backgroundColor = `rgb(${canais[0]}, ${canais[1]}, ${azul < 255 ? azul + 1 : azul - 1})`;
        requestAnimationFrame(() => requestAnimationFrame(() => { raiz.style.backgroundColor = ''; }));
      };
      let pendente = false;
      function conferirBarra(ms: number) { pendente = true; window.clearTimeout(espera); espera = window.setTimeout(() => { pendente = false; olharDeNovo(); }, ms); }
      window.addEventListener('scroll', () => { if (pendente) conferirBarra(350); }, { passive: true });
      // Ao abrir a página e ao voltar para ela pelo botão de voltar do navegador.
      window.addEventListener('pageshow', () => conferirBarra(700));
      // Trechos com paleta fechada (data-tema-lista): sorteiam um tema só entre os permitidos.
      document.querySelectorAll<HTMLElement>('[data-tema-lista]').forEach((trecho) => {
        const opcoes = (trecho.dataset.temaLista ?? '').split(';').filter(Boolean);
        if (opcoes.length > 0) trecho.dataset.tema = opcoes[Math.floor(Math.random() * opcoes.length)];
      });
      let fechado: HTMLElement | null = null;

      const trechos = document.querySelectorAll<HTMLElement>('[data-tema]');
      if (trechos.length > 0) {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              const alvo = entrada.target as HTMLElement;
              if (fechado) continue;
              aplicar(alvo.dataset.tema === 'sorteio' ? raiz.dataset.temaSorteado ?? alvo.dataset.reserva : alvo.dataset.tema);
            }
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        trechos.forEach((trecho) => observador.observe(trecho));
      }
      // Um trecho de paleta fechada manda na página enquanto qualquer parte dele estiver
      // na tela, e não só quando chega ao meio: assim ele nunca aparece com as cores do vizinho.
      const temaDe = (t: HTMLElement) => (t.dataset.tema === 'sorteio' ? raiz.dataset.temaSorteado ?? t.dataset.reserva : t.dataset.tema);
      const fechados = document.querySelectorAll<HTMLElement>('[data-tema-lista]');
      if (fechados.length > 0) {
        const guarda = new IntersectionObserver((entradas) => {
          for (const entrada of entradas) {
            const alvo = entrada.target as HTMLElement;
            if (entrada.isIntersecting) { fechado = alvo; aplicar(alvo.dataset.tema); }
            else if (fechado === alvo) {
              fechado = null;
              // Ao sair, volta para o tema do trecho que está no meio da tela.
              const meio = window.innerHeight / 2;
              // Se o meio da tela não cai em nenhum trecho com tema, vale o último que ficou acima.
              const outros = [...trechos].filter((t) => t !== alvo);
              const atual = outros.find((t) => { const r = t.getBoundingClientRect(); return r.top <= meio && r.bottom >= meio; })
                ?? outros.filter((t) => t.getBoundingClientRect().top <= meio).pop();
              aplicar(atual ? temaDe(atual) : raiz.dataset.temaSorteado);
            }
          }
        });
        fechados.forEach((t) => guarda.observe(t));
      }

      // Barras presas no topo, em aparelho de toque (atalho de anos da Agenda, ano dos Marcos no
      // Sobre). No iPhone, uma barra sticky no topo basta para o Safari criar a banda atrás das
      // suas barras, embaixo também, e ela não some mais. Então, no toque, a barra acompanha a
      // rolagem por animação (ver "Barras presas" no CSS). A animação precisa saber a altura do
      // trecho por onde a barra anda e a da própria barra: é o que se mede aqui.
      if (raiz.classList.contains('pino-novo') && 'ResizeObserver' in window) {
        document.querySelectorAll<HTMLElement>('[data-trilho]').forEach((trilho) => {
          const barra = trilho.querySelector<HTMLElement>(':scope > [data-barra]');
          if (!barra) return;
          const medir = () => {
            trilho.style.setProperty('--alt', `${trilho.offsetHeight}px`);
            trilho.style.setProperty('--barra', `${barra.offsetHeight}px`);
          };
          const olho = new ResizeObserver(medir);
          olho.observe(trilho);
          olho.observe(barra);
          medir();
        });
      }

      // Menu do celular.
      const menu = document.querySelector<HTMLDialogElement>('#menu-celular');
      document.querySelector('.menu-abre')?.addEventListener('click', () => menu?.showModal());
      document.querySelector('.menu-fecha')?.addEventListener('click', () => menu?.close());
      menu?.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });

      // Animações de entrada: cada elemento anima uma vez, quando entra na tela.
      const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const animados = document.querySelectorAll<HTMLElement>('[data-anima]');
      if (animados.length > 0) {
        const entrada = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('visto', 'entrou');
              entrada.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        animados.forEach((el) => entrada.observe(el));
      }

      // Ecos: abrem sozinhos na primeira vez e depois respondem à rolagem, como o
      // logo da abertura. Nos títulos, os ecos se soltam quando o título chega e
      // se recolhem conforme ele se aproxima das bordas da tela. No rodapé, o logo
      // solta os ecos à medida que aparece.
      const titulos = [...document.querySelectorAll<HTMLElement>('.ecoa')];
      const marca = document.querySelector<HTMLElement>('.rodape-marca');
      if (!calmo) {
        const soltos = new Set<HTMLElement>();
        const limita = (v: number) => Math.min(1, Math.max(0, v));
        const abre = (el: HTMLElement) => {
          el.classList.add('eco-aberto');
          // Passada a abertura inicial, a rolagem assume.
          setTimeout(() => { el.classList.add('ecoa-solta'); soltos.add(el); mede(); }, 1500);
        };
        for (const t of titulos) {
          if (!t.dataset.anima) { requestAnimationFrame(() => abre(t)); continue; }
          const espera = new MutationObserver(() => {
            if (!t.classList.contains('entrou')) return;
            espera.disconnect();
            abre(t);
          });
          espera.observe(t, { attributes: true, attributeFilter: ['class'] });
        }
        let marcado = false;
        function mede() {
          marcado = false;
          const tela = window.innerHeight;
          for (const t of soltos) {
            const r = t.getBoundingClientRect();
            if (r.bottom < -200 || r.top > tela + 200) continue;
            const centro = (r.top + r.height / 2) / tela;
            t.style.setProperty('--ab', limita(Math.min((1 - centro) / 0.22, (centro + 0.02) / 0.28)).toFixed(3));
          }
          if (marca) {
            const r = marca.getBoundingClientRect();
            if (r.top < tela + 200) marca.style.setProperty('--ab', limita((tela - r.top) / (r.height * 0.6)).toFixed(3));
          }
        }
        window.addEventListener('scroll', () => { if (!marcado) { marcado = true; requestAnimationFrame(mede); } }, { passive: true });
        window.addEventListener('resize', mede);
        if (marca) marca.style.setProperty('--ab', '0');
        mede();
      }

      // Blocos e cartões de evento: a capa inclina de leve acompanhando o cursor.
      // No cartão, o degradê do fundo também se desloca.
      if (!calmo && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.ev, .cartao').forEach((bloco) => {
          const capa = bloco.querySelector<HTMLElement>('.ev-capa img, .cartao-capa img');
          const forca = bloco.classList.contains('cartao') ? 12 : 7;
          bloco.addEventListener('pointermove', (e) => {
            const r = bloco.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
