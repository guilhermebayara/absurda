---
import '@fontsource-variable/urbanist';
import { SITE, NAV } from '../config';
import { TEMAS_DO_SITE, atributo, type Tema } from '../lib/temas';
import Arroba from '../components/marca/Arroba.astro';
import Completo from '../components/marca/Completo.astro';

interface Props {
  titulo?: string;
  descricao?: string;
  // Tema inicial da página. Sem ele, a página sorteia um par da marca a cada visita.
  tema?: Tema;
}
const { titulo, descricao = SITE.descricao, tema } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${SITE.nome}` : `${SITE.nome}, ${SITE.lema.toLowerCase()}`;
const inicial = tema ?? TEMAS_DO_SITE[0];
const sorteio = TEMAS_DO_SITE.map(atributo);
const caminho = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR" style={`--fundo:${inicial.fundo};--texto:${inicial.texto};--destaque:${inicial.destaque}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ sorteio, sortear: !tema }}>
      // Roda antes de a página aparecer, para não piscar a cor errada.
      (function () {
        var raiz = document.documentElement;
        raiz.classList.add('js');
        // Cada página sorteia um tema do site ao abrir, nunca o mesmo da página anterior.
        // Páginas sem tema próprio já abrem nele; nas outras, ele entra nos
        // trechos marcados com data-tema="sorteio".
        var anterior = null;
        try { anterior = sessionStorage.getItem('ultimo-tema'); } catch (e) {}
        var opcoes = sorteio.filter(function (t) { return t !== anterior; });
        var escolhido = opcoes[Math.floor(Math.random() * opcoes.length)];
        try { sessionStorage.setItem('ultimo-tema', escolhido); } catch (e) {}
        raiz.dataset.temaSorteado = escolhido;
        if (sortear) {
          var t = escolhido.split('|');
          raiz.style.setProperty('--fundo', t[0]);
          raiz.style.setProperty('--texto', t[1]);
          raiz.style.setProperty('--destaque', t[2]);
        }
      })();
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <a class="topo-marca" href="/" aria-label="@bsurda, página inicial">
        <span class="tm-eco tm-eco1" aria-hidden="true"><Arroba /></span>
        <span class="tm-eco tm-eco2" aria-hidden="true"><Arroba /></span>
        <Arroba />
      </a>
      <button class="menu-abre" type="button" aria-haspopup="dialog" aria-controls="menu-celular">
        Menu<span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav class="topo-nav" aria-label="Principal">
        {NAV.map((item) => (
          <a href={item.href} aria-current={caminho.startsWith(item.href) ? 'page' : undefined}>{item.rotulo}</a>
        ))}
        <a href={SITE.fotos} target="_blank" rel="noopener">Fotos</a>
      </nav>
    </header>

    <!-- Menu do celular: abre em tela cheia -->
    <dialog class="menu" id="menu-celular" aria-label="Menu">
      <div class="menu-topo">
        <a class="topo-marca" href="/" aria-label="@bsurda, página inicial"><Arroba /></a>
        <button class="menu-fecha" type="button">Fechar<span aria-hidden="true"></span><span aria-hidden="true"></span></button>
      </div>
      <nav aria-label="Principal">
        <ul>
          {NAV.map((item, i) => (
            <li style={`--i:${i}`}><a href={item.href} aria-current={caminho.startsWith(item.href) ? 'page' : undefined}>{item.rotulo}</a></li>
          ))}
        </ul>
      </nav>
      <ul class="menu-fora">
        <li><a href={SITE.ingressos} target="_blank" rel="noopener">Ingressos</a></li>
        <li><a href={SITE.fotos} target="_blank" rel="noopener">Fotos</a></li>
        <li><a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </dialog>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="rodape-colunas">
        <div>
          <h2>Site</h2>
          <ul>{NAV.map((item) => <li><a href={item.href}>{item.rotulo}</a></li>)}</ul>
        </div>
        <div>
          <h2>Fora daqui</h2>
          <ul>
            <li><a href={SITE.ingressos} target="_blank" rel="noopener">Ingressos no Shotgun</a></li>
            <li><a href={SITE.fotos} target="_blank" rel="noopener">Fotos no Pixieset</a></li>
            <li><a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
            <li><a href={SITE.redes.tiktok} target="_blank" rel="noopener">TikTok</a></li>
            <li><a href={SITE.redes.x} target="_blank" rel="noopener">X</a></li>
          </ul>
        </div>
        <div>
          <h2>Fale com a gente</h2>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href="/contato">Formulário de contato</a></li>
            <li><a href="/parceiros">Sua marca na @bsurda</a></li>
          </ul>
        </div>
      </div>
      <p class="rodape-fim">{SITE.lema}, desde 2009. Belo Horizonte.</p>
      <a class="rodape-marca" href="/" aria-label="@bsurda, página inicial"><Completo /></a>
    </footer>


    <script>
      // Troca o tema conforme o trecho que está no meio da tela.
      const raiz = document.documentElement;
      const aplicar = (texto: string | undefined) => {
        if (!texto) return;
        const [fundo, cor, destaque] = texto.split('|');
        raiz.style.setProperty('--fundo', fundo);
        raiz.style.setProperty('--texto', cor);
        raiz.style.setProperty('--destaque', destaque);
      };
      const trechos = document.querySelectorAll<HTMLElement>('[data-tema]');
      if (trechos.length > 0) {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              const alvo = entrada.target as HTMLElement;
              aplicar(alvo.dataset.tema === 'sorteio' ? raiz.dataset.temaSorteado ?? alvo.dataset.reserva : alvo.dataset.tema);
            }
          },
          { rootMargin: '-45% 0px -45% 0px' },
        );
        trechos.forEach((trecho) => observador.observe(trecho));
      }

      // Menu do celular.
      const menu = document.querySelector<HTMLDialogElement>('#menu-celular');
      document.querySelector('.menu-abre')?.addEventListener('click', () => menu?.showModal());
      document.querySelector('.menu-fecha')?.addEventListener('click', () => menu?.close());
      menu?.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });

      // Animações de entrada: marca o elemento quando ele entra na tela, uma vez só.
      const animados = document.querySelectorAll<HTMLElement>('[data-anima]');
      if (animados.length > 0) {
        const entrada = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('visto');
              entrada.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        animados.forEach((el) => entrada.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  /* Cores registradas como propriedades animáveis: a página inteira
     desliza de um tema para o outro em vez de trocar de uma vez. */
  @property --fundo { syntax: '<color>'; inherits: true; initial-value: #711a40; }
  @property --texto { syntax: '<color>'; inherits: true; initial-value: #ffa500; }
  @property --destaque { syntax: '<color>'; inherits: true; initial-value: #f55275; }

  :root {
    --fonte: 'Urbanist Variable', system-ui, sans-serif;
    --margem: clamp(1.25rem, 4vw, 3.5rem);
    --linha: color-mix(in srgb, var(--texto) 28%, transparent);
    --suave: color-mix(in srgb, var(--texto) 72%, var(--fundo));
    transition: --fundo 0.7s ease, --texto 0.7s ease, --destaque 0.7s ease;
  }
  @media (prefers-reduced-motion: reduce) { :root { transition: none; } }

  *, *::before, *::after { box-sizing: border-box; }
  html { overflow-x: clip; background: var(--fundo); color: var(--texto); }
  body { overflow-x: clip; margin: 0; font: 400 1.0625rem/1.5 var(--fonte); -webkit-font-smoothing: antialiased; }
  img, svg { display: block; max-width: 100%; }
  a { color: inherit; text-underline-offset: 0.18em; text-decoration-thickness: 0.06em; }
  :focus-visible { outline: 3px solid var(--destaque); outline-offset: 3px; }
  ::selection { background: var(--texto); color: var(--fundo); }
  h1, h2, h3, p, ul, ol { margin: 0; }
  ul, ol { padding: 0; list-style: none; }

  .pular { position: absolute; left: -999px; top: 0; background: var(--texto); color: var(--fundo); padding: 0.75rem 1rem; z-index: 10; }
  .pular:focus { left: 0; }

  /* Escala tipográfica */
  .t-gigante { font-size: clamp(3.25rem, 13.5vw, 13rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }
  .t-grande { font-size: clamp(2.25rem, 6.5vw, 5.75rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.035em; text-transform: uppercase; text-wrap: balance; }
  .t-medio { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 500; line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance; }
  .t-apoio { font-size: clamp(1.125rem, 1.6vw, 1.375rem); line-height: 1.4; max-width: 34em; }
  .t-pequeno { font-size: 0.9375rem; color: var(--suave); }

  /* Eco nos títulos: fatias repetidas atrás do título, cada vez menores e mais fracas.
     O título é sempre o mais forte. O texto das fatias vem do atributo data-eco
     e é ignorado por leitores de tela. As medidas são em "em", presas à borda do
     título, para funcionar em títulos de várias linhas.
     Cada página usa uma direção: para baixo, para cima, para a direita ou para a esquerda. */
  .ecoa { position: relative; isolation: isolate; width: fit-content; max-width: 100%; --eco-x: 0em; --de-y: -0.4em; }
  /* z-index negativo: as fatias ficam sempre atrás do título */
  .ecoa::before, .ecoa::after { content: attr(data-eco) / ''; position: absolute; z-index: -1; left: 0; top: 0; width: 100%; pointer-events: none; }
  .ecoa::before { color: color-mix(in oklab, currentColor 55%, var(--fundo)); }
  .ecoa::after { color: color-mix(in oklab, currentColor 28%, var(--fundo)); }

  /* para baixo (padrão): o título desce e os ecos continuam a queda */
  .ecoa { margin-bottom: 0.5em; }
  .ecoa::before, .ecoa::after { transform-origin: 50% 100%; }
  .ecoa::before { clip-path: inset(calc(100% - 0.27em) 0 0 0); transform: translate(var(--eco-x), 0.25em) scale(0.95); }
  .ecoa::after { clip-path: inset(calc(100% - 0.14em) 0 0 0); transform: translate(calc(var(--eco-x) * 2), 0.41em) scale(0.89); }

  /* para cima: o título sobe e os ecos seguem subindo */
  .ecoa-cima { margin-bottom: 0; margin-top: 0.5em; --de-y: 0.4em; }
  .ecoa-cima::before, .ecoa-cima::after { transform-origin: 50% 0; }
  .ecoa-cima::before { clip-path: inset(0 0 calc(100% - 0.3em) 0); transform: translate(var(--eco-x), -0.25em) scale(0.95); }
  .ecoa-cima::after { clip-path: inset(0 0 calc(100% - 0.17em) 0); transform: translate(calc(var(--eco-x) * 2), -0.41em) scale(0.89); }

  /* Diagonais: o eco para baixo ou para cima ganha um desvio lateral.
     Para a direita, o título fica à esquerda; para a esquerda, encosta à direita. */
  .ecoa-direita { --eco-x: 0.2em; }
  .ecoa-esquerda { --eco-x: -0.2em; margin-left: auto; }

  /* O cabeçalho acompanha a direção do eco */
  .abre { overflow-x: clip; }
  .abre-esquerda { text-align: right; }
  .abre-esquerda .t-apoio { margin-left: auto; }
  .abre-cima { padding-top: clamp(4rem, 11vw, 10rem); }

  /* Entrada do título com eco: o título chega no sentido do eco e as fatias
     se soltam dele em seguida, continuando o movimento.
     Em títulos marcados com data-anima, só começa quando entram na tela. */
  .js .ecoa { animation: titulo-entra 0.9s cubic-bezier(0.62, 0.05, 0.01, 0.99) both; }
  .js .ecoa::before { animation: eco-solta 0.75s cubic-bezier(0.62, 0.05, 0.01, 0.99) 0.5s both; }
  .js .ecoa::after { animation: eco-solta 0.75s cubic-bezier(0.62, 0.05, 0.01, 0.99) 0.62s both; }
  .js .ecoa[data-anima]:not(.visto), .js .ecoa[data-anima]:not(.visto)::before, .js .ecoa[data-anima]:not(.visto)::after { animation-play-state: paused; }
  @keyframes titulo-entra { from { transform: translate(calc(var(--eco-x) * -3), var(--de-y)) scale(0.82); opacity: 0; } 40% { opacity: 1; } }
  @keyframes eco-solta { from { transform: none; opacity: 0; } }

  /* Animações de entrada ao rolar. Só valem com JavaScript ligado;
     sem ele, tudo já aparece no lugar. */
  .js [data-anima='sobe'] { clip-path: inset(0 0 100% 0); transform: translateY(0.5em); transition: clip-path 0.9s cubic-bezier(0.62, 0.05, 0.01, 0.99), transform 0.9s cubic-bezier(0.62, 0.05, 0.01, 0.99); transition-delay: calc(var(--i, 0) * 80ms); }
  .js [data-anima='sobe'].visto { clip-path: inset(-0.2em -0.2em -0.3em -0.2em); transform: none; }
  .js [data-anima='surge'] { opacity: 0; transform: translateY(1.75rem); transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.62, 0.05, 0.01, 0.99); transition-delay: calc(var(--i, 0) * 80ms); }
  .js [data-anima='surge'].visto { opacity: 1; transform: none; }
  .js [data-anima='abre'] { clip-path: inset(0 0 100% 0 round 1rem); transition: clip-path 1.1s cubic-bezier(0.62, 0.05, 0.01, 0.99); transition-delay: calc(var(--i, 0) * 80ms); }
  .js [data-anima='abre'].visto { clip-path: inset(0 0 0 0 round 1rem); }
  .js [data-anima='linha'] { position: relative; }
  .js [data-anima='linha']::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1.5px; background: var(--texto); transform: scaleX(0); transform-origin: 0 50%; transition: transform 1.1s cubic-bezier(0.62, 0.05, 0.01, 0.99); transition-delay: calc(var(--i, 0) * 70ms); }
  .js [data-anima='linha'].visto::before { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .js .ecoa, .js .ecoa::before, .js .ecoa::after { animation: none; }
    .js [data-anima] { clip-path: none !important; opacity: 1 !important; transform: none !important; transition: none !important; }
    .js [data-anima='linha']::before { transform: scaleX(1); transition: none; }
  }

  .secao { padding: clamp(3.5rem, 9vw, 8rem) var(--margem); }
  .secao + .secao { border-top: 1px solid var(--linha); }
  .titulo-secao { font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: clamp(1.5rem, 4vw, 3rem); }

  .botao { display: inline-block; padding: 0.95em 1.7em; border: 1.5px solid currentColor; border-radius: 99rem; font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none; transition: background-color 0.15s, color 0.15s; }
  .botao:hover { background: var(--texto); color: var(--fundo); border-color: var(--texto); }
  .botao-cheio { background: var(--texto); color: var(--fundo); border-color: var(--texto); }
  .botao-cheio:hover { background: var(--destaque); border-color: var(--destaque); }
  .link { font-weight: 500; }

  /* Topo */
  .menu-abre, .menu-fecha { display: none; align-items: center; gap: 0.35em; padding: 0.6rem 0; background: none; border: 0; color: inherit; font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; cursor: pointer; }
  .menu-abre span, .menu-fecha span { width: 0.34em; height: 1.35em; border-radius: 0.05em; background: var(--destaque); transform: skewX(26.5deg); }
  .menu-abre span:first-of-type, .menu-fecha span:first-of-type { margin-left: 0.5em; }
  .menu-fecha span { background: currentColor; }
  .menu-fecha span + span { transform: skewX(-26.5deg); margin-left: -0.69em; }

  /* Menu em tela cheia, com as cores invertidas para marcar a mudança de camada */
  .menu { width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0 var(--margem) 2rem; border: 0; background: var(--texto); color: var(--fundo); overflow-y: auto; }
  .menu::backdrop { background: var(--texto); }
  .menu[open] { display: flex; flex-direction: column; }
  .menu-topo { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 0; }
  .menu-topo .topo-marca, .menu-topo .topo-marca:hover { color: var(--fundo); }
  .menu-fecha { display: inline-flex; }
  .menu nav { flex: 1; display: grid; align-content: center; padding: 1.5rem 0; }
  .menu nav li { overflow: hidden; }
  .menu nav a { position: relative; display: block; padding: 0.14em 0 0.14em 0; font-size: clamp(2.75rem, 13.5vw, 5rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; text-transform: uppercase; text-decoration: none; }
  .menu nav a[aria-current='page'] { padding-left: 0.42em; }
  .menu nav a[aria-current='page']::before { content: ''; position: absolute; left: 0.06em; top: 0.2em; bottom: 0.22em; width: 0.17em; background: var(--destaque); transform: skewX(26.5deg); }
  .menu[open] nav a { animation: menu-sobe 0.7s cubic-bezier(0.62, 0.05, 0.01, 0.99) both; animation-delay: calc(var(--i, 0) * 55ms + 80ms); }
  @keyframes menu-sobe { from { transform: translateY(105%); } }
  .menu-fora { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; padding-top: 1.25rem; border-top: 1.5px solid color-mix(in srgb, var(--fundo) 30%, transparent); }
  .menu-fora a { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) { .menu[open] nav a { animation: none; } }

  @media (max-width: 860px) {
    .topo-nav { display: none !important; }
    .menu-abre { display: inline-flex; }
  }
  .topo { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.1rem var(--margem); }
  /* Logo do menu: fica mais forte e solta ecos ao passar o mouse */
  .topo-marca { position: relative; width: 2.4rem; flex: none; color: color-mix(in srgb, var(--texto) 78%, var(--fundo)); transition: color 0.3s; }
  .topo-marca:hover, .topo-marca:focus-visible { color: var(--texto); }
  .tm-eco { position: absolute; inset: 0; opacity: 0; transition: transform 0.6s cubic-bezier(0.62, 0.05, 0.01, 0.99), opacity 0.3s; }
  .tm-eco1 { clip-path: inset(62% 0 0 0); color: color-mix(in oklab, var(--texto) 58%, var(--fundo)); }
  .tm-eco2 { clip-path: inset(80% 0 0 0); color: color-mix(in oklab, var(--texto) 32%, var(--fundo)); }
  .topo-marca:hover .tm-eco, .topo-marca:focus-visible .tm-eco { opacity: 1; }
  .topo-marca:hover .tm-eco1, .topo-marca:focus-visible .tm-eco1 { transform: translateY(34%) scale(0.92); }
  .topo-marca:hover .tm-eco2, .topo-marca:focus-visible .tm-eco2 { transform: translateY(58%) scale(0.82); }
  @media (prefers-reduced-motion: reduce) { .tm-eco { transition: none; } }
  .topo .topo-nav { flex: 1; display: flex; justify-content: space-between; gap: 1.25rem; max-width: 62rem; margin-left: auto; overflow-x: auto; scrollbar-width: none; }
  .topo nav a { text-decoration: none; font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; white-space: nowrap; padding: 0.35rem 0; border-bottom: 1.5px solid transparent; }
  /* Marcador do menu: a barra inclinada das letras do logo.
     O espaço dela já fica reservado em cada item, então nada se desloca quando ela aparece. */
  .topo nav { padding-left: 0.5em; }
  .topo nav a { position: relative; border-bottom: 0; padding-left: 1.15em; color: color-mix(in srgb, var(--texto) 72%, var(--fundo)); transition: color 0.2s; }
  .topo nav a::before { content: ''; position: absolute; left: 0.3em; top: 50%; width: 0.36em; height: 1.45em; margin-top: -0.725em; border-radius: 0.06em; background: var(--destaque); transform: skewX(26.5deg) scaleY(0); transform-origin: center; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .topo nav a:hover, .topo nav a:focus-visible, .topo nav a[aria-current='page'] { color: var(--texto); }
  .topo nav a:hover::before, .topo nav a:focus-visible::before, .topo nav a[aria-current='page']::before { transform: skewX(26.5deg) scaleY(1); }
  @media (prefers-reduced-motion: reduce) { .topo nav a::before { transition: none; } }

  /* Rodapé grande */
  .rodape { border-top: 1px solid var(--linha); padding: clamp(3rem, 8vw, 7rem) var(--margem) 0; overflow: hidden; }
  .rodape-colunas { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 2rem; }
  .rodape h2 { font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 1rem; }
  .rodape li { margin-bottom: 0.45rem; }
