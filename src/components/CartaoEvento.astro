---
// Evento em versão compacta, para os que vêm depois do destaque na Home.
// As cores saem da capa do próprio evento e a capa aparece inteira.
import type { Evento } from '../lib/eventos';
import { partesDaData } from '../lib/eventos';
import Botao from './Botao.astro';
import Arroba from './marca/Arroba.astro';
// "principal" troca a chamada para a versão primária (usada na Agenda, onde comprar
// é a razão da seção). "selo" põe um rótulo acima do nome.
interface Props { evento: Evento; principal?: boolean; selo?: string }
const { evento, principal = false, selo } = Astro.props;
const d = partesDaData(evento.data);
const plataformas = { shotgun: 'Ingressos na Shotgun', sympla: 'Ingressos na Sympla', manual: 'Ingressos' };
// Com capa: fundo em degradê com a cor de cada canto da arte, no mesmo canto do cartão.
// Sem capa: as cores do tema, chapadas.
const m = evento.malha;
const cores = m
  ? `--c0:${m.cores[0]};--c1:${m.cores[1]};--c2:${m.cores[2]};--c3:${m.cores[3]};--tinta:${m.texto}`
  : `--c0:${evento.tema.texto};--c1:${evento.tema.texto};--c2:${evento.tema.texto};--c3:${evento.tema.texto};--tinta:${evento.tema.fundo}`;
---
<article class="cartao" style={cores} data-anima="surge">
  <a class="cartao-capa" href={evento.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    {evento.capa
      ? <img src={evento.capa} alt="" loading="lazy" style={evento.proporcao ? `aspect-ratio:${evento.proporcao}` : undefined} />
      : <span class="cartao-sem-capa"><Arroba /></span>}
  </a>
  <div class="cartao-texto">
    {selo && <p class="cartao-selo"><Arroba />{selo}</p>}
    <h3 class="cartao-nome">{evento.nome}</h3>
    <p class="cartao-quando">{d.semana.slice(0, 3)}, {d.dia} {d.mes}, {d.hora}</p>
    {evento.local && (
      <p class="cartao-local">
        <svg viewBox="0 0 16 20" aria-hidden="true"><path d="M8 0a8 8 0 0 0-8 8c0 5.6 8 12 8 12s8-6.4 8-12a8 8 0 0 0-8-8Zm0 11.2A3.2 3.2 0 1 1 8 4.8a3.2 3.2 0 0 1 0 6.4Z" /></svg>
        <span><span class="so-leitor">Local: </span>{evento.local}</span>
      </p>
    )}
  </div>
  <Botao href={evento.url} externo tipo={principal ? 'cheio' : 'linha'} class={principal ? 'cartao-botao cartao-botao-cheio' : 'cartao-botao'}>{plataformas[evento.origem]}</Botao>
</article>

<style>
  /* O fundo é um degradê de quatro pontos. Cada ponto se desloca um pouco com o
     cursor (--px e --py vão de -1 a 1), como se a luz da capa escorresse pelo cartão. */
  .cartao { --px: 0; --py: 0; position: relative; display: flex; flex-direction: column; gap: var(--e-3); min-width: 0; padding: var(--e-3); border-radius: clamp(1rem, 2vw, 1.75rem); color: var(--tinta);
    background:
      radial-gradient(ellipse 85% 70% at calc(0% + var(--px) * 14%) calc(0% + var(--py) * 14%), var(--c0), transparent 100%),
      radial-gradient(ellipse 85% 70% at calc(100% + var(--px) * 14%) calc(0% + var(--py) * 14%), var(--c1), transparent 100%),
      radial-gradient(ellipse 85% 70% at calc(0% + var(--px) * 14%) calc(100% + var(--py) * 14%), var(--c2), transparent 100%),
      radial-gradient(ellipse 85% 70% at calc(100% + var(--px) * 14%) calc(100% + var(--py) * 14%), var(--c3), transparent 100%),
      color-mix(in oklab, color-mix(in oklab, var(--c0), var(--c3)), color-mix(in oklab, var(--c1), var(--c2)));
    transition: translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s; }
  .cartao:hover { translate: 0 -0.35rem; box-shadow: 0 1.75rem 3rem -1.5rem rgb(0 0 0 / 0.5); }

  /* A capa inclina com o cursor, como a do destaque */
  .cartao-capa { display: block; }
  .cartao-capa img { width: 100%; height: auto; border-radius: clamp(0.6rem, 1.2vw, 1rem); box-shadow: 0 1.25rem 2.5rem -1.25rem rgb(0 0 0 / 0.55); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cartao-sem-capa { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: clamp(0.6rem, 1.2vw, 1rem); background: var(--tinta); color: var(--c0); }
  .cartao-sem-capa :global(svg) { width: 22%; }

  /* Mesma ordem do bloco grande, um degrau abaixo na escala: nome, data e hora, local */
  .cartao-nome { font-size: var(--t-4); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; text-transform: uppercase; text-wrap: balance; overflow-wrap: anywhere; }
  .cartao-quando { margin-top: var(--e-2); font-size: var(--t-3); font-weight: 800; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; }
  .cartao-local { display: flex; align-items: flex-start; margin-top: var(--e-1); font-size: 0.9375rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.25; }
  .cartao-local svg { flex: none; width: 0.72em; height: 0.9em; margin: 0.14em 0.45em 0 0; fill: currentColor; }

  .cartao-selo { display: flex; align-items: center; gap: 0.6em; margin-bottom: var(--e-2); font-size: var(--t-rotulo); font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1; }
  .cartao-selo :global(svg) { flex: none; width: 1.5em; height: auto; }
  .cartao :global(.cartao-botao-cheio) { --botao-texto: var(--c2); align-self: stretch; }
  .cartao :global(.cartao-botao) { --botao-fundo: var(--tinta); --botao-destaque: var(--tinta); margin-top: auto; align-self: flex-start; }
  @media (prefers-reduced-motion: reduce) { .cartao, .cartao-capa img { transition: none; } .cartao:hover { translate: none; } }
</style>
