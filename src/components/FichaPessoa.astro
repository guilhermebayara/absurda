---
// Ficha da página de pessoa: a parte padrão (escolha do Gui, nov 2026), na língua do crachá.
// Até três linhas de rótulo e valor com filete, que vêm do "Acesso / Total" do crachá: "Redes"
// (perfis da pessoa), "Na @bsurda" (projetos da festa) e "Fora daqui" (projetos dela). A separação
// vem do rótulo. Todo link é texto, do mesmo peso; sem ícone de rede. Linha vazia não aparece, e
// sem nenhuma linha a ficha não aparece.
// O código do crachá, que fecha a ficha, fica na página (p.ficha-codigo), logo depois dela.
interface Link { rotulo: string; url: string }
interface Props {
  redes?: Link[];
  projetos?: { nome: string; href: string }[];
  links?: (Link & { papel?: string })[];
}
const { redes = [], projetos = [], links = [] } = Astro.props;
---
{(redes.length > 0 || projetos.length > 0 || links.length > 0) && (
  <dl class="ficha">
    {redes.length > 0 && <div><dt>Redes</dt><dd><ul class="ficha-lado">{redes.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.rotulo}<span class="ficha-seta" aria-hidden="true">↗</span><span class="so-leitor"> (abre em outra aba)</span></a></li>)}</ul></dd></div>}
    {projetos.length > 0 && <div><dt>Na @bsurda</dt><dd><ul class="ficha-lado">{projetos.map((pr) => <li><a href={pr.href}>{pr.nome}</a></li>)}</ul></dd></div>}
    {links.length > 0 && <div><dt>Fora daqui</dt><dd><ul class="ficha-pilha">{links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.rotulo}<span class="ficha-seta" aria-hidden="true">↗</span><span class="so-leitor"> (abre em outra aba)</span></a>{l.papel && <span class="pessoa-papel">{l.papel}</span>}</li>)}</ul></dd></div>}
  </dl>
)}

<style>
  .ficha > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 0.25rem 1.5rem; align-items: baseline; padding: 0.95rem 0 1.05rem; border-top: 2px solid currentColor; }
  .ficha > div:last-child { border-bottom: 2px solid currentColor; }
  .ficha dt { font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.16em; }
  .ficha dd { margin: 0; font-size: clamp(1.0625rem, 1.5vw, 1.3125rem); font-weight: 700; line-height: 1.25; }
  .ficha a { text-underline-offset: 0.18em; text-decoration-thickness: 0.08em; }
  .ficha-lado { display: flex; flex-wrap: wrap; gap: 0.35rem 1.5rem; }
  .ficha-pilha { display: grid; gap: 0.45rem; }
  .ficha-seta { display: inline-block; margin-left: 0.3em; font-size: 0.8em; font-weight: 500; }
  .pessoa-papel { margin-left: 0.7em; font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: var(--suave); white-space: nowrap; }
  @media (max-width: 720px) {
    .ficha > div { grid-template-columns: minmax(0, 1fr); }
  }
</style>
