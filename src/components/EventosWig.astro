---
// O que a WIG faz: um bloco por projeto, com uma frase, os números e as datas (que abrem e fecham).
// Os eventos que são só da WIG moram aqui e não entram na Agenda do site (decisão do Gui). O CHRONUS
// é coprodução com a @bsurda: aparece aqui como projeto e continua na Agenda.
// Dados em src/data/wig-eventos.json, escritos à mão a partir das contas da WIG.
import ProjetoWig from './ProjetoWig.astro';
import wig from '../data/wig-eventos.json';
import { jaAcabou } from '../lib/eventos';
// local e url são opcionais: evento sem eles sai só com data e nome. Campos como elenco e convidadas
// ficam no dado, sem layout (por enquanto).
type Ev = { serie: string; nome: string; data: string; ate?: string; local?: string; url?: string };
type Serie = { id: string; nome: string; texto: string; nota?: string; palavra?: string; coproducao?: boolean; naAgenda?: number; link?: { rotulo: string; href: string } };
const MESES = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const dia = (e: Ev) => `${e.data.slice(8, 10)}${e.ate ? ` a ${e.ate.slice(8, 10)}` : ''} ${MESES[Number(e.data.slice(5, 7)) - 1]} ${e.data.slice(0, 4)}`;
// Só o dia é conhecido: a data vira a noite do último dia, e vale jaAcabou como no resto do site
// (a conta e a etiqueta "em breve" saem do mesmo corte).
const aindaVai = (e: Ev) => !jaAcabou({ data: `${e.ate ?? e.data}T20:00:00-03:00` });
const projetos = (wig.series as Serie[]).map((s) => {
  const eventos = (wig.eventos as Ev[]).filter((e) => e.serie === s.id).sort((a, b) => b.data.localeCompare(a.data));
  const anos = [...new Set(eventos.map((e) => e.data.slice(0, 4)))].sort();
  // Edições que já aconteceram, mais as que moram na Agenda (coprodução) e não se repetem aqui.
  const feitos = eventos.filter((e) => !aindaVai(e)).length + (s.naAgenda ?? 0);
  return { ...s, eventos, feitos, periodo: anos.length > 1 ? `${anos[0]} a ${anos[anos.length - 1]}` : anos[0] };
});
---
<section class="secao faz-wig" aria-labelledby="t-faz-wig">
  <h2 id="t-faz-wig" class="titulo-secao" data-anima="sobe">O que a WIG faz</h2>
  <div class="faz-lista">
    {projetos.map((s) => <ProjetoWig nome={s.nome} texto={s.texto} nota={s.nota} link={s.link}
      resumoDatas={s.coproducao ? 'Datas' : `${s.feitos} ${s.palavra ?? 'edições'}`} periodo={s.periodo}
      datas={s.eventos.map((e) => ({ nome: e.nome, data: dia(e), local: e.local, url: e.url, breve: aindaVai(e) }))} />)}
  </div>
</section>

<style>
  .faz-lista { margin-top: var(--e-3); border-top: 2px solid var(--texto); }
</style>
