---
// Faixa de texto correndo na horizontal, com o símbolo entre as repetições.
import Arroba from './marca/Arroba.astro';
interface Props { texto: string; contra?: boolean }
const { texto, contra = false } = Astro.props;
const vezes = Array.from({ length: 8 });
---
<div class:list={['faixa-corre', { contra }]} aria-hidden="true">
  <div class="faixa-trilho">
    {vezes.map(() => <span>{texto}<Arroba /></span>)}
  </div>
</div>
<p class="so-leitor">{texto}</p>

<style>
  .faixa-corre { overflow: hidden; background: var(--texto); color: var(--fundo); padding: clamp(0.6rem, 1.4vw, 1.1rem) 0; }
  .faixa-trilho { display: flex; width: max-content; animation: corre 38s linear infinite; }
  .contra .faixa-trilho { animation-direction: reverse; }
  .faixa-trilho span { display: flex; align-items: center; gap: 0.5em; padding-right: 0.5em; font-size: clamp(1.75rem, 5vw, 4.25rem); font-weight: 800; text-transform: uppercase; letter-spacing: -0.02em; white-space: nowrap; line-height: 1; }
  .faixa-trilho :global(svg) { height: 0.72em; width: auto; color: var(--destaque); }
  @keyframes corre { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .faixa-trilho { animation: none; } }
  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
