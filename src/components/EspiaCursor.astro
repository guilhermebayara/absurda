---
interface Props {
  agenda?: boolean;
}

const { agenda = false } = Astro.props;
---
<div class:list={['espia-cursor', agenda ? 'espia-capa' : 'espia']} data-espia-cursor aria-hidden="true">
  <slot />
</div>

<script>
  const espia = document.querySelector<HTMLElement>('[data-espia-cursor]');
  if (espia && matchMedia('(hover: hover) and (pointer: fine)').matches) montar(espia);

  function montar(espia: HTMLElement) {
    let quadro = 0;
    let x = 0, y = 0, giro = 0;
    let imagem: HTMLImageElement | undefined;
    let pendente: HTMLImageElement | undefined;

    function acompanhar(e: PointerEvent) {
      if (e.pointerType === 'touch') return;
      x = e.clientX;
      y = e.clientY;
      giro = Math.max(-8, Math.min(8, e.movementX * 0.6));
      if (quadro) return;
      quadro = requestAnimationFrame(() => {
        quadro = 0;
        espia.style.setProperty('--movimento', `translate(calc(${x}px + 1.5rem), calc(${y}px - 50%)) rotate(${giro}deg)`);
      });
    }

    function mostrar(temMarca: boolean, nova?: HTMLImageElement) {
      if (nova && nova !== imagem) {
        imagem?.remove();
        espia.prepend(nova);
        imagem = nova;
      }
      if (imagem) imagem.hidden = !nova;
      espia.classList.toggle('visivel', Boolean(nova || temMarca));
      espia.classList.remove('carregando');
    }

    for (const linha of document.querySelectorAll<HTMLElement>('[data-espia]')) {
      linha.addEventListener('pointermove', acompanhar);
      linha.addEventListener('pointerenter', async (e) => {
        if (e.pointerType === 'touch') return;
        const fontes = linha.dataset.espia;
        const cores = linha.dataset.espiaCores;
        const src = fontes ? escolherCapa(fontes, 2 * espia.offsetWidth) : '';
        acompanhar(e);
        if (cores) {
          const [fundo, , destaque] = cores.split('|');
          espia.style.setProperty('--espia-fundo', fundo);
          espia.style.setProperty('--espia-cor', destaque);
        }

        if (!src) return mostrar(Boolean(cores));
        if (imagem?.src === new URL(src, document.baseURI).href) return mostrar(Boolean(cores), imagem);

        // Enquanto a nova decodifica, esconda a anterior já no quadro da troca de linha.
        espia.classList.add('carregando');
        const nova = new Image();
        nova.alt = '';
        pendente = nova;
        nova.src = src;
        try {
          await nova.decode();
          if (pendente === nova) mostrar(Boolean(cores), nova);
        } catch {
          if (pendente === nova) mostrar(Boolean(cores));
        } finally {
          if (pendente === nova) pendente = undefined;
        }
      });
      linha.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'touch') return;
        const anterior = pendente;
        pendente = undefined;
        anterior?.removeAttribute('src');
        espia.classList.remove('visivel');
      });
    }
  }

  function escolherCapa(fontes: string, limite: number) {
    const candidatas = fontes.split(', ').map((fonte) => fonte.split(' '));
    const [src] = candidatas.findLast(([, largura]) => !largura || parseInt(largura, 10) <= limite) ?? candidatas[0];
    return src;
  }
</script>

<style>
  .espia-cursor {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 1;
    overflow: hidden;
    border-radius: clamp(0.6rem, 1.2vw, 1rem);
    pointer-events: none;
    opacity: 0;
    --escala-espia: 0.85;
    transform: var(--movimento, translate(1.5rem, -50%)) scale(var(--escala-espia));
    transition: opacity 0.2s, transform 0.18s ease-out;
  }
  .espia-cursor.visivel { opacity: 1; --escala-espia: 1; }
  .espia-cursor.carregando { visibility: hidden; }
  .espia-cursor :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .espia {
    width: clamp(11rem, 18vw, 17rem);
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    background: var(--espia-fundo, var(--texto));
    color: var(--espia-cor, var(--fundo));
  }
  .espia :global(svg) { width: 46%; }
  .espia-capa {
    width: clamp(15rem, 24vw, 24rem);
    aspect-ratio: 16 / 9;
    background: var(--texto);
    box-shadow: 0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.55);
  }
  @media (prefers-reduced-motion: reduce) { .espia-cursor { transition: none; } }
  /* No toque, um elemento fixo invisível já faz o Safari desenhar uma banda atrás das barras. */
  @media (hover: none) { .espia-cursor { display: none; } }
</style>
