---
// Crachá da WIG: conversa com o crachá da @bsurda (mesma proporção, mesmo furo, mesma forma de
// redimensionar), mas é pensado na marca da WIG. O nome vem na letra da marca, já em curvas
// (src/data/wig-letras.json), o "w" assina o topo e a faísca separa o rodapé. Não tem verso, ano
// nem número: o elenco da WIG não entra na conta dos crachás da @bsurda (decisão do Gui).
// Sólido como todo crachá: usa a superfície invertida do tema (texto no fundo, fundo no texto).
import WigW from './marca/WigW.astro';
import letras from '../data/wig-letras.json';

interface Props {
  id: string;
  nome: string;
  // Linha abaixo do nome: o epíteto do post de apresentação, entre aspas angulares, ou uma função.
  epiteto?: string;
  funcao?: string;
  foto: string;
  href?: string;
  externo?: boolean;
  // Como na @bsurda, o material muda com o papel: casting (as WIGurls) vem na superfície invertida;
  // bastidores (produção) na cor viva do tema; direção (a patroa) é a única dourada.
  papel?: 'casting' | 'bastidores' | 'direcao';
  selo?: string;
  // Adesivo colado no canto da foto (ex.: "New Girl"), vindo de `adesivo` em src/data/wig.json.
  adesivo?: string;
  class?: string;
}
const { id, nome, epiteto, funcao, foto, href, externo = false, papel = 'casting', selo, adesivo, class: classe } = Astro.props;
const letra = (letras as Record<string, { d: string; w: number; h: number } | string>)[id];
const curva = typeof letra === 'object' ? letra : undefined;
const rotulo = papel === 'bastidores' ? 'Produção' : 'WIGurl';
const pe = { casting: 'Casting', bastidores: 'Bastidores', direcao: 'Direção' }[papel];
const Marca = href ? 'a' : 'span';
const FAISCA = "M9.126 23.02C6.55266 24.95 3.52899 26.9443 0.0549927 29.003C3.40033 30.933 6.29533 32.7986 8.74 34.6C11.3133 36.4013 13.6293 38.3313 15.688 40.3899C17.7467 42.4486 19.6123 44.7003 21.285 47.1449C23.0863 49.7183 24.952 52.6776 26.882 56.0229C28.9407 52.5489 30.935 49.4609 32.865 46.7589C34.795 44.1856 36.8537 41.8053 39.041 39.6179C41.2283 37.4306 43.6087 35.372 46.182 33.442C48.884 31.512 51.972 29.5176 55.446 27.459C52.1007 25.529 49.1413 23.6633 46.568 21.862C44.1233 20.0606 41.8717 18.1306 39.813 16.072C37.7543 14.0133 35.8243 11.6973 34.023 9.12397C32.3503 6.67931 30.549 3.7843 28.619 0.438965C26.5603 3.91296 24.566 6.93663 22.636 9.50996C20.706 12.212 18.6473 14.6566 16.46 16.844C14.2727 19.0313 11.828 21.09 9.126 23.02Z";
---
<Marca class:list={['cw', `cw-${papel}`, classe]} href={href} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}>
  <span class="cw-face">
    <span class="cw-furo" aria-hidden="true"></span>
    <span class="cw-topo"><WigW class="cw-marca" /><span>{rotulo}</span></span>
    <span class="cw-retrato"><img src={foto} alt="" loading="lazy" decoding="async" />{adesivo && <span class="cw-adesivo" aria-hidden="true"><svg viewBox="0 0 56 57" fill="currentColor"><path d={FAISCA} /></svg>{adesivo}</span>}</span>
    {selo && <span class="cw-selo" aria-hidden="true"><svg viewBox="0 0 56 57" fill="currentColor"><path d={FAISCA} /></svg><strong>{selo}</strong></span>}
    <span class="cw-texto">
      {curva
        ? <svg class="cw-nome" viewBox={`0 0 ${curva.w} ${curva.h}`} preserveAspectRatio="xMinYMid meet" fill="currentColor" role="img" aria-label={nome}><path d={curva.d} /></svg>
        : <strong class="cw-nome-texto">{nome}</strong>}
      {selo && <span class="so-leitor">. {selo}</span>}
      {adesivo && <span class="so-leitor">. {adesivo}</span>}
      {epiteto && <span class="cw-epiteto"><span class="so-leitor">, </span>« {epiteto} »</span>}
      {funcao && <span class="cw-epiteto"><span class="so-leitor">, </span>{funcao}</span>}
    </span>
    <span class="cw-pe" aria-hidden="true"><span>WIG events</span><svg viewBox="0 0 56 57" fill="currentColor"><path d={FAISCA} /></svg><strong>{pe}</strong></span>
    {externo && <span class="so-leitor"> (Instagram, abre em outra aba)</span>}
  </span>
</Marca>

<style>
  /* Tudo dentro do crachá é medido pela largura dele (cqw): margens, letras, furo, selo. Assim o
     crachá encolhe e cresce inteiro, como um objeto, e nada quebra quando a tela muda (pedido do
     Gui). A referência é um crachá de 17rem de largura: 1rem de lá vale 5,88cqw aqui. */
  .cw { --c-fundo: var(--texto); --c-texto: var(--fundo); --c-pintura: var(--c-fundo); container-type: inline-size; display: block; aspect-ratio: 5 / 7; color: var(--c-texto); text-decoration: none; }
  .cw-bastidores { --c-fundo: var(--vivo); --c-texto: var(--sobre-vivo); }
  /* Direção: folha dourada, a única que não segue o tema. O amarelo vem do manual de cores da WIG;
     o degradê imita o brilho do material, como num crachá laminado. */
  .cw-direcao { --c-fundo: #f0c132; --c-texto: #4a0c0c; --c-pintura: linear-gradient(128deg, #c89f23 0%, #fde68a 24%, #fbca2c 46%, #e2b12a 62%, #fde68a 80%, #c89f23 100%); }
  .cw-face { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr auto auto; height: 100%; padding: 5.3cqw 5.3cqw 5.9cqw; border-radius: 7.4cqw; background: var(--c-pintura); }
  .cw-furo { justify-self: center; width: 16cqw; height: 3.5cqw; border-radius: 6cqw; background: var(--fundo); }
  .cw-topo { display: flex; align-items: center; justify-content: space-between; margin-top: 4.7cqw; font-size: 4.4cqw; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .cw-topo :global(.cw-marca) { height: 8cqw; width: auto; }
  /* A foto do casting já traz a inicial gigante da marca atrás da drag: a janela é maior que a do
     crachá da @bsurda para ela aparecer. */
  .cw-retrato { position: relative; display: block; overflow: hidden; min-height: 0; margin-top: 4.1cqw; border-radius: 4.4cqw; background: color-mix(in srgb, var(--c-texto) 12%, var(--c-fundo)); }
  .cw-retrato img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }
  .cw-texto { display: grid; gap: 2.4cqw; justify-items: start; margin-top: 4.7cqw; }
  /* Uma linha para todos, para a foto ter a mesma altura em todos os crachás. Nome comprido
     encolhe para caber na largura. */
  .cw-nome { display: block; width: 100%; height: 10.3cqw; }
  .cw-nome-texto { font-size: 8.8cqw; font-weight: 800; line-height: 0.95; }
  .cw-epiteto { font-size: 5.15cqw; line-height: 1.2; white-space: nowrap; }
  .cw-pe { display: flex; justify-content: space-between; align-items: center; gap: 2.5cqw; margin-top: 4.7cqw; padding-top: 3.8cqw; border-top: 0.75cqw solid var(--c-texto); font-size: 4.05cqw; text-transform: uppercase; letter-spacing: 0.16em; white-space: nowrap; }
  .cw-pe span { font-weight: 500; }
  .cw-pe strong { font-weight: 800; }
  .cw-pe svg { width: 4.1cqw; height: 4.1cqw; flex: none; }
  /* Selo da patroa: o adesivo redondo do fundador, na versão da WIG, só no da Charlotte. */
  .cw-selo { position: absolute; top: 26cqw; right: -4.7cqw; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 1.2cqw; width: 31cqw; aspect-ratio: 1; border-radius: 50%; background: var(--c-texto); color: var(--c-fundo); transform: rotate(9deg); }
  .cw-selo svg { width: 5.3cqw; height: 5.3cqw; }
  .cw-selo strong { font-size: 4.8cqw; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  /* Adesivo: objeto físico, sólido e meio torto, colado no canto da foto. Usa o par vivo do tema
     (--vivo com --sobre-vivo, que o script de Base.astro garante em 4,5:1) e uma borda da cor do
     papel do crachá, como adesivo recortado. Fica dentro da janela da foto, no canto de baixo, longe
     do rosto. Tudo em cqw, como o resto do crachá. */
  .cw-adesivo { position: absolute; right: 3.2cqw; bottom: 3.6cqw; z-index: 2; display: inline-flex; align-items: center; gap: 1.6cqw; padding: 2.1cqw 3.6cqw 2.1cqw 3cqw; border: 1cqw solid var(--c-texto); border-radius: 3.2cqw; background: var(--vivo); color: var(--sobre-vivo); font-size: 4.6cqw; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1; white-space: nowrap; transform: rotate(-7deg); transform-origin: 100% 100%; box-shadow: 0.6cqw 1cqw 1.6cqw -0.4cqw rgb(0 0 0 / 0.45); }
  .cw-adesivo svg { width: 4.4cqw; height: 4.4cqw; flex: none; }
  a.cw { transition: transform 0.25s ease; }
  @media (hover: hover) and (pointer: fine) { a.cw:hover { transform: translateY(-0.35rem) rotate(-1deg); } }
  @media (prefers-reduced-motion: reduce) { a.cw { transition: none; } a.cw:hover { transform: none; } }
</style>
