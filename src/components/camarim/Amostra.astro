---
interface Props {
  titulo: string;
  arquivos: string[];
  uso: string;
}
const { titulo, arquivos, uso } = Astro.props;
---

<section class="amostra" data-pecas={arquivos.join(' ')}>
  <header>
    <h4 class="t-medio">{titulo}</h4>
    <p>{uso}</p>
    <ul aria-label="Arquivos em src/components">
      {arquivos.map((arquivo) => <li><code>{arquivo}.astro</code></li>)}
    </ul>
  </header>
  <slot />
</section>

<style>
  .amostra { display: grid; gap: var(--e-2); padding-block: var(--e-3); border-top: 1px solid var(--linha); }
  header { display: grid; gap: .35rem; }
  h4 { margin: 0; }
  ul { display: flex; flex-wrap: wrap; gap: .25rem 1rem; color: var(--suave); font-size: .875rem; }
</style>
