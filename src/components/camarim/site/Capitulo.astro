---
// Moldura de um capítulo da parte Site: a seção do site, com o título de seção numerado, uma
// frase de abertura, o conteúdo e as regras no fim, com a barra inclinada na frente de cada uma.
import { capitulos } from './capitulos';
interface Props { id: string; abre: string }
const { id, abre } = Astro.props;
const posicao = capitulos.findIndex(capitulo => capitulo.id === id);
if (posicao < 0) throw new Error('Capítulo fora da lista: ' + id);
const regras = Astro.slots.has('regras');
---
<section class="secao capitulo" id={id} aria-labelledby={id + '-titulo'}>
  <h3 id={id + '-titulo'} class="titulo-secao" data-anima="sobe"><span class="num">{String(posicao + 1).padStart(2, '0')}</span>{capitulos[posicao].titulo}</h3>
  <p class="t-apoio abre-capitulo">{abre}</p>
  <slot />
  {regras && (
    <div class="regras">
      <h4 class="etiqueta">Regras</h4>
      <ul><slot name="regras" /></ul>
    </div>
  )}
</section>

<style>
  .titulo-secao { display: flex; align-items: baseline; gap: 0.6em; }
  .num { font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.14em; color: var(--destaque-texto); font-variant-numeric: tabular-nums; }
  .abre-capitulo { margin-bottom: var(--e-4); }
  /* Regras: linhas com a barra inclinada na frente, como os marcos da Agenda. */
  .regras { max-width: 46em; margin-top: var(--e-5); padding-top: var(--e-2); border-top: 1.5px solid var(--texto); }
  .regras h4 { margin: 0 0 var(--e-2); }
  .regras ul { display: grid; gap: var(--e-2); }
  .regras :global(li) { position: relative; padding-left: 1.5em; font-size: var(--t-3); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }
  .regras :global(li)::before { content: ''; position: absolute; left: 0.35em; top: 0.2em; width: 0.28em; height: 0.95em; background: var(--destaque); transform: skewX(26.5deg); }
  .regras :global(code) { font-size: 0.85em; }
</style>
