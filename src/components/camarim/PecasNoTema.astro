---
import { getImage } from 'astro:assets';
import arte from '../../../public/exemplos/capa-16x9.jpg';
import arteRosa from '../../../public/exemplos/capa-16x9-rosa.jpg';
import type { Evento } from '../../lib/eventos';
import type { Tema } from '../../lib/temas';
import Amostra from './Amostra.astro';
import AtalhoAnos from '../AtalhoAnos.astro';
import BarraInclinada from '../BarraInclinada.astro';
import Botao from '../Botao.astro';
import Capa from '../Capa.astro';
import CartaoEvento from '../CartaoEvento.astro';
import CartazProjeto from '../CartazProjeto.astro';
import CasoParceria from '../CasoParceria.astro';
import Cracha from '../Cracha.astro';
import CrachaWig from '../CrachaWig.astro';
import Eco from '../Eco.astro';
import ElencoWig from '../ElencoWig.astro';
import EventosWig from '../EventosWig.astro';
import Faixa from '../Faixa.astro';
import FichaPessoa from '../FichaPessoa.astro';
import LinhaEventoAgenda from '../LinhaEventoAgenda.astro';
import LinhaParceria from '../LinhaParceria.astro';
import ListaAgenda from '../ListaAgenda.astro';
import MarcaParceira from '../MarcaParceira.astro';
import MarcoSobre from '../MarcoSobre.astro';
import MenuCelular from '../MenuCelular.astro';
import PainelEvento from '../PainelEvento.astro';
import ParedePalavras from '../ParedePalavras.astro';
import PolaroideTrio from '../PolaroideTrio.astro';
import Pulseira from '../Pulseira.astro';
import Rodape from '../Rodape.astro';
import Arroba from '../marca/Arroba.astro';
import Completo from '../marca/Completo.astro';
import Silabas from '../marca/Silabas.astro';
import Vertical from '../marca/Vertical.astro';
import WigW from '../marca/WigW.astro';

interface Props {
  tema: Tema;
  id: string;
}
const { tema, id } = Astro.props;
const url = '#pecas';
// As artes do guia seguem disponíveis quando o build retira os eventos fictícios da Agenda.
const [capa, capaRosa] = await Promise.all([arte, arteRosa].map(async src =>
  (await getImage({ src, format: 'webp' })).src
));
const evento: Evento = {
  id: `evento-${id}`, nome: 'Última música', data: '2026-05-16T22:00:00-03:00',
  local: 'Salão de exemplo', url, origem: 'manual', tema,
  capa, capaPequena: capa, proporcao: 16 / 9,
};
const semCapa = { ...evento, data: '2025-05-16T22:00:00-03:00', nome: 'A última música antes de acenderem todas as luzes', capa: undefined, capaPequena: undefined, url: '' };
const pessoa = { nome: 'Luma Prisma', funcao: 'Produção de pista', desde: 2024, numero: 901 };
const elenco = [
  { id: 'luma-prisma', nome: 'Luma Prisma', foto: capaRosa, papel: 'direcao' as const, selo: 'Direção', href: url },
  { id: 'nilo-bruma', nome: 'Nilo Bruma', foto: capa, papel: 'casting' as const, epiteto: 'no brilho', href: url },
  { id: 'mira-lume', nome: 'Mira Lume', foto: capaRosa, papel: 'bastidores' as const, adesivo: 'Estreia' },
];
---

<section class="grupo">
  <h4 class="t-medio">Moldura</h4>

  <Amostra titulo="Menu" arquivos={['MenuCelular']} uso="A navegação do celular abre sobre a página e marca a seção atual.">
    <button class="abrir-menu" type="button" data-menu-amostra aria-haspopup="dialog" aria-controls={`menu-${id}`}>Abrir em tela cheia</button>
    <MenuCelular caminho="/agenda" id={`menu-${id}`} />
  </Amostra>

  <Amostra titulo="Rodapé" arquivos={['Rodape']} uso="Fecha a página com os caminhos do site e das redes.">
    <Rodape />
  </Amostra>

  <Amostra titulo="Barra inclinada e assinaturas" arquivos={['BarraInclinada', 'marca/Arroba', 'marca/Completo', 'marca/Vertical', 'marca/Silabas', 'marca/WigW']} uso="A barra marca a seção e acompanha as assinaturas nos letreiros e na navegação.">
    <div class="barras">
      <BarraInclinada class="sinal" oculta />
      <Arroba titulo="Arroba" />
      <Completo titulo="Marca completa" />
      <Vertical titulo="Marca vertical" />
      <Silabas titulo="Marca em sílabas" />
      <WigW />
    </div>
  </Amostra>

  <Amostra titulo="Faixa" arquivos={['Faixa']} uso="Costura duas seções com uma frase que corre entre arrobas.">
    <Faixa texto="A pista acendeu" />
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Agenda</h4>

  <Amostra titulo="Linha de evento" arquivos={['LinhaEventoAgenda']} uso="Uma linha reúne data, nome e local, com ou sem capa.">
    <p id={`${id}-2026`} class="etiqueta">2026</p>
    <ul><LinhaEventoAgenda evento={evento} /></ul>
    <p id={`${id}-2025`} class="etiqueta">2025</p>
    <ul><LinhaEventoAgenda evento={semCapa} /></ul>
  </Amostra>

  <Amostra titulo="Atalho de anos" arquivos={['AtalhoAnos']} uso="Pula para as linhas do ano e marca o ano em consulta.">
    <div class="atalhos">
      <AtalhoAnos anos={[2026, 2025]} prefixo={id} ativo={2026} />
    </div>
  </Amostra>

  <Amostra titulo="Cartão de evento" arquivos={['CartaoEvento']} uso="Resume a edição em um cartão e recorta a capa em 16:9.">
    <div class="duas cartoes">
      <CartaoEvento evento={evento} principal selo="Na pista" />
      <CartaoEvento evento={{ ...semCapa, url }} />
    </div>
  </Amostra>

  <Amostra titulo="Painel de evento" arquivos={['PainelEvento']} uso="Destaca a próxima edição na Home e preserva a proporção da arte.">
    <PainelEvento evento={evento} trocaTema={false} />
  </Amostra>

  <Amostra titulo="Listas" arquivos={['ListaAgenda']} uso="Apresentam as condições de acesso em cartões sólidos.">
    <ul class="duas">
      <ListaAgenda para="Acesso" nome="Quem vem pela primeira vez" textos={['A entrada fica aberta até a última música.']} indice={0} />
      <ListaAgenda para="Acesso" nome="Bonde de aniversário" textos={['Chega com a turma. A gente se encontra perto da pista.']} indice={1} />
    </ul>
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Pessoas</h4>

  <Amostra titulo="Crachá" arquivos={['Cracha']} uso="A frente identifica a pessoa pela função e o verso mostra sua ficha. O picote marca quem já fez parte.">
    <div class="tres crachas">
      <Cracha {...pessoa} foto={capa} grupo="socios" verso href={url} />
      <Cracha {...pessoa} grupo="socios" lado="verso" />
      <Cracha nome="Nilo Bruma" funcao="DJ residente" grupo="residentes" alumni desde={2023} ate={2025} numero={902} verso href={url} />
    </div>
  </Amostra>

  <Amostra titulo="Ficha" arquivos={['FichaPessoa']} uso="Organiza redes, projetos e links da pessoa em linhas com filete.">
    <FichaPessoa redes={[{ rotulo: 'Perfil de exemplo', url }]} projetos={[{ rotulo: 'Sessão da meia-noite', url, papel: 'Produção' }]} links={[]} />
  </Amostra>

  <Amostra titulo="Pulseira" arquivos={['Pulseira']} uso="Identifica quem trabalha no apoio, com link quando há perfil.">
    <ul class="pulseiras">
      <Pulseira nome="Luma Prisma" area="Produção" url={url} destino="Perfil" />
      <Pulseira nome="Mira Lume" area="Luz de pista" alternativa />
    </ul>
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Projetos</h4>

  <Amostra titulo="Cartaz" arquivos={['CartazProjeto']} uso="Distingue projetos vivos, adormecidos e independentes na página Projetos.">
    <ul class="tres cartazes">
      <CartazProjeto id="vivo" variante="vivo" nome="Sessão da meia-noite" indice={0} href={url} temas={[tema]} capa={capaRosa} edicoes={3} aviso="Próxima edição em breve" />
      <CartazProjeto id="adormecido" variante="adormecido" nome="Quando a luz apaga" indice={1} href={url} periodo="2024 a 2025" />
      <CartazProjeto id="independente" variante="independente" nome="Palco aberto" indice={2} href={url} temas={[tema]} desde="2025" />
    </ul>
  </Amostra>

  <Amostra titulo="Crachá da WIG" arquivos={['CrachaWig']} uso="Identifica o papel no elenco em uma face só.">
    <div class="crachas">
      <CrachaWig {...elenco[1]} credito="arte de exemplo" />
    </div>
  </Amostra>

  <Amostra titulo="Elenco da WIG" arquivos={['ElencoWig']} uso="Reúne direção, casting e bastidores em uma fila no celular.">
    <ElencoWig pessoas={elenco} idTitulo={`elenco-${id}`} />
  </Amostra>

  <Amostra titulo="Projetos e datas da WIG" arquivos={['EventosWig', 'ProjetoWig']} uso="Agrupa as edições por projeto e permite consultar as datas.">
    <EventosWig idTitulo={`datas-${id}`} series={[
      { id: 'ensaio', nome: 'Ensaio de pista', texto: 'Uma música de cada vez, até acertar a luz.', nota: 'Encontro fictício para a amostra.' },
      { id: 'sala', nome: 'Sala de Som', texto: 'Uma sala, duas caixas e espaço para dançar.' },
    ]} datas={[
      { serie: 'ensaio', nome: 'Sessão aberta', data: '2026-05-16', local: 'Salão de exemplo', url },
      { serie: 'ensaio', nome: 'Ensaio de luz com a pista inteira de portas abertas', data: '2025-05-16' },
    ]} />
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Sobre</h4>

  <Amostra titulo="Marco" arquivos={['MarcoSobre']} uso="Marca um acontecimento na linha do tempo, com etiqueta quando há tema.">
    <ul class="marcos-vivos marcos-amostra">
      <MarcoSobre titulo="A primeira sessão" tema="Pista" texto="As portas abriram, a fila entrou e a última música já era de manhã." />
      <MarcoSobre titulo="O som atravessou a rua" texto="Um segundo marco, sem etiqueta." />
    </ul>
  </Amostra>

  <Amostra titulo="Polaroide" arquivos={['PolaroideTrio']} uso="Conta uma passagem do Trio com foto, ano e legenda.">
    <ul class="polaroide">
      <PolaroideTrio ano="2026" numero="1 volta" texto="A pista foi dar uma volta na rua." foto={capaRosa} ativa />
    </ul>
  </Amostra>

  <Amostra titulo="Parede de palavras" arquivos={['ParedePalavras']} uso="Dá ritmo à história na Home com fileiras de palavras em movimento.">
    <div class="historia" data-corre>
      <ParedePalavras fileiras={[{ palavras: ['Chegar', 'Dançar', 'Repetir', 'Acender', 'Rodar'] }, { palavras: ['Noite inteira', 'Pista acesa', 'Luz de fita', 'Som do salão', 'Ponto de encontro'], menor: true }]} />
    </div>
  </Amostra>

  <Amostra titulo="Eco" arquivos={['Eco']} uso="Repete a assinatura na abertura da Home.">
    <div class="eco-amostra">
      <Eco comoAmostra /></div>
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Parcerias</h4>

  <Amostra titulo="Marca parceira" arquivos={['MarcaParceira']} uso="Apresenta a marca parceira pelo nome ou pela logo e dá acesso ao seu perfil.">
    <ul>
      <MarcaParceira nome="Luz de fita" papel="Cenografia" texto="Uma marca de exemplo com nome tipográfico." url={url} indice={1} />
    </ul>
  </Amostra>

  <Amostra titulo="Caso" arquivos={['CasoParceria']} uso="Mostra onde, quando e com quem uma parceria aconteceu.">
    <ul>
      <CasoParceria marca="Luz de fita" onde="Salão de exemplo" ano="2026" evento="Sessão de estreia" texto="O salão inteiro mudou de cor a cada música." indice={0} />
    </ul>
  </Amostra>

  <Amostra titulo="Linha" arquivos={['LinhaParceria']} uso="Associa um rótulo curto à descrição de uma proposta.">
    <dl><LinhaParceria rotulo="A pista" texto="Uma sala pronta para mudar de cor quando começa o som." /></dl>
  </Amostra>
</section>

<section class="grupo">
  <h4 class="t-medio">Base</h4>

  <Amostra titulo="Botão" arquivos={['Botao']} uso="A ação principal usa o botão cheio e as ações secundárias usam o botão de linha.">
    <div class="botoes">
      <Botao href={url}>Ver a próxima festa</Botao>
      <Botao href="/agenda" tipo="linha" externo>Ver as datas de todas as edições</Botao>
    </div>
  </Amostra>

  <Amostra titulo="Capa" arquivos={['Capa']} uso="Exibe a arte no recorte escolhido ou usa o arroba quando falta imagem.">
    <div class="duas capas">
      <Capa src={capa} alt="Arte fictícia de uma festa" proporcao="16 / 9" />
      <Capa proporcao="16 / 9" />
    </div>
  </Amostra>

  <Amostra titulo="Crédito da foto" arquivos={['CreditoFoto']} uso="Identifica a imagem sobre a própria foto. Toque ou Enter abre o crédito.">
    <div class="duas capas">
      <Capa src={capa} alt="Amostra com o crédito recolhido" proporcao="16 / 9" credito="arte de exemplo" />
      <div data-credito-aberto><Capa src={capaRosa} alt="Amostra com o crédito aberto" proporcao="16 / 9" credito="arte de exemplo" /></div>
    </div>
  </Amostra>
</section>

<script>
  // Estes controles fazem parte das peças em exposição. Começam com o conteúdo à vista.
  for (const datas of document.querySelectorAll<HTMLDetailsElement>('.grupo .faz-datas')) datas.open = true;
  const credito = document.querySelector('[data-credito-aberto] [data-credito-foto]');
  credito?.classList.add('aberto');
  credito?.querySelector('button')?.setAttribute('aria-expanded', 'true');
  for (const botao of document.querySelectorAll<HTMLButtonElement>('[data-menu-amostra]')) {
    const menu = document.getElementById(botao.getAttribute('aria-controls') ?? '');
    if (!(menu instanceof HTMLDialogElement)) continue;
    // A mesma peça começa aberta na amostra e passa a modal ao acionar o botão.
    menu.open = true;
    botao.addEventListener('click', () => {
      if (menu.open) menu.close();
      menu.showModal();
      menu.focus();
    });
    menu.querySelector('.menu-fecha')?.addEventListener('click', () => menu.close());
  }
</script>

<style>
  .grupo { margin-top: var(--e-4); }
  .grupo > h4 { margin-block: 0 var(--e-2); }
  .cartoes :global(.cartao) { --c0: var(--texto) !important; --c1: var(--texto) !important; --c2: var(--texto) !important; --c3: var(--texto) !important; --tinta: var(--fundo) !important; }
  .cartazes :global(.cartaz:not(.cartaz-vazado)) { --f: var(--fundo) !important; --t: var(--texto) !important; --d: var(--destaque) !important; }
  .duas, .tres { display: grid; gap: var(--e-2); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .tres { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .botoes { display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4); padding-inline: .9rem; align-items: center; }
  .capas { max-width: 58rem; }
  .cartazes > :global(li) { min-height: 16rem; }
  .crachas { max-width: 53rem; }
  .crachas > :global(.cw) { max-width: 16rem; }
  .pulseiras { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: var(--e-2); max-width: 48rem; }
  .atalhos :global(.anos-nav) { position: relative; z-index: auto; margin: 0 0 var(--e-2); padding: .5rem 0; }
  .atalhos .etiqueta { margin-block-start: var(--e-2); }
  .marcos-amostra { padding-inline-start: 1.3rem; }
  .marcos-amostra :global(.marcos-item + .marcos-item) { margin-block-start: var(--e-2); }
  .polaroide { position: relative; min-height: 25rem; max-width: 40rem; overflow: clip; --margem-foto: .75rem; }
  .polaroide :global(.trio-quadro) { position: relative !important; height: auto !important; min-height: 25rem; color: #fff; background: #1c1619; }
  .polaroide :global(.trio-quadro img) { aspect-ratio: 1; }
  .polaroide :global(.trio-legenda) { padding-top: var(--e-4); }
  .barras { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3); }
  .barras :global(svg) { width: auto; height: 2.5rem; max-width: 100%; }
  .barras :global(.sinal) { display: block; width: .7rem; height: 2rem; background: var(--destaque); }
  .eco-amostra { width: min(100%, 48rem); margin-inline: auto; }
  .historia { overflow: clip; }
  .grupo :global(.menu[open]:not(:modal)) { position: relative; inset: auto; width: 100%; height: auto; max-height: 32rem; margin-top: var(--e-2); }
  .abrir-menu { justify-self: start; color: inherit; background: none; font: inherit; padding: .55em 1.15em; border: 1px solid currentColor; border-radius: 99rem; cursor: pointer; }
  .abrir-menu:hover { color: var(--fundo); background: var(--texto); }
  @media (max-width: 720px) {
    .duas:not(.capas), .tres:not(.crachas) { grid-template-columns: 1fr; }
    .crachas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .polaroide :global(.trio-quadro) { color: #1c1619; background: #f3f0e8; }
    .polaroide :global(.trio-legenda) { position: static; background: none; padding: var(--e-2); }
  }
</style>
