---
import { coresDoTema, paletas } from '../../../scripts/cores-temas.mjs';
import Capitulo from './Capitulo.astro';
import PecasNoTema from './PecasNoTema.astro';

const temas = paletas.find(paleta => paleta.id === 'TEMAS_DO_SITE')!.temas;
const opcoes = temas.map(tema => ({
  nome: tema.nome,
  estilo: Object.entries(coresDoTema(tema)).map(([nome, cor]) => `--amostra-${nome}:${cor}`).join(';'),
}));
---
<Capitulo id="pecas">
  <div class="controle">
    <label class="etiqueta" for="tema-das-pecas">Tema das amostras</label>
    <select id="tema-das-pecas" aria-controls="amostras-das-pecas" autocomplete="off">
      {opcoes.map(({ nome, estilo }) => <option value={estilo}>{nome}</option>)}
    </select>
  </div>
  <p class="t-apoio">Teste as peças com o ponteiro, o toque ou a tecla Tab. Os nomes, as datas e as capas são de exemplo.</p>
  <nav aria-label="Grupos de peças">
    {['Moldura', 'Agenda', 'Pessoas', 'Projetos', 'Sobre', 'Parcerias', 'Base'].map(nome => <a href={'#pecas-' + nome.toLowerCase()}>{nome}</a>)}
  </nav>
  <div id="amostras-das-pecas" style={opcoes[0].estilo}>
    <PecasNoTema tema={temas[0]} id="amostra" />
  </div>
  <p slot="regras">Monte cada amostra com o componente do site e dados fictícios. As variantes interativas precisam funcionar por teclado e toque.</p>
</Capitulo>
<script>
  const seletor = document.querySelector<HTMLSelectElement>('#tema-das-pecas');
  const amostras = document.getElementById('amostras-das-pecas');
  if (seletor && amostras) {
    const aplicar = () => { amostras.style.cssText = seletor.value; };
    aplicar();
    seletor.addEventListener('change', aplicar);
  }
</script>
<style>
  nav { display: flex; flex-wrap: wrap; gap: var(--e-1) var(--e-2); margin-top: var(--e-2); }
  .controle { display: none; }
  :global(.js) .controle { display: flex; flex-wrap: wrap; gap: var(--e-2); align-items: baseline; margin-bottom: var(--e-2); }
  select { color: var(--texto); background: var(--fundo); font: inherit; border: 1px solid currentColor; border-radius: var(--raio-cartao); padding: .4em 1em; }
</style>
