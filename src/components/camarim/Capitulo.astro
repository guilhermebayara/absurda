---
import Botao from '../Botao.astro';
import { partes } from './capitulos';
interface Props { id: string }
const { id } = Astro.props;
const capitulos = partes.flatMap(parte => parte.capitulos);
const posicao = capitulos.findIndex(capitulo => capitulo.id === id);
const capitulo = capitulos[posicao];
const proximo = capitulos[posicao + 1];
if (!capitulo) throw new Error('Capítulo ausente no índice: ' + id);
---
<section class="capitulo" aria-labelledby={id}>
  <h3 id={id} class="titulo-secao"><span class="etiqueta numero">{capitulo.numero}</span> {capitulo.titulo}</h3>
  <slot />
  <aside aria-label={`Regras de ${capitulo.titulo}`}>
    <h4 class="etiqueta">Regras</h4>
    <div class="t-apoio"><slot name="regras" /></div>
  </aside>
  <nav aria-label={'Continuar depois de ' + capitulo.titulo}>
    <a href="#indice">Voltar ao índice</a>
    {proximo && <Botao tipo="linha" href={'#' + proximo.id}> {proximo.numero} {proximo.titulo}</Botao>}
  </nav>
</section>
<style>
  h3 { display: flex; align-items: baseline; gap: var(--e-2); }
  .numero { color: var(--destaque-texto); font-variant-numeric: tabular-nums; }
  .capitulo { padding-block: var(--e-4); border-top: 1px solid var(--linha); }
  aside { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--e-1) var(--e-4); margin-top: var(--e-3); padding-block-start: var(--e-2); border-top: 1px solid var(--linha); }
  h4 { margin: 0; }
  nav { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--e-1) var(--e-3); margin-top: var(--e-2); }

</style>
