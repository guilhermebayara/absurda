---
import Capitulo from './Capitulo.astro';
import BarraInclinada from '../BarraInclinada.astro';
import { coresDoTema, dois, medidasDoTema, nivelTexto, paletas } from '../../../scripts/cores-temas.mjs';

const nomes: Record<string, string> = {
  TEMAS_DO_SITE: 'Site', TEMAS_DE_POSICAO: 'Posicionamento', TEMAS_DO_TIBUM: 'Tibum',
  TEMAS_DO_TRIO: 'Trio', TEMAS_DA_PARADA: 'Parada', TEMAS_DA_WIG: 'WIG',
};
---
<Capitulo id="temas">
  <p class="t-apoio">Para leitura, a @bsurda pede 4,5:1. Para enfeite, 3:1.</p>
  <dl class="legenda">
    <div><dt class="etiqueta">AAA</dt><dd>Texto em qualquer tamanho a partir de 7:1.</dd></div>
    <div><dt class="etiqueta">AA</dt><dd>A partir de 4,5:1, o texto também alcança AAA em tamanho grande.</dd></div>
    <div><dt class="etiqueta">AA só texto grande</dt><dd>A partir de 3:1, vale para texto de 24 px ou de 18,67 px em negrito.</dd></div>
    <div><dt class="etiqueta">Enfeite</dt><dd>O selo gráfico marca se o par chega aos 3:1 usados pelo site.</dd></div>
  </dl>
  <p class="t-pequeno"><a href="https://www.w3.org/TR/WCAG22/#contrast-minimum">Contraste de texto na WCAG 2.2</a> · Cores de <code>src/lib/temas.ts</code>. Os dois últimos pares medem o foco sobre o fundo invertido e o furo do crachá vivo.</p>
  {paletas.map(({ id, temas }) => {
    const Bloco = id === 'TEMAS_DO_SITE' ? 'section' : 'details';
    const Cabeca = Bloco === 'section' ? 'header' : 'summary';
    const linhas = temas.map(tema => {
      const cores = coresDoTema(tema);
      return { tema, cores, medidas: medidasDoTema(cores) };
    });
    return (
      <Bloco class="paleta" aria-labelledby={id.toLowerCase()}>
        <Cabeca>
          <h4 id={id.toLowerCase()} class="t-medio">{nomes[id]} <span class="etiqueta">{temas.length} temas</span></h4>
        </Cabeca>
        <div class="panorama" aria-hidden="true">
          {linhas.map(({ cores }) => <span title={cores.fundo} style={`background:${cores.fundo};border-color:${cores.destaque};color:${cores.texto}`}></span>)}
        </div>
        <div class="rolagem" role="region" tabindex="0" aria-label={'Cores de cada tema de ' + nomes[id]}>
          <ul class="faixa-cores">
            {linhas.map(({ tema, cores }) => (
              <li style={`background:${cores.fundo};color:${cores.texto}`}>
                <p class="etiqueta">{tema.nome}</p>
                <dl>{Object.entries(cores).map(([nome, valor]) => (
                  <div><dt><i style={`background:${valor}`}></i><code>--{nome}</code></dt><dd><code>{valor}</code></dd></div>
                ))}</dl>
              </li>
            ))}
          </ul>
        </div>
        <div class="rolagem" role="region" tabindex="0" aria-label={'Tabela de contraste de ' + nomes[id]}>
          <table data-paleta={id}>
            <caption class="so-leitor">Contraste por tema e por par de cores de {nomes[id]}</caption>
            <thead><tr>
              <th scope="col" class="etiqueta">Tema</th>
              {linhas[0].medidas.map(({ cor, superficie, minimo }) => (
                <th scope="col" data-par={cor + '/' + superficie}>
                  <code>--{cor}</code> sobre <code>--{superficie}</code>
                  <span class="etiqueta">{minimo === 3 ? 'Enfeite · 3:1' : 'Leitura · 4,5:1'}</span>
                </th>
              ))}
            </tr></thead>
            <tbody>{linhas.map(({ tema, cores, medidas }) => (
              <tr data-camarim-tema={tema.id}>
                <th scope="row">
                  <span class="miniatura" style={`--amostra-destaque:${cores.destaque};background:${cores.fundo};color:${cores.texto}`} aria-hidden="true">Aa<BarraInclinada class="barra" oculta /></span>
                  {tema.nome}
                </th>
                {medidas.map(({ cor, superficie, razao, minimo }) => {
                  const [nivel, qualificacao] = nivelTexto(razao).split(' · ');
                  return <td data-par={cor + '/' + superficie}>
                    <strong>{dois(razao)}:1</strong>
                    <span class="etiqueta selo">{nivel}{qualificacao && <span class="so-leitor"> · {qualificacao}</span>}</span>
                    {minimo === 3 && <span class="etiqueta">Enfeite · {razao >= 3 ? 'AA' : 'Não passa'}</span>}
                  </td>;
                })}
              </tr>
            ))}</tbody>
          </table>
        </div>
      </Bloco>
    );
  })}
  <p slot="regras">Use <code>--destaque-texto</code> para texto pequeno em destaque e <code>--suave</code> para texto secundário. Sobre a superfície viva, leia com <code>--sobre-vivo</code>.</p>
</Capitulo>
<style>
  dl, dd, h4 { margin: 0; }
  .legenda { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--e-2); margin-block: var(--e-2); }
  .legenda dt { font-weight: 800; margin-bottom: var(--e-1); }
  .paleta { margin-top: var(--e-2); border-top: 1px solid var(--linha); }
  header, summary { padding-block: var(--e-2); }
  summary { cursor: pointer; }
  summary h4 { display: inline; }
  .panorama { display: flex; margin-bottom: var(--e-1); }
  .panorama span { flex: 1; height: var(--e-3); border-bottom: .3em solid; box-shadow: inset 0 1px currentColor; }
  .rolagem { position: relative; overflow: auto; max-width: 100%; }
  .faixa-cores { display: flex; }
  .faixa-cores li { flex: 0 0 auto; padding: var(--e-2); border: 1px solid currentColor; }
  .faixa-cores p { margin-bottom: var(--e-1); }
  .faixa-cores dl { font-size: var(--t-rotulo); }
  .faixa-cores dl div, .faixa-cores dt { display: flex; align-items: center; gap: .4em; }
  .faixa-cores dl div { justify-content: space-between; gap: var(--e-2); }
  dt i { width: 1em; height: 1em; border: 1px solid currentColor; }
  table { border-spacing: 0; table-layout: fixed; min-width: 76rem; width: 100%; text-align: left; font-variant-numeric: tabular-nums; }
  th, td { padding: var(--e-1); border-bottom: 1px solid var(--linha); }
  thead code { overflow-wrap: anywhere; }
  thead th { font-size: var(--t-rotulo); }
  td .etiqueta, th .etiqueta { letter-spacing: normal; }
  th:first-child { width: 9rem; }
  thead th { vertical-align: bottom; }
  th:first-child { position: sticky; left: 0; background: var(--fundo); border-right: 1px solid var(--linha); }
  td .etiqueta, th .etiqueta { display: block; margin-top: .35em; }
  .selo { border: 1px solid var(--linha); padding: .2em .45em; width: fit-content; }
  .miniatura { display: flex; align-items: center; gap: .4em; width: fit-content; padding-inline: .4em; border: 1px solid currentColor; }
  .miniatura :global(.barra) { width: .25em; height: .85em; background: var(--amostra-destaque); }
</style>
