---
import { coresDoTema, dois, medidasDoTema, nivelTexto, paletas } from '../../../scripts/cores-temas.mjs';

interface Props { lista?: boolean }
const { lista = false } = Astro.props;
const nomes: Record<string, string> = {
  TEMAS_DO_SITE: 'Site',
  TEMAS_DE_POSICAO: 'Posicionamento',
  TEMAS_DO_TIBUM: 'Tibum',
  TEMAS_DO_TRIO: 'Trio',
  TEMAS_DA_PARADA: 'Parada',
  TEMAS_DA_WIG: 'WIG',
};
---

<section aria-labelledby="temas">
  <header>
    <h3 id="temas" class="titulo-secao">Temas e contraste</h3>
    <p class="t-apoio">Abra um tema para ver as três cores de base, as seis calculadas e os pares em uso.</p>
    <p>Leitura pede 4,5:1. Enfeite pede 3:1. A tabela usa os critérios de <a href="https://www.w3.org/TR/WCAG22/#contrast-minimum">contraste da WCAG 2.2</a>.</p>
  </header>
  <nav aria-label="Paletas">
    {paletas.map(({ id }) => <a href={`#${id.toLowerCase()}`}>{nomes[id] ?? id}</a>)}
  </nav>

  {paletas.map(({ id, temas }) => (
    <section class="paleta" aria-labelledby={id.toLowerCase()}>
      <h4 id={id.toLowerCase()} class="t-medio">{nomes[id] ?? id} <small>{temas.length} temas</small></h4>
      <div class:list={['temas', { lista }]}>
        {temas.map((tema) => {
          const cores = coresDoTema(tema);
          return (
            <details data-camarim-tema={tema.id}>
              <summary>
                <span class="amostra" style={`background:${cores.fundo};color:${cores.texto}`} aria-hidden="true">
                  Aa<span style={`background:${cores.destaque}`}></span>
                </span>
                <strong>{tema.nome}</strong>
              </summary>
              <dl class="cores">
                {Object.entries(cores).map(([nome, valor]) => (
                  <div>
                    <dt><span style={`background:${valor}`} aria-hidden="true"></span><code>--{nome}</code></dt>
                    <dd><code>{valor}</code></dd>
                  </div>
                ))}
              </dl>
              <div class="tabela" role="region" tabindex="0" aria-label={`Contraste de ${tema.nome}`}>
                <table>
                  <caption class="so-leitor">Contraste de {tema.nome}</caption>
                  <thead><tr><th scope="col">Par</th><th scope="col">Razão</th><th scope="col">WCAG · texto</th><th scope="col">WCAG · enfeite</th><th scope="col">Regra do site</th></tr></thead>
                  <tbody>
                    {medidasDoTema(cores).map(({ cor, superficie, razao, minimo }) => (
                      <tr data-par={`${cor}/${superficie}`}>
                        <th scope="row"><code>--{cor}</code> sobre <code>--{superficie}</code></th>
                        <td>{dois(razao)}:1</td>
                        <td>{nivelTexto(razao)}</td>
                        <td>{minimo === 3 ? (razao >= 3 ? 'AA' : 'Não passa') : '·'}</td>
                        <td>{minimo === 3 ? 'Enfeite · 3:1' : 'Leitura · 4,5:1'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          );
        })}
      </div>
    </section>
  ))}
</section>

<style>
  header > p + p { margin-top: var(--e-1); }
  nav { display: flex; flex-wrap: wrap; gap: .35rem 1.15rem; margin-block: var(--e-2) var(--e-4); font-weight: 700; }
  .paleta + .paleta { margin-top: var(--e-4); }
  h4 { margin: 0 0 var(--e-2); }
  h4 small { font-size: .875rem; color: var(--suave); margin-inline-start: .5rem; }
  .temas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: .5rem; align-items: start; }
  .temas.lista { grid-template-columns: 1fr; gap: 0; }
  details { border: 1px solid var(--linha); min-width: 0; }
  details[open] { grid-column: 1 / -1; }
  .lista details { border-width: 0 0 1px; }
  .lista details:first-child { border-top-width: 1px; }
  summary { display: flex; align-items: center; gap: .65rem; min-height: 3rem; padding: .45rem .65rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-inline-start: auto; font-size: 1.3em; color: var(--destaque-texto); }
  details[open] summary::after { content: '−'; }
  summary:hover strong { text-decoration: underline; }
  .amostra { display: inline-flex; flex: none; align-items: center; justify-content: space-between; gap: .45em; padding: .2em .45em; min-width: 3.4em; font-weight: 800; font-size: 1rem; }
  .amostra span { width: .35em; height: 1.2em; transform: skewX(26.5deg); }
  .cores { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr)); gap: .5rem; padding: .65rem; margin-block: 0; }
  .cores div { min-width: 0; font-size: .875rem; }
  dt { display: grid; gap: .25rem; }
  dt span { display: block; height: 1.65rem; border: 1px solid var(--linha); }
  dd { margin: 0; color: var(--suave); }
  .tabela { overflow-x: auto; padding: .65rem; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; text-align: left; }
  th, td { padding: .5rem; border-bottom: 1px solid var(--linha); }
  td:nth-child(2) { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
