---
import Capitulo from './Capitulo.astro';
import { valor } from './token';
const tipos = [
  ['t-gigante', 'Pista', 'Título de página'],
  ['t-secao', 'Noite', 'Título de cena do Sobre'],
  ['t-grande', 'Na dobra da noite', 'Chamada principal de um bloco'],
  ['titulo-secao', 'Quem faz hoje', 'Título de seção'],
  ['t-medio', 'Cabe mais uma?', 'Subtítulo'],
  ['t-apoio', 'A última música sempre pede companhia.', 'Texto de apoio'],
  ['', 'A gente se encontra perto do som.', 'Texto corrido'],
  ['t-pequeno', 'Portas às 22h.', 'Nota técnica e informação secundária'],
  ['etiqueta', 'Próximo projeto', 'Rótulo de função ou de peça'],
];
const medidas = ['margem', 'e-1', 'e-2', 'e-3', 'e-4', 'e-5', 'e-6', 'raio-cartao', 'folga-cartao'];
---

<Capitulo id="tipo">
  <ul class="tipos">
    {tipos.map(([classe, amostra, uso]) => (
      <li>
        <p class={classe}>{amostra}</p>
        <div><p class="t-pequeno"><code>{classe ? '.' + classe : 'body'}</code></p><p>{uso}</p></div>
        <p class="etiqueta">Urbanist Variable</p>
      </li>
    ))}
  </ul>
  <h4 class="t-medio">Escala no código</h4>
  <dl class="valores">
    {['t-rotulo', 't-apoio', 't-3', 't-4', 't-5'].map(nome => <div class="t-pequeno"><dt><code>--{nome}</code></dt><dd><code>{valor(nome)}</code></dd></div>)}
  </dl>
  <p slot="regras">Mantenha os títulos em ordem, sem pular nível. A classe de texto dá o tamanho de cada título.</p>
</Capitulo>
<section aria-label="Espaço e movimento">
  <div class="grupo">
    <h4 class="t-medio">Espaço</h4>
    <dl class="valores">
      {medidas.map((nome) => (
        <div>
          <dt><code>--{nome}</code></dt>
          <dd><code>{valor(nome)}</code></dd>
          <dd class="medida" aria-hidden="true" style={nome === 'raio-cartao' ? 'width:var(--raio-cartao);border-radius:var(--raio-cartao) 0 0 0' : `width:var(--${nome})`}></dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="grupo">
    <h4 class="t-medio">Movimento</h4>
    <ul>
      <li><code>data-anima</code> aciona entradas como subida, surgimento e capa quando o trecho aparece.</li>
      <li><code>data-corre</code> pausa letreiros e parede fora da tela.</li>
      <li><code>.troca-viva</code> transiciona cores em 0,7 s com <code>ease</code>.</li>
      <li><code>.pino-novo</code> usa a rolagem como relógio nas cenas presas no toque.</li>
      <li><code>prefers-reduced-motion</code> mostra as peças no estado final e pausa o movimento contínuo.</li>
    </ul>
  </div>
</section>

<style>
  h4 { margin: 0 0 var(--e-2); }
  .grupo + .grupo { margin-top: var(--e-4); }
  dl { margin-block: 0; }
  dd { margin: 0; }
  .tipos { display: block; list-style: none; padding: 0; margin-bottom: var(--e-3); }
  .tipos li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto; align-items: baseline; gap: var(--e-2); padding-block: var(--e-2); border-top: 1px solid var(--linha); }
  .tipos li p { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 720px) {
    .tipos li { grid-template-columns: 1fr auto; }
    .tipos li > :first-child { grid-column: 1 / -1; }
  }
  .valores { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: .6rem 1rem; margin-block-start: var(--e-2); }
  .valores > div { padding: .6rem 0; border-bottom: 1px solid var(--linha); }
  .valores dd { color: var(--suave); }
  .medida { height: .65rem; margin-top: .45rem; background: var(--destaque); }
  ul { display: grid; gap: .5rem; list-style: disc; padding-inline-start: 1.25rem; }
</style>
