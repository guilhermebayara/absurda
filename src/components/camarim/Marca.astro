---
import Botao from '../Botao.astro';
import Parte from './Parte.astro';
import Capitulo from './Capitulo.astro';
const arquivos = import.meta.glob('/public/marca/*.svg', { query: '?raw', eager: true, import: 'default' }) as Record<string, string>;
const categorias = [
  { nome: 'Principais', versoes: [['principal_completo', 'Completo'], ['principal_arroba', 'Arroba']] },
  { nome: 'Secundárias', versoes: [['secundaria_vertical', 'Vertical'], ['secundaria_silabas', 'Sílabas']] },
  { nome: 'Composições', versoes: [['composicao_arroba-escrito', 'Arroba escrito'], ['composicao_arroba-escrito-grande', 'Arroba escrito grande']] },
];
const cores = [
  { nome: 'Escura', codigo: '#231f20', sufixo: '' },
  { nome: 'Branca', codigo: '#fff', sufixo: '_branco' },
];
const dimensoes = (src: string) => {
  const medidas = arquivos['/public' + src]?.match(/viewBox="[^ ]+ [^ ]+ ([\d.]+) ([\d.]+)"/);
  if (!medidas) throw new Error(`Não achei as medidas no SVG ${src}.`);
  return [Number(medidas[1]), Number(medidas[2])];
};
const decimal = (n: number) => n.toLocaleString('pt-BR', { maximumFractionDigits: 2 });
---
<Parte nome="Marca">
  <Capitulo id="logo">
    <div class="versoes">
      {categorias.flatMap(({ nome: categoria, versoes }) => versoes.map(([id, nome]) => {
        const base = `/marca/absurda_${id}`;
        const [w, h] = dimensoes(base + '.svg');
        return (
          <article class="versao">
            <h4 class="etiqueta">{nome} · {categoria}</h4>
            <div class="cores">
              {cores.map(({ nome: cor, sufixo }) => (
                <div>
                  <div class:list={['prancha', { escura: sufixo }]}>
                    <img src={base + sufixo + '.svg'} width={Math.round(w)} height={Math.round(h)} alt={nome + ', versão ' + cor.toLowerCase()} loading="lazy" />
                  </div>
                  <p class="etiqueta">{cor}</p>
                  <ul aria-label={`Downloads de ${nome}, versão ${cor.toLowerCase()}`}>
                    {['SVG', 'PNG 1000', 'PNG 3000'].map((formato, i) => (
                      <li><Botao tipo="linha" download href={base + sufixo + ['.svg', '-1000.png', '-3000.png'][i]} aria-label={`Baixar ${nome}, versão ${cor.toLowerCase()}, em ${formato}`}>{formato}</Botao></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p class="t-pequeno">Proporção {decimal(w / h)}:1 · SVG {decimal(w)} × {decimal(h)} · PNG {1000} × {Math.round(1000*h/w)} e {3000} × {Math.round(3000*h/w)} px</p>
          </article>
        );
      }))}
    </div>
    <p slot="regras">Use os SVGs oficiais de 2024. Os PNGs de 1000 e 3000 px vêm desses arquivos e têm fundo transparente.</p>
  </Capitulo>
  <Capitulo id="cores-da-marca">
    <ul class="cores tintas">
      {cores.map(({ nome, codigo }) => (
        <li>
          <span class="tinta" style={`background:${codigo}`} aria-hidden="true"></span>
          <span class="etiqueta">{nome}</span>
          <span class="t-pequeno"><code>{codigo}</code></span>
        </li>
      ))}
    </ul>
    <p slot="regras">A marca tem um SVG oficial para cada cor. Preserve o preenchimento que vem no arquivo.</p>
  </Capitulo>
</Parte>
<style>
  .versoes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-3); }
  .versao { border: 1px solid var(--linha); padding: var(--e-2); border-radius: var(--raio-cartao); }
  .versao:first-child { grid-column: 1 / -1; }
  h4 { margin: 0 0 var(--e-2); }
  .cores { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-1); }
  .prancha { display: grid; place-items: center; background: #fff; padding: var(--e-2); }
  .prancha.escura { background: #231f20; }
  .prancha img { width: 100%; height: clamp(5rem, 12vw, 11rem); object-fit: contain; }
  .versao:first-child img { height: clamp(6rem, 18vw, 18rem); }
  .etiqueta, .t-pequeno { overflow-wrap: anywhere; }
  .cores p, .t-pequeno { margin-top: var(--e-2); }
  ul { display: flex; flex-wrap: wrap; gap: var(--e-1) var(--e-2); margin-top: var(--e-1); }
  .tintas { gap: var(--e-2); }
  .tintas li { display: grid; gap: var(--e-1); }
  .tinta { height: var(--e-5); border: 1px solid var(--linha); border-radius: var(--raio-cartao); }
  .tintas .t-pequeno { margin: 0; }
  @media (max-width: 860px) { .versoes { grid-template-columns: 1fr; } }
</style>
