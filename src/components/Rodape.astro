---
import { SITE, NAV } from '../config';
import BarraInclinada from './BarraInclinada.astro';
import Completo from './marca/Completo.astro';
---
<footer class="rodape">
  <div class="rodape-topo">
    <nav class="rodape-nav" aria-label="Rodapé">
      <ul>
        {NAV.map((item, i) => (
          <li><a href={item.href} data-anima="sobe" style={`--i:${i}`}>{item.rotulo}</a></li>
        ))}
      </ul>
    </nav>
    <div class="rodape-lado">
      <div data-anima="surge">
        <h2>Fora daqui</h2>
        <ul>
          <li><a href={SITE.ingressos} target="_blank" rel="noopener">Ingressos na Shotgun</a></li>
          <li><a href={SITE.fotos} target="_blank" rel="noopener">Fotos no Pixieset</a></li>
          <li><a href={SITE.redes.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={SITE.redes.tiktok} target="_blank" rel="noopener">TikTok</a></li>
          <li><a href={SITE.redes.twitter} target="_blank" rel="noopener">Twitter</a></li>
        </ul>
      </div>
      <div data-anima="surge" style="--i:1">
        <h2>Fale com a gente</h2>
        <ul>
          <li><a href={SITE.mensagem} target="_blank" rel="noopener">Mensagem no Instagram</a></li>
          <li><a href="/parcerias">Sua marca na @bsurda</a></li>
        </ul>
      </div>
    </div>
  </div>
  <p class="rodape-fim"><BarraInclinada oculta /><b><em>© {new Date().getFullYear()} @bsurda.</em> <em class="solta"><i>{SITE.lema},</i> <i>desde 2009.</i></em> <em>Belo Horizonte.</em></b><BarraInclinada oculta /></p>
  <a class="rodape-marca" href="/" aria-label="@bsurda, página inicial" data-anima="rodape">
    <span class="rm-eco rm-eco2" aria-hidden="true"><Completo /></span>
    <span class="rm-eco rm-eco1" aria-hidden="true"><Completo /></span>
    <Completo />
  </a>
</footer>

<style is:global>
  /* Rodapé grande */
  .rodape { position: relative; --lw: min(100vw - 2 * var(--margem), 165svh); margin-top: clamp(2rem, 5vw, 4rem); padding: clamp(2rem, min(4.5vw, 6svh), 4rem) var(--margem) 0; border-radius: clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem) 0 0; background: var(--texto); color: var(--fundo); overflow: hidden; transition: none; }
  .rodape-topo { display: grid; grid-template-columns: auto 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  /* Menu grande em duas colunas de três: continua enorme sem deixar o rodapé mais alto que a tela */
  .rodape-nav ul { display: grid; grid-template-rows: repeat(3, auto); grid-auto-flow: column; column-gap: 0.9em; font-size: clamp(1.6rem, min(5.1vw, 10.5svh), 6.5rem); }
  /* Menu grande, com a barra inclinada entrando no hover */
  .rodape-nav a { position: relative; display: block; width: fit-content; padding: 0.06em 0; font-size: inherit; font-weight: 800; line-height: 0.98; letter-spacing: -0.045em; text-transform: uppercase; text-decoration: none; transition: color 0.3s; }
  /* A barra entra na margem, à esquerda do nome: nada se desloca */
  .js .rodape-nav a[data-anima].visto { clip-path: inset(-0.3em -0.2em -0.3em -0.7em); }
  .rodape-nav a::before { content: ''; position: absolute; left: -0.4em; top: 0.16em; bottom: 0.18em; width: 0.14em; background: var(--enfeite); transform: skewX(26.5deg) scaleY(0); transition: transform 0.5s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  .rodape-nav a:hover::before, .rodape-nav a:focus-visible::before { transform: skewX(26.5deg) scaleY(1); }
  .rodape-lado { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 3vw, 2.75rem); padding-top: 0.4rem; }
  .rodape h2 { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 0.9rem; padding-bottom: 0.9rem; border-bottom: 1.5px solid color-mix(in srgb, var(--fundo) 35%, transparent); }
  .rodape-lado li { margin-bottom: 0.3rem; overflow-wrap: anywhere; }
  .rodape-lado li a { font-size: clamp(1.0625rem, 1.45vw, 1.375rem); font-weight: 700; letter-spacing: -0.01em; text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat; transition: background-size 0.5s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  .rodape-lado li a:hover, .rodape-lado li a:focus-visible { background-size: 100% 2px; }
  /* Assinatura entre as barras do logo, como o lema da abertura */
  .rodape-fim { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: clamp(1.75rem, min(4vw, 5svh), 3.5rem); text-align: center; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; line-height: 1.7; }
  /* Cada frase é um bloco que não quebra no meio: em tela estreita elas se empilham inteiras */
  .rodape-fim b { font-weight: inherit; }
  .rodape-fim em { display: inline-block; font-style: normal; white-space: nowrap; }
  /* O pedaço do meio só se parte ("desde 2009." desce) quando não cabe sozinho numa linha,
     em tela muito estreita (320). Sem isso, a barra da direita saía da tela. */
  .rodape-fim em.solta { white-space: normal; }
  .rodape-fim em.solta i { display: inline-block; font-style: normal; white-space: nowrap; }
  .rodape-fim > span { flex: none; width: 0.5rem; height: 2.4rem; background: currentColor; }
  /* Logo gigante sangrando para fora da página, com ecos que sobem quando ele entra na tela */
  .rodape-marca { position: relative; display: block; width: var(--lw); margin: calc(var(--lw) * 0.1 + 1rem) auto calc(var(--lw) * -0.052); }
  .rodape-marca svg { width: 100%; height: auto; }
  .rodape-marca { --ab: 1; }
  .rm-eco { position: absolute; inset: 0; opacity: min(1, var(--ab) * 1.6); }
  .rm-eco1 { clip-path: inset(0 0 calc(100% - 26% * var(--ab)) 0); color: color-mix(in oklab, var(--fundo) 55%, var(--texto)); transform: translateY(calc(-35% * var(--ab))) scale(calc(1 - 0.07 * var(--ab))); }
  .rm-eco2 { clip-path: inset(0 0 calc(100% - 16% * var(--ab)) 0); color: color-mix(in oklab, var(--fundo) 28%, var(--texto)); transform: translateY(calc(-61% * var(--ab))) scale(calc(1 - 0.15 * var(--ab))); }
  @media (max-width: 860px) {
    .rodape-topo { grid-template-columns: 1fr; gap: 1.75rem; }
    .rodape-nav ul { font-size: clamp(1.6rem, 7.4vw, 3.25rem); }
    .rodape h2 { margin-bottom: 0.6rem; padding-bottom: 0.6rem; }
    /* No celular o logo aparece inteiro: cortado, ele briga com a barra do navegador. */
    /* No celular o rodapé fecha como cartão: cantos arredondados também embaixo e um respiro
       na cor da página, que é a mesma da faixa do navegador. Assim o fim lê como forma, não como corte. */
    .rodape { padding-bottom: 2rem; margin-bottom: 0.75rem; border-radius: clamp(1.5rem, 4vw, 3.5rem); }
    .rodape-marca { margin-bottom: 0; }
  }
  /* Listas do rodapé ficam justas também no toque (decisão do Gui): o alvo de 44px afastava as
     linhas a ponto de parecer erro. Não aumentar de novo sem ele pedir. */
  @media (prefers-reduced-motion: reduce) { .rodape-nav a, .rodape-nav a::before, .rodape-lado li a { transition: none; } }
</style>
