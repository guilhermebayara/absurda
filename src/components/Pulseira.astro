---
import Arroba from './marca/Arroba.astro';

interface Props {
  nome: string;
  area: string;
  url?: string;
  destino?: string;
  alternativa?: boolean;
}
const { nome, area, url, destino, alternativa = false } = Astro.props;
const Tag = url ? 'a' : 'span';
---
<li class:list={{ 'pulseira-b': alternativa }}>
  <Tag class="pulseira" href={url} target={url ? '_blank' : undefined} rel={url ? 'noopener' : undefined}>
    <span class="pulseira-cola" aria-hidden="true"></span>
    <strong>{nome}</strong>
    <span class="pulseira-area">{area}</span>
    <span class="pulseira-estampa" aria-hidden="true">
      <span class="pulseira-trilho">{Array.from({ length: 24 }).map(() => <><Arroba class="pulseira-marca" /><span>{area}</span></>)}</span>
    </span>
    {url && <span class="pulseira-destino"><span class="pulseira-destino-nome">{destino ?? 'Abrir'}</span><span class="pulseira-seta" aria-hidden="true">↗</span><span class="pulseira-anel" aria-hidden="true"><svg class="anel-arco" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /></svg><svg class="anel-seta" viewBox="0 0 16 16"><path d="M4.5 3.5h8v8M12.5 3.5 3.5 12.5" /></svg></span><span class="so-leitor"> (abre em outra aba)</span></span>}
    <span class="pulseira-rabo" aria-hidden="true"></span>
  </Tag>
</li>

<style>
  li { --p-fundo: var(--vivo); --p-texto: var(--sobre-vivo); --p-aba: var(--texto); --p-risco: var(--fundo); }
  li.pulseira-b { --p-fundo: var(--texto); --p-texto: var(--fundo); --p-aba: var(--vivo); --p-risco: var(--sobre-vivo); }
  .pulseira { display: flex; align-items: center; height: clamp(3.25rem, 4.6vw, 4.25rem); border-radius: 3px; background: var(--p-fundo); color: var(--p-texto); text-decoration: none; overflow: hidden; white-space: nowrap; }
  .pulseira-cola { flex: none; align-self: stretch; width: clamp(3.5rem, 9%, 7rem); background-color: var(--p-aba);
    background-image: linear-gradient(135deg, var(--p-risco) 25%, transparent 25%), linear-gradient(225deg, var(--p-risco) 25%, transparent 25%), linear-gradient(315deg, var(--p-risco) 25%, transparent 25%), linear-gradient(45deg, var(--p-risco) 25%, transparent 25%);
    background-size: 14px 14px; background-position: -7px 0, -7px 0, 0 0, 0 0; background-blend-mode: normal; opacity: 1; }
  .pulseira-cola { box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--p-aba) 62%, transparent); }
  .pulseira strong { flex: none; padding: 0 0.9rem 0 1rem; font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
  /* A área, uma vez, para quem lê com leitor de tela; na tela ela aparece na estampa. */
  .pulseira-area { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .pulseira-estampa { flex: 1; min-width: 0; overflow: hidden; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; -webkit-mask-image: linear-gradient(90deg, #000 10rem, rgba(0, 0, 0, 0.5) 20rem); mask-image: linear-gradient(90deg, #000 10rem, rgba(0, 0, 0, 0.5) 20rem); }
  /* A estampa é um trilho com o mesmo desenho repetido; ao passar o cursor, ele corre, como se a
     pulseira estivesse sendo puxada do rolo. Metade do trilho é igual à outra, então o laço não tem emenda. */
  .pulseira-trilho { display: inline-flex; align-items: center; gap: 0.9rem; padding-right: 0.9rem; animation: puxa 26s linear infinite; animation-play-state: paused; }
  @keyframes puxa { to { transform: translateX(-50%); } }
  @media (hover: hover) and (pointer: fine) {
    li:hover .pulseira-trilho, li:focus-within .pulseira-trilho { animation-play-state: running; }
  }
  /* Pulseira com link: o destino fica escrito perto da sobra, com a seta de link externo. */
  .pulseira-seta { margin-left: 0.35em; }
  .pulseira-anel { display: none; }
  .pulseira-destino { flex: none; padding: 0 0.9rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em; }
  .pulseira-estampa :global(.pulseira-marca) { flex: none; height: 1.35rem; width: auto; }
  .pulseira-estampa span { flex: none; }
  .pulseira-rabo { flex: none; align-self: stretch; width: clamp(1rem, 3%, 2.25rem); background: var(--p-aba); }
  a.pulseira:hover .pulseira-destino, a.pulseira:focus-visible .pulseira-destino { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  @media (max-width: 820px) {
    /* No celular o destino vira só a seta, no anel aberto do "@" que os botões do site usam
       (Botao.astro), para ler como botão. O nome do destino segue para leitores de tela. Com o
       espaço que sobra, a estampa volta: ela some num degradê à direita, para nunca cortar um
       símbolo ao meio. */
    .pulseira-cola { width: 2rem; }
    .pulseira strong { font-size: 1.125rem; padding: 0 0.6rem 0 0.6rem; }
    .pulseira-estampa { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent); font-size: 0.625rem; letter-spacing: 0.12em; }
    .pulseira-trilho { gap: 0.6rem; padding-right: 0.6rem; }
    .pulseira-estampa :global(.pulseira-marca) { height: 1.1rem; }
    .pulseira-destino { padding: 0 0.5rem; }
    .pulseira-destino-nome { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .pulseira-seta { display: none; }
    .pulseira-anel { display: block; position: relative; width: 2rem; height: 2rem; }
    .anel-arco { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transform: rotate(158.5deg); }
    .anel-arco circle { fill: none; stroke: currentColor; stroke-width: 3.4; stroke-dasharray: 75.8 31; }
    .anel-seta { position: absolute; inset: 0; margin: auto; width: 38%; height: 38%; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  }
  @media (prefers-reduced-motion: reduce) { .pulseira-trilho { animation: none; } }
</style>
