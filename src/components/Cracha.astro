---
// Crachá de produção de uma pessoa da equipe.
//
// Duas cores, pelo papel na festa:
// - produção (sócios): crachá na cor de destaque do tema (subtema "vivo", ver Base.astro);
// - cabine (residentes): crachá invertido, na cor do texto.
// Os dois são sólidos: crachá na cor da página parecia vazado.
// O selo "Fundador" é exclusivo do crachá do Ed.
//
// Versão alumni, para quem já fez parte: o mesmo crachá, com mudanças de propósito. O rótulo vira
// "Já fez parte", o acesso vira "Vitalício" (saiu da equipe, a porta segue aberta), o verso mostra
// o intervalo no lugar de "Desde", com o total de anos fechado, e a borda vem picotada, como
// ingresso já validado. O número do crachá continua: crachá não se reaproveita.
//
// Com "verso", o crachá vira ao passar o cursor (só onde existe cursor) e mostra desde quando a
// pessoa está na @bsurda. Sem o ano cadastrado, aparecem XXXX e X como marcação.
import Arroba from './marca/Arroba.astro';

interface Props {
  nome: string;
  funcao: string;
  grupo: 'socios' | 'residentes' | 'equipe';
  foto?: string;
  desde?: number;
  ate?: number;
  alumni?: boolean;
  numero?: number;
  sigla?: string;
  href?: string;
  fundador?: boolean;
  verso?: boolean;
  // 'verso' mostra só o verso, parado: para compor frente e verso lado a lado na página da pessoa.
  lado?: 'frente' | 'verso';
  class?: string;
}
const { nome, funcao, grupo, foto, desde, ate, alumni = false, numero, sigla: siglaDada, href, fundador = false, verso = false, lado = 'frente', class: classe } = Astro.props;
const soVerso = lado === 'verso';
const producao = grupo === 'socios';
const rotulo = alumni ? 'Já fez parte' : producao ? 'Produção' : grupo === 'residentes' ? 'Residente' : 'Equipe';
const acesso = alumni ? 'Vitalício' : producao ? 'Total' : grupo === 'residentes' ? 'Cabine' : 'Produção';
// Quem está: conta até hoje. Quem saiu: o total fica fechado no ano de saída.
const anos = alumni ? (desde && ate ? ate - desde : undefined) : desde ? new Date().getFullYear() - desde : undefined;
// Número do crachá com três casas; XXX enquanto não foi definido.
const num = numero ? String(numero).padStart(3, '0') : 'XXX';
// Código do verso: parece código, mas dá para ler. Cinco partes, nesta ordem:
// @B (a festa), número do crachá, primeiro nome (até 4 letras), ano de entrada e função
// (iniciais das palavras; sigla como DJ entra inteira). Ed Luiz: @B-001-ED-2009-PDJ.
const semAcento = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const sigla = siglaDada ?? semAcento(funcao).split(/\s+/).filter((p) => p.length > 1).map((p) => (p === p.toUpperCase() ? p : p[0].toUpperCase())).join('');
const codigo = ['@B', num, semAcento(nome.split(' ')[0]).toUpperCase().slice(0, 4), desde ?? 'XXXX', sigla].join('-');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['cracha', producao ? 'cracha-producao' : 'cracha-cabine', { 'cracha-vira': verso && !soVerso, 'cracha-so-verso': soVerso, 'cracha-alumni': alumni }, classe]} href={href}>
  <span class="cracha-giro">
    {!soVerso && <span class="cracha-face cracha-frente">
      <span class="cracha-furo" aria-hidden="true"></span>
      <span class="cracha-topo" aria-hidden="true"><Arroba class="cracha-marca" /><span>{rotulo}</span></span>
      <span class="cracha-retrato" aria-hidden="true">
        {foto ? <img src={foto} alt="" loading="lazy" /> : <span class="cracha-inicial">{nome[0]}</span>}
      </span>
      {fundador && <span class="cracha-selo"><strong>Fundador</strong><span>2009</span></span>}
      <span class="cracha-texto">
        <strong class="cracha-nome">{nome}</strong>
        <span class="cracha-funcao">{funcao}</span>
      </span>
      <span class="cracha-acesso"><span>Acesso</span><strong>{acesso}</strong></span>
    </span>}
    {(verso || soVerso) && (
      <span class="cracha-face cracha-verso" aria-hidden="true">
        <span class="cracha-furo"></span>
        <span class="cracha-topo"><Arroba class="cracha-marca" /><span>Na @bsurda</span></span>
        <span class:list={['cracha-desde', { 'cracha-intervalo': alumni }]}>
          <span class="cracha-desde-rotulo">{alumni ? 'Período' : 'Desde'}</span>
          <strong>{alumni ? `${desde ?? 'XXXX'}–${ate ?? 'XXXX'}` : (desde ?? 'XXXX')}</strong>
          <span class="cracha-anos">{anos ?? 'X'} anos de @bsurda</span>
        </span>
        <span class="cracha-registro">
          <span><span>Crachá nº</span><strong>{num}</strong></span>
          {fundador && <span><span>Condição</span><strong>Fundador</strong></span>}
        </span>
        <span class="cracha-codigo">
          <span class="cracha-barras"></span>
          <span>{codigo}</span>
        </span>
        <span class="cracha-acesso">{href ? <><span>Intransferível</span><strong>Ver página</strong></> : <span>Pessoal e intransferível</span>}</span>
      </span>
    )}
  </span>
</Tag>

<style>
  .cracha { --c-fundo: var(--texto); --c-texto: var(--fundo); --c-detalhe: var(--enfeite);
    display: block; aspect-ratio: 5 / 7; color: var(--c-texto); text-decoration: none; perspective: 1400px; }
  /* Proporção de crachá de verdade (5 por 7), sempre. A foto ocupa a altura que sobra. */
  .cracha-producao { --c-fundo: var(--vivo); --c-texto: var(--sobre-vivo); --c-detalhe: var(--vivo-detalhe); }
  .cracha-giro { position: relative; display: block; height: 100%; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cracha-face { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto 1fr auto auto; height: 100%; padding: 0.9rem 0.9rem 1rem; border-radius: clamp(1rem, 1.8vw, 1.5rem); background: var(--c-fundo); backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  /* O verso tem margem lateral maior que a frente: é uma ficha, não uma foto (desenho do Gui). */
  .cracha-verso { padding: 1.1rem 1.25rem 1.1rem; }
  .cracha-verso { position: absolute; inset: 0; grid-template-rows: auto auto 1fr; grid-auto-rows: auto; transform: rotateY(180deg); visibility: hidden; transition: visibility 0s 0.14s; }
  .cracha-frente { transition: visibility 0s 0.14s; }
  /* Verso sozinho e parado (página da pessoa). */
  .cracha-so-verso .cracha-verso { position: relative; inset: auto; transform: none; visibility: visible; }
  @media (hover: hover) and (pointer: fine) {
    .cracha-vira:hover .cracha-giro, .cracha-vira:focus-visible .cracha-giro { transform: rotateY(180deg); }
    /* Além de esconder o avesso de cada face, troca a face visível no meio do giro. Sem isso,
       alguns navegadores mostravam o selo da frente espelhado no verso. */
    .cracha-vira:hover .cracha-frente, .cracha-vira:focus-visible .cracha-frente { visibility: hidden; }
    .cracha-vira:hover .cracha-verso, .cracha-vira:focus-visible .cracha-verso { visibility: visible; }
  }

  .cracha-furo { justify-self: center; width: 2.75rem; height: 0.6rem; border-radius: 1rem; background: var(--fundo); }
  .cracha-topo { display: flex; align-items: center; justify-content: space-between; margin-top: 0.8rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .cracha-topo :global(.cracha-marca) { height: 1.5rem; width: auto; color: var(--c-detalhe); }
  .cracha-retrato { position: relative; display: block; overflow: hidden; min-height: 0; margin-top: 0.7rem; border-radius: clamp(0.6rem, 1vw, 0.9rem); background: color-mix(in srgb, var(--c-texto) 12%, var(--c-fundo)); }
  .cracha-retrato img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; display: block; }
  .cracha-inicial { position: absolute; left: -0.04em; bottom: -0.2em; font-size: clamp(11rem, 19vw, 17rem); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em; text-transform: uppercase; color: var(--c-detalhe); }
  .cracha-texto { display: grid; gap: 0.3rem; margin-top: 0.9rem; }
  .cracha-nome { font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 800; line-height: 0.92; letter-spacing: -0.03em; text-transform: uppercase; }
  .cracha-funcao { font-size: 0.9375rem; line-height: 1.25; }
  .cracha-acesso { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-top: 1rem; padding-top: 0.7rem; border-top: 2px solid var(--c-texto); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em; }
  .cracha-acesso span { font-weight: 500; }
  .cracha-acesso strong { font-weight: 800; }

  /* Selo do fundador: um adesivo redondo colado por cima do crachá, só no do Ed. */
  .cracha-selo { position: absolute; top: 4.6rem; right: -0.9rem; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 0.1rem; width: 6rem; aspect-ratio: 1; border-radius: 50%; background: var(--c-texto); color: var(--c-fundo); transform: rotate(12deg); text-transform: uppercase; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .cracha-selo strong { font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.08em; }
  .cracha-selo span { font-size: 1.5rem; font-weight: 800; line-height: 0.9; letter-spacing: -0.03em; }

  /* Verso: o ano de entrada em tamanho de cartaz, um código de barras de brincadeira e o aviso
     de crachá de verdade. */
  /* Mesmo respiro em cima e embaixo do código: do número até as barras, e do código até a linha. */
  .cracha-verso .cracha-acesso { margin-top: 0.3rem; padding-top: 0.5rem; font-size: 0.6875rem; letter-spacing: 0.12em; white-space: nowrap; }
  /* O bloco do ano fica centralizado no crachá, com o texto alinhado à esquerda dentro dele.
     "N anos de @bsurda" vira uma etiqueta cheia, na cor do texto. */
  .cracha-desde { display: grid; justify-self: center; align-content: center; justify-items: start; gap: 0.35rem; min-height: 0; }
  .cracha-desde-rotulo { font-size: 1.125rem; line-height: 1.1; }
  .cracha-desde strong { font-size: clamp(3.25rem, 5vw, 4.75rem); font-weight: 800; line-height: 0.85; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  /* Alumni: o intervalo tem mais que o dobro de caracteres do ano, então o corpo cai. */
  .cracha-intervalo strong { font-size: 2.5rem; letter-spacing: -0.04em; white-space: nowrap; }
  /* Picote de validação: uma mordida redonda na borda lateral, que cabe na margem sem tocar a foto.
     À esquerda na frente e, como no verso de um objeto real, à direita atrás: são as bordas
     que ficam livres quando os dois aparecem sobrepostos na página da pessoa. */
  .cracha-alumni .cracha-frente { -webkit-mask-image: radial-gradient(circle at 0 58%, transparent 0.62rem, #000 0.66rem); mask-image: radial-gradient(circle at 0 58%, transparent 0.62rem, #000 0.66rem); }
  .cracha-alumni .cracha-verso { -webkit-mask-image: radial-gradient(circle at 100% 58%, transparent 0.62rem, #000 0.66rem); mask-image: radial-gradient(circle at 100% 58%, transparent 0.62rem, #000 0.66rem); }
  .cracha-anos { margin-top: -0.05rem; padding: 0.18em 0.7em 0.22em; border-radius: 99px; background: var(--c-texto); color: var(--c-fundo); font-size: 0.875rem; line-height: 1.2; white-space: nowrap; }
  /* Registro: o número do crachá, em todos. A condição de fundador, como dado oficial, só no do Ed. */
  /* Rótulo e valor na mesma linha, assentados na mesma base, colados ao código de barras
     (desenho do Gui). A condição, quando existe, vai para a direita. */
  .cracha-registro { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-bottom: 0.3rem; padding-top: 0.3rem; border-top: 2px solid var(--c-texto); }
  .cracha-registro > span { display: inline-flex; align-items: baseline; gap: 0.4em; white-space: nowrap; }
  .cracha-registro span span { font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; }
  .cracha-registro strong { font-size: 1.375rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; }
  .cracha-codigo { display: grid; gap: 0.3rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; white-space: nowrap; overflow: hidden; }
  .cracha-barras { display: block; height: 1.75rem; background: linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px, currentColor 10px 14px, transparent 14px 16px, currentColor 16px 17px, transparent 17px 22px, currentColor 22px 24px, transparent 24px 27px, currentColor 27px 28px, transparent 28px 31px) 0 0 / 31px 100% repeat-x; }

  @media (prefers-reduced-motion: reduce) { .cracha-giro, .cracha-frente, .cracha-verso { transition: none; } }
</style>
