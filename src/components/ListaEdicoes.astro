---
// Lista de edições de um projeto: uma linha por edição, com data, nome e local, entre fios.
// Usada no histórico dos projetos de poucas edições, nas edições de cada ano da conta por ano e
// nas "primas". A data chega pronta, no formato que cada lugar pede. "anima" liga a entrada de
// cada linha ao rolar a página.
interface Edicao { quando: string; nome: string; local?: string; url: string }
interface Props { edicoes: Edicao[]; anima?: boolean }
const { edicoes, anima = false } = Astro.props;
---
<ul class="edicoes">
  {edicoes.map((e) => (
    <li data-anima={anima ? 'surge' : undefined}>
      <a href={e.url} target="_blank" rel="noopener">
        <span class="edicao-data">{e.quando}</span>
        <strong>{e.nome}</strong>
        <span>{e.local ?? ''}<span class="so-leitor"> (abre em outra aba)</span></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .edicoes { margin-top: var(--e-4); border-top: 2px solid var(--texto); }
  .edicoes a { position: relative; display: grid; grid-template-columns: 9rem minmax(0, 1.4fr) minmax(0, 1fr); gap: 0.25rem var(--e-3); align-items: baseline; padding: var(--e-2) 0; border-bottom: 2px solid var(--texto); text-decoration: none; }
  .edicao-data { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-variant-numeric: tabular-nums; }
  .edicoes strong { font-size: var(--t-3); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; }
  .edicoes a:hover strong, .edicoes a:focus-visible strong { text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.12em; }
  @media (max-width: 820px) {
    .edicoes a { grid-template-columns: 1fr; }
  }
</style>
