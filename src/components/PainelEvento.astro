---
// Um evento como um grande bloco.
// A capa aparece duas vezes: desfocada, cobrindo o bloco inteiro e dando o clima,
// e nítida, inteira e sem texto por cima (as artes já vêm cheias de informação).
// O desenho se adapta ao formato da capa: deitada (16:9) ou em pé (3:4).
// A página troca para as cores do evento quando o bloco chega ao meio da tela.
import type { Evento } from '../lib/eventos';
import { partesDaData, fimDe } from '../lib/eventos';
import { atributo } from '../lib/temas';
import Botao from './Botao.astro';
import Arroba from './marca/Arroba.astro';
import { foto } from '../lib/imagens';
interface Props { evento: Evento; destaque?: boolean; trocaTema?: boolean }
const { evento, destaque = false, trocaTema = true } = Astro.props;
const d = partesDaData(evento.data);
const emPe = (evento.proporcao ?? 1.78) < 1;
// Nomes longos usam um corpo menor para não tomar o bloco inteiro.
const tamanho = evento.nome.length <= 16 ? 'curto' : evento.nome.length <= 34 ? 'medio' : 'longo';
// Selo do destaque: "Próximo evento" até a festa começar e "Acontecendo agora" enquanto ela
// dura (pedido do Gui). O site é gerado poucas vezes por dia, então quem troca o texto na hora
// certa é o script do fim deste arquivo, com o começo e o fim gravados no próprio selo.
const comeco = new Date(evento.data).getTime();
const termino = fimDe(evento);
const plataformas = { shotgun: 'Ingressos na Shotgun', sympla: 'Ingressos na Sympla', manual: 'Ingressos' };
---
<article class:list={['ev-area', { 'ev-destaque': destaque }]} data-tema={trocaTema ? atributo(evento.tema) : undefined}>
  <div class:list={['ev', emPe ? 'ev-em-pe' : 'ev-deitada']}>
    <div class="ev-fundo" aria-hidden="true">
      {evento.capaPequena && <img src={evento.capaPequena} alt="" loading="lazy" />}
    </div>

    <div class="ev-texto" data-anima="surge">
      <div class="ev-bloco">
        {destaque && <p class="ev-selo" data-comeco={comeco} data-termino={termino}><Arroba /><span>{Date.now() >= comeco ? 'Acontecendo agora' : 'Próximo evento'}</span></p>}
        <h2 class={`ev-nome ev-nome-${tamanho}`}>{evento.nome}</h2>
        <p class="ev-quando"><span class="so-leitor">Data: </span>{d.semana.slice(0, 3)}, {d.dia} {d.mes}, {d.hora}</p>
        {evento.local && (
          <p class="ev-local">
            <svg viewBox="0 0 16 20" aria-hidden="true"><path d="M8 0a8 8 0 0 0-8 8c0 5.6 8 12 8 12s8-6.4 8-12a8 8 0 0 0-8-8Zm0 11.2A3.2 3.2 0 1 1 8 4.8a3.2 3.2 0 0 1 0 6.4Z" /></svg>
            <span><span class="so-leitor">Local: </span>{evento.local}</span>
          </p>
        )}
      </div>
      <Botao href={evento.url} externo class="ev-botao">{plataformas[evento.origem]}</Botao>
    </div>

    <a class="ev-capa" href={evento.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" data-anima="capa">
      {evento.capa
        ? <img {...foto(evento.capa, '(max-width: 720px) 92vw, 50vw')} alt="" loading={destaque ? 'eager' : 'lazy'} fetchpriority={destaque ? 'high' : undefined} style={evento.proporcao ? `aspect-ratio:${evento.proporcao}` : undefined} />
        : <span class="ev-sem-capa"><Arroba /></span>}
    </a>

  </div>
</article>

{destaque && <script is:inline>
  // Troca o selo do destaque conforme a hora: antes da festa, durante e depois dela.
  (function () {
    function acerta() {
      document.querySelectorAll('.ev-selo[data-comeco]').forEach(function (selo) {
        var agora = Date.now();
        var texto = selo.querySelector('span');
        if (!texto) return;
        // Festa acabou e o site ainda não foi gerado de novo: o selo some.
        selo.hidden = agora > Number(selo.dataset.termino);
        texto.textContent = agora >= Number(selo.dataset.comeco) ? 'Acontecendo agora' : 'Próximo evento';
      });
    }
    acerta();
    setInterval(acerta, 60000);
    document.addEventListener('visibilitychange', function () { if (!document.hidden) acerta(); });
  })();
</script>}

<style>
  .ev-area { padding: clamp(1rem, 2.5vw, 2.25rem) var(--margem); }
  .ev { position: relative; display: grid; align-items: center; gap: clamp(1.5rem, 4vw, 4rem); padding: clamp(1.5rem, 4vw, 4rem); border-radius: clamp(1.25rem, 3vw, 2.5rem); color: var(--fundo); isolation: isolate; }
  .ev-deitada { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
  .ev-em-pe { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }

  /* Fundo: a cor do tema com a capa desfocada por baixo */
  .ev-fundo { position: absolute; inset: 0; z-index: -1; overflow: hidden; border-radius: inherit; background: var(--texto); }
  .ev-fundo img { width: 100%; height: 100%; object-fit: cover; filter: blur(56px) saturate(1.4); transform: scale(1.4); opacity: 0.9; }
  .ev-fundo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, var(--texto) 30%, color-mix(in srgb, var(--texto) 78%, transparent) 55%, color-mix(in srgb, var(--texto) 30%, transparent) 100%); }

  /* Texto: um bloco só, em ordem de importância (nome, data e hora, local),
     e a chamada no pé, alinhada à base da capa. */
  .ev-texto { align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; gap: var(--e-4); min-width: 0; }
  .ev-selo { display: flex; align-items: center; gap: 0.6em; margin-bottom: var(--e-2); font-size: var(--t-rotulo); font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1; }
  .ev-selo[hidden] { display: none; }
  .ev-selo :global(svg) { flex: none; width: 1.5em; height: auto; }

  .ev-nome { margin-left: -0.045em; font-weight: 800; line-height: 0.88; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; overflow-wrap: anywhere; }
  .ev-nome-curto { font-size: clamp(3rem, 8.4vw, 9rem); }
  .ev-nome-medio { font-size: clamp(2.5rem, 5.8vw, 6.25rem); }
  .ev-nome-longo { font-size: clamp(2rem, 4.1vw, 4.5rem); line-height: 0.92; }
  .ev-em-pe .ev-nome-curto { font-size: clamp(3rem, 10.5vw, 11.5rem); }
  .ev-em-pe .ev-nome-medio { font-size: clamp(2.5rem, 7.2vw, 8rem); }
  .ev-em-pe .ev-nome-longo { font-size: clamp(2rem, 5vw, 5.5rem); }

  /* Data e hora num degrau da escala, local no degrau abaixo: a queda é gradual */
  .ev-quando { margin-top: var(--e-3); font-size: var(--t-4); font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
  .ev-local { display: flex; align-items: flex-start; margin-top: var(--e-1); font-size: var(--t-3); font-weight: 700; text-transform: uppercase; letter-spacing: 0; line-height: 1.15; }
  .ev-local svg { flex: none; width: 0.72em; height: 0.9em; margin: 0.1em 0.4em 0 0; fill: currentColor; }

  .ev :global(.ev-botao) { --botao-fundo: var(--fundo); --botao-texto: var(--texto); width: 100%; }

  /* A capa nítida sai um pouco para fora do bloco e fica levemente torta */
  .ev-capa { display: block; transform: rotate(2deg); transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ev-deitada .ev-capa { margin: -7% -9% -7% 0; }
  .ev-em-pe .ev-capa { margin: -12% -4% -12% 0; transform: rotate(3deg); }
  .ev-area:nth-of-type(even) .ev-capa { transform: rotate(-2deg); }
  .ev:hover .ev-capa { transform: rotate(0) scale(1.03); }
  .ev-capa img { transition: transform 0.35s ease-out; width: 100%; height: auto; border-radius: clamp(0.5rem, 1vw, 0.9rem); box-shadow: 0 2rem 4rem -1.5rem rgb(0 0 0 / 0.55); }
  .ev-sem-capa { display: grid; place-items: center; aspect-ratio: 16 / 9; background: var(--fundo); color: var(--destaque); border-radius: clamp(0.5rem, 1vw, 0.9rem); }
  .ev-sem-capa :global(svg) { width: 22%; }
  @media (prefers-reduced-motion: reduce) { .ev-capa { transition: none; } }

  @media (max-width: 820px) {
    .ev-deitada, .ev-em-pe { grid-template-columns: 1fr; }
    .ev-capa { order: -1; }
    .ev-deitada .ev-capa { margin: -2.25rem -0.5rem 0; }
    .ev-em-pe .ev-capa { margin: -2.25rem 12% 0; }
  }
</style>
