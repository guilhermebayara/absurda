---
// Abertura da Home: o logo com ecos em fatias acima e abaixo.
// As fatias abrem ao carregar e fecham conforme a pessoa rola a página.
// As cores das fatias saem do tema do momento.
import Completo from './marca/Completo.astro';
const fatias = [
  { y: -30, corte: '0 0 78% 0', nivel: 1 },
  { y: -52, corte: '0 0 86% 0', nivel: 2 },
  { y: -68, corte: '0 0 92% 0', nivel: 3 },
  { y: 30, corte: '78% 0 0 0', nivel: 1 },
  { y: 52, corte: '86% 0 0 0', nivel: 2 },
  { y: 68, corte: '92% 0 0 0', nivel: 3 },
];
---
<div class="eco" data-eco>
  {fatias.map((f) => (
    <div class={`eco-fatia eco-n${f.nivel}`} aria-hidden="true">
      <div class="eco-corte" style={`--y:${f.y}%;--corte:inset(${f.corte})`}><Completo /></div>
    </div>
  ))}
  <h1 class="eco-marca"><Completo titulo="@bsurda" /></h1>
</div>

<script>
  const eco = document.querySelector<HTMLElement>('[data-eco]');
  if (eco) {
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (calmo) {
      eco.style.setProperty('--abre', '1');
    } else {
      // Abre uma vez ao carregar.
      requestAnimationFrame(() => eco.classList.add('eco-pronto'));
      // Depois acompanha a rolagem: fecha enquanto o logo sai da tela.
      let solto = false;
      setTimeout(() => { solto = true; atualizar(); }, 1300);
      const atualizar = () => {
        if (!solto) return;
        const r = eco.getBoundingClientRect();
        const avanco = Math.min(1, Math.max(0, -r.top / (r.height * 0.9) + 0.12));
        eco.classList.add('eco-rolando');
        eco.style.setProperty('--abre', String(1 - avanco));
      };
      window.addEventListener('scroll', atualizar, { passive: true });
    }
  }
</script>

<style>
  @property --abre { syntax: '<number>'; inherits: true; initial-value: 0; }
  .eco { position: relative; --abre: 0; padding: 11.5% 0; transition: --abre 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s; }
  .eco.eco-pronto { --abre: 1; }
  .eco.eco-rolando { transition: none; }
  .eco-marca { margin: 0; position: relative; }
  .eco :global(svg) { width: 100%; height: auto; }
  .eco-fatia { position: absolute; inset: 0; padding: 11.5% 0; pointer-events: none; }
  .eco-corte { clip-path: var(--corte); transform: translateY(calc(var(--y) * var(--abre))); opacity: var(--abre); }
  .eco-n1 { color: var(--destaque); }
  .eco-n2 { color: color-mix(in srgb, var(--destaque) 62%, var(--fundo)); }
  .eco-n3 { color: color-mix(in srgb, var(--destaque) 30%, var(--fundo)); }
</style>
