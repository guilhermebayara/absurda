---
// Abertura da Home: o logo com ecos em fatias.
// Em telas largas usa o logo em uma linha, com ecos acima e abaixo.
// No celular usa o logo em sílabas, bem maior, com ecos para os dois lados.
// As fatias abrem ao carregar e fecham conforme a pessoa rola a página.
// O logo da frente é sempre o mais forte; os ecos repetem a cor, cada vez mais fraca.
import Completo from './marca/Completo.astro';
import Silabas from './marca/Silabas.astro';

// Cada fatia: deslocamento vertical, trecho do logo que aparece e escala.
// As mais distantes são mais finas e menores, o que dá a profundidade.
const largo = [
  { y: -35, corte: '0 0 74% 0', escala: 0.93, nivel: 1 },
  { y: -61, corte: '0 0 84% 0', escala: 0.85, nivel: 2 },
  { y: -82, corte: '0 0 91% 0', escala: 0.77, nivel: 3 },
  { y: 35, corte: '74% 0 0 0', escala: 0.93, nivel: 1 },
  { y: 61, corte: '84% 0 0 0', escala: 0.85, nivel: 2 },
  { y: 82, corte: '91% 0 0 0', escala: 0.77, nivel: 3 },
];
// No logo em sílabas os ecos saem pelas duas laterais e seguem o contorno da marca:
// cada linha ("@B", "SUR", "DA") ecoa a partir da sua própria letra da ponta.
//
// O modelo é uma pilha: atrás do logo há cópias inteiras dele, cada uma menor
// (reduzida em direção ao centro, com um único ponto de fuga) e mais deslocada
// para o lado. De cada cópia só aparece o pedaço que sobra para fora da camada
// da frente, com um vão constante entre as camadas. O mesmo vale, espelhado,
// para o outro lado.
//
// Medidas em porcentagem do logo: onde cada linha começa, termina e sua faixa de altura.
const linhas = [
  { esq: 0, dir: 70.5, topo: 0, base: 32.65 },
  { esq: 11.75, dir: 100, topo: 32.65, base: 68.35 },
  { esq: 13.64, dir: 79.23, topo: 68.35, base: 100 },
];
const camadas = [
  { escala: 0.93, x: 19.5, nivel: 1 },
  { escala: 0.85, x: 34.5, nivel: 2 },
  { escala: 0.77, x: 46.5, nivel: 3 },
];
const vao = 3;
const n = (v: number) => Number(v.toFixed(2));
// Onde um ponto do logo vai parar na cópia de uma camada (redução em torno do centro).
const reduz = (v: number, escala: number) => 50 + (v - 50) * escala;

function ecos(lado: 'dir' | 'esq') {
  const sinal = lado === 'dir' ? 1 : -1;
  // Ponta de cada linha na camada da frente; começa no próprio logo.
  let frente = linhas.map((r) => r[lado]);
  return camadas.map((c) => {
    const ponta = linhas.map((r) => reduz(r[lado], c.escala) + sinal * c.x);
    // Janela em degraus: do vão depois da camada da frente até a ponta desta cópia.
    const perto = frente.map((x) => x + sinal * vao);
    const altura = linhas.map((r) => [reduz(r.topo, c.escala), reduz(r.base, c.escala)]);
    const ida = linhas.flatMap((_, i) => [`${n(ponta[i])}% ${n(altura[i][0])}%`, `${n(ponta[i])}% ${n(altura[i][1])}%`]);
    const volta = linhas.flatMap((_, i) => [`${n(perto[i])}% ${n(altura[i][0])}%`, `${n(perto[i])}% ${n(altura[i][1])}%`]).reverse();
    frente = ponta;
    return { ...c, x: sinal * c.x, janela: `polygon(${[...ida, ...volta].join(', ')})` };
  });
}
const alto = [...ecos('dir'), ...ecos('esq')];
---
<h1 class="so-leitor">@bsurda</h1>

<div class="eco eco-largo" data-eco aria-hidden="true">
  {largo.map((f) => (
    <div class={`eco-fatia eco-n${f.nivel}`}>
      <div class="eco-corte" style={`--y:${f.y}%;--corte:inset(${f.corte});--escala:${f.escala}`}><Completo /></div>
    </div>
  ))}
  <div class="eco-marca"><Completo /></div>
</div>

<div class="eco eco-alto" data-eco aria-hidden="true">
  {alto.map((f) => (
    <div class={`eco-fatia eco-n${f.nivel}`} style={`--janela:${f.janela}`}>
      <div class="eco-corte" style={`--x:${f.x}%;--escala:${f.escala}`}><Silabas /></div>
    </div>
  ))}
  <div class="eco-marca"><Silabas /></div>
</div>

<script>
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.eco[data-eco]').forEach((eco) => {
    if (calmo) {
      eco.style.setProperty('--abre', '1');
      return;
    }
    // Abre uma vez ao carregar.
    requestAnimationFrame(() => eco.classList.add('eco-pronto'));
    // Depois acompanha a rolagem: fecha enquanto o logo sai da tela.
    let solto = false;
    const atualizar = () => {
      if (!solto || eco.offsetParent === null) return;
      const r = eco.getBoundingClientRect();
      const avanco = Math.min(1, Math.max(0, -r.top / (r.height * 0.9) + 0.12));
      eco.classList.add('eco-rolando');
      eco.style.setProperty('--abre', String(1 - avanco));
    };
    setTimeout(() => { solto = true; atualizar(); }, 1500);
    window.addEventListener('scroll', atualizar, { passive: true });
  });
</script>

<style>
  @property --abre { syntax: '<number>'; inherits: true; initial-value: 0; }
  /* A abertura é uma animação, e não uma transição: com a página em cache o Safari aplicava a
     classe antes do primeiro desenho, a transição não tinha de onde partir e os ecos já nasciam
     abertos. A animação parte sempre do 0 declarado nela. */
  .eco { position: relative; --abre: 0; }
  .eco.eco-pronto { --abre: 1; animation: eco-logo-abre 0.95s cubic-bezier(0.62, 0.05, 0.01, 0.99) 0.35s both; }
  /* Com a rolagem no comando, sai a animação, para o valor posto pelo script valer. */
  .eco.eco-pronto.eco-rolando { animation: none; }
  @keyframes eco-logo-abre { from { --abre: 0; } to { --abre: 1; } }
  .eco :global(svg) { width: 100%; height: auto; }
  .eco-marca { position: relative; transform-origin: 50% 50%; }
  .eco-fatia { position: absolute; inset: 0; pointer-events: none; }
  .eco-corte { clip-path: var(--corte); transform: translateY(calc(var(--y) * var(--abre))) scale(calc(1 - (1 - var(--escala)) * var(--abre))); opacity: var(--abre); }

  /* Logo em uma linha: ecos acima e abaixo */
  .eco-largo, .eco-largo .eco-fatia { padding: 13.5% 0; }
  /* Logo em sílabas (celular): ecos para os dois lados, podendo sair da tela.
     A janela (recorte) fica parada no lugar; a cópia do logo desliza por trás dela. */
  .eco-alto { display: none; width: min(62%, 19rem); margin: 5vw auto 9vw; }
  .eco-alto .eco-fatia { clip-path: var(--janela); }
  .eco-alto .eco-corte { clip-path: none; transform: translateX(calc(var(--x) * var(--abre))) scale(calc(1 - (1 - var(--escala)) * var(--abre))); }
  @media (max-width: 700px) {
    .eco-largo { display: none; }
    .eco-alto { display: block; }
  }

  .eco-n1 { color: color-mix(in oklab, var(--texto) 58%, var(--fundo)); }
  .eco-n2 { color: color-mix(in oklab, var(--texto) 34%, var(--fundo)); }
  .eco-n3 { color: color-mix(in oklab, var(--texto) 17%, var(--fundo)); }

  /* Entrada: o logo cresce do centro enquanto os ecos se abrem. */
  :global(.js) .eco-marca { animation: logo-entra 1s cubic-bezier(0.62, 0.05, 0.01, 0.99) both; }
  @keyframes logo-entra { from { transform: scale(0.55); opacity: 0; } 40% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(.js) .eco-marca { animation: none; } }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
