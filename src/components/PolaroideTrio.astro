---
import { foto as fotoMenor } from '../lib/imagens';

interface Props {
  ano: string;
  numero: string;
  texto: string;
  foto: string;
  foco?: string;
  arte?: boolean;
  ativa?: boolean;
}
const { ano, numero, texto, foto, foco, arte, ativa } = Astro.props;
---
<li class:list={['trio-quadro', { ativo: ativa, arte: arte }]} data-ano={ano} data-mini={foto.replace('.jpg', '-mini.jpg')} style={arte ? `--arte:url(${foto})` : undefined}>
  <img {...fotoMenor(foto, undefined, { ate2x: true })} alt="" loading="lazy" style={foco ? `object-position:${foco}` : undefined} />
  <div class="trio-legenda">
    <p class="trio-ano">{ano}</p>
    <p class="trio-numero">{numero}</p>
    <p class="trio-texto">{texto}</p>
  </div>
</li>

<style>
  .trio-quadro { position: relative; }
  .trio-quadro img { width: 100%; height: 100%; object-fit: cover; }
  /* Quando o quadro é a arte do evento (e não uma foto), ela aparece inteira no centro,
     sobre uma versão desfocada dela mesma que enche a tela: sem faixas pretas. */
  .trio-quadro.arte { overflow: hidden; }
  .trio-quadro.arte::before { content: ''; position: absolute; inset: -8%; background: var(--arte) center / cover; filter: blur(2.5rem) brightness(0.55) saturate(1.2); }
  .trio-quadro.arte img { position: relative; object-fit: contain; padding: 14svh var(--margem) 30svh; }
  .trio-legenda { position: absolute; left: 0; right: 0; bottom: 0; padding: 30svh var(--margem) var(--e-4); background: linear-gradient(to top, rgb(13 10 12 / 0.92), rgb(13 10 12 / 0.55) 45%, transparent); }
  /* Ordem de leitura do quadro: o número, o ano logo acima dele, o título da seção e, por
     último, a regra do domingo, que é nota de rodapé e fica em corpo de rótulo. */
  .trio-ano { margin-bottom: 0.08em; font-size: clamp(2rem, 4.6vw, 4.25rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; }
  .trio-numero { font-size: clamp(4rem, 17vw, 16rem); font-weight: 800; line-height: 0.82; letter-spacing: -0.06em; text-transform: uppercase; }
  .trio-texto { max-width: 30em; margin-top: var(--e-2); font-size: var(--t-apoio); line-height: 1.35; }
  .trio-quadro { height: 100svh; }
  :global(.js) .trio-quadro { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s ease; }
  :global(.js) .trio-quadro.ativo { opacity: 1; }
  :global(.js) .trio-quadro img { transform: scale(calc(1.02 + var(--avanco, 0) * 0.08)); }
  :global(.js) .trio-quadro .trio-legenda > * { transform: translateY(1.5rem); opacity: 0; transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s, opacity 0.6s ease 0.1s; }
  :global(.js) .trio-quadro.ativo .trio-legenda > * { transform: none; opacity: 1; }

  @media (max-width: 820px) { .trio-legenda { padding-top: 20svh; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .trio-quadro, :global(.js) .trio-quadro .trio-legenda > * { transition: none; }
    :global(.js) .trio-quadro img { transform: none; }
  }
  :global(html:is(.pino-novo, .toque)) .trio-quadro { position: relative; inset: auto; height: auto; opacity: 1; overflow: hidden; border-radius: 0.3rem; background: #f3f0e8; color: #1c1619; outline: 1px solid rgb(0 0 0 / 0.12); outline-offset: -1px; transition: none; }
  :global(html:is(.pino-novo, .toque)) .trio-quadro img { display: block; width: calc(100% - 2 * var(--margem-foto)); height: auto; margin: var(--margem-foto) var(--margem-foto) 0; aspect-ratio: 1; border-radius: 0.1rem; transform: none; }
  :global(html:is(.pino-novo, .toque)) .trio-quadro .trio-legenda { position: static; padding: 0.85rem calc(var(--margem-foto) + 0.25rem) 1rem; background: none; }
  :global(html:is(.pino-novo, .toque)) .trio-quadro .trio-legenda > * { transform: none; opacity: 1; transition: none; }
  :global(html:is(.pino-novo, .toque)) .trio-ano { margin-bottom: 0.1em; color: #5f565b; font-size: 1.25rem; letter-spacing: -0.02em; }
  :global(html:is(.pino-novo, .toque)) .trio-numero { font-size: min(12vw, 2.75rem); line-height: 0.9; letter-spacing: -0.05em; }
  :global(html:is(.pino-novo, .toque)) .trio-texto { margin-top: 0.5rem; color: #2b2428; font-size: 0.9375rem; line-height: 1.35; }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.pino-novo) .trio-quadro { grid-area: 1 / 1; height: var(--alt-cartao); transform-origin: 50% 0; }
    /* Quanto mais fundo na pilha, mais escuro: uma camada preta por cima, e não sombra (custo no Safari). */
    :global(html.pino-novo) .trio-quadro::after { content: ''; position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
    :global(html.pino-novo) .trio-quadro.por-baixo .trio-texto { visibility: hidden; }
    :global(html.pino-novo) .trio-quadro.longe { visibility: hidden; }
  }
</style>
