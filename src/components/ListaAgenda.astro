---
interface Props {
  para: string;
  nome: string;
  textos: string[];
  indice: number;
}
const { para, nome, textos, indice } = Astro.props;
---
<li class:list={['lista', { 'lista-b': indice % 2 === 1 }]} data-anima="surge" style={`--i:${indice}`}>
  <p class="lista-para">{para}</p>
  <h3 class="lista-nome">{nome}</h3>
  <div class="lista-texto">{textos.map((t) => <p>{t}</p>)}</div>
</li>

<style>
  .lista { --l-fundo: var(--vivo); --l-texto: var(--sobre-vivo); display: grid; grid-template-rows: auto auto 1fr; gap: var(--e-2); padding: clamp(1.25rem, 2.4vw, 2rem); border-radius: var(--raio-cartao, 1.5rem); background: var(--l-fundo); color: var(--l-texto); container-type: inline-size; }
  .lista-b { --l-fundo: var(--texto); --l-texto: var(--fundo); }
  .lista-para { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .lista-nome { font-size: 10.5cqw; font-weight: 800; line-height: 0.88; letter-spacing: -0.045em; text-transform: uppercase; }
  .lista-texto { align-self: end; display: grid; gap: 0.75em; margin-top: var(--e-2); padding-top: 0.9rem; border-top: 2px solid var(--l-texto); font-size: 1.0625rem; line-height: 1.4; }
</style>
