---
// Imagem de capa. Sem imagem, mostra um bloco de marcação com o símbolo.
import Arroba from './marca/Arroba.astro';
import CreditoFoto from './CreditoFoto.astro';
import { foto } from '../lib/imagens';
// Com "inteira", a imagem aparece na proporção original, sem corte
// (as artes dos eventos têm texto que não pode ser cortado).
// Com "credito", a mini tag de crédito aparece sobre a foto (ver CreditoFoto.astro).
// "tamanho" é o sizes da foto: quanto ela ocupa na tela (ver src/lib/imagens.ts).
// Com "ate2x", a foto é pedida como num celular de 2x mesmo numa tela de 3x (ver src/lib/imagens.ts).
interface Props { src?: string; alt?: string; proporcao?: string; inteira?: boolean; credito?: string; tamanho?: string; ate2x?: boolean; class?: string }
const { src, alt = '', proporcao = '4 / 5', inteira = false, credito, tamanho = '(max-width: 720px) 90vw, 28rem', ate2x = false, class: classe } = Astro.props;
---
<div class:list={['capa', classe, { 'capa-inteira': inteira && src }]} style={inteira && src ? undefined : `aspect-ratio:${proporcao}`}>
  {src
    ? <span class="capa-img"><img {...foto(src, tamanho, { ate2x })} alt={alt} loading="lazy" /></span>
    : <Arroba class="capa-simbolo" />}
  {src && credito && <CreditoFoto credito={credito} />}
</div>

<style>
  /* Moldura recorta a imagem; a mini tag fica fora do overflow para expandir o crédito. */
  .capa { position: relative; container-type: inline-size; border-radius: clamp(0.6rem, 1.2vw, 1rem); background: color-mix(in srgb, var(--texto) 14%, var(--fundo)); display: grid; place-items: center; }
  .capa-img { display: block; width: 100%; height: 100%; overflow: hidden; border-radius: inherit; }
  .capa img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .capa-inteira .capa-img { height: auto; }
  .capa-inteira img { height: auto; object-fit: contain; }
  .capa :global(.capa-simbolo) { height: 42%; width: auto; color: var(--destaque); opacity: 0.9; }
</style>
