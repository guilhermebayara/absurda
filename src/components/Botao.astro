---
// Botão do site: um bloco de cantos arredondados, na mesma família dos blocos
// de evento, com a seta numa peça própria. Ao passar o mouse, a seta sai por
// um lado e entra pelo outro, e a peça acende na cor de destaque.
interface Props {
  href: string;
  // Link que sai do site: abre em outra aba e a seta aponta para fora (diagonal).
  externo?: boolean;
  // "cheio" é o principal; "linha" é o secundário.
  tipo?: 'cheio' | 'linha';
  class?: string;
  [atributo: string]: unknown;
}
const { href, externo = false, tipo = 'cheio', class: classe, ...resto } = Astro.props;
const seta = externo ? 'M4.5 3.5h8v8M12.5 3.5 3.5 12.5' : 'M2.5 8h11M9 3.5 13.5 8 9 12.5';
---
<a class:list={['bt', `bt-${tipo}`, { 'bt-externo': externo }, classe]} href={href} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined} {...resto}>
  <span class="bt-rotulo"><slot />{externo && <span class="so-leitor"> (abre em outra aba)</span>}</span>
  <span class="bt-seta" aria-hidden="true">
    <svg viewBox="0 0 16 16"><path d={seta} /></svg>
    <svg viewBox="0 0 16 16"><path d={seta} /></svg>
  </span>
</a>

<style>
  .bt { --b-fundo: var(--botao-fundo, var(--texto)); --b-texto: var(--botao-texto, var(--fundo)); --b-destaque: var(--botao-destaque, var(--destaque));
    display: inline-flex; align-items: center; gap: 1.1em; padding: 0.5em 0.5em 0.5em 1.5em; border-radius: 1.15em; background: var(--b-fundo); color: var(--b-texto);
    font-size: clamp(0.8125rem, 1.05vw, 0.9375rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; line-height: 1.15; text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  .bt-linha { background: transparent; color: var(--b-fundo); box-shadow: inset 0 0 0 1.5px var(--b-fundo); }

  .bt-seta { position: relative; flex: none; width: 2.9em; height: 2.9em; border-radius: 0.78em; overflow: hidden; background: var(--b-texto); color: var(--b-fundo); transition: background-color 0.3s, color 0.3s; }
  .bt-linha .bt-seta { background: var(--b-fundo); color: var(--b-texto); }
  .bt-seta svg { position: absolute; inset: 0; margin: auto; width: 1.05em; height: 1.05em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.5s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  /* A segunda seta espera fora da peça, do lado de onde a primeira vai sair */
  .bt-seta svg + svg { transform: translate(-260%, 0); }
  .bt-externo .bt-seta svg + svg { transform: translate(-260%, 260%); }

  .bt:hover .bt-seta, .bt:focus-visible .bt-seta { background: var(--b-destaque); color: var(--b-fundo); }
  .bt-linha:hover .bt-seta, .bt-linha:focus-visible .bt-seta { color: var(--b-texto); }
  .bt:hover .bt-seta svg, .bt:focus-visible .bt-seta svg { transform: translate(260%, 0); }
  .bt-externo:hover .bt-seta svg, .bt-externo:focus-visible .bt-seta svg { transform: translate(260%, -260%); }
  .bt:hover .bt-seta svg + svg, .bt:focus-visible .bt-seta svg + svg { transform: translate(0, 0); }
  .bt:active { transform: scale(0.97); }
  @media (prefers-reduced-motion: reduce) { .bt, .bt-seta svg { transition: none; } }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
