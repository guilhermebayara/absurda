---
import type { Evento } from '../lib/eventos';
import { formatarData } from '../lib/eventos';
interface Props { evento: Evento; passado?: boolean }
const { evento, passado = false } = Astro.props;
---
{passado ? (
  <div class="card">
    <div class="img">{evento.capa ? <img src={evento.capa} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover" /> : 'capa'}</div>
    <span class="etiqueta">{formatarData(evento.data)}</span>
    <h3>{evento.nome}</h3>
    {evento.local && <p>{evento.local}</p>}
  </div>
) : (
  <a class="card" href={evento.url} target="_blank" rel="noopener">
    <div class="img">{evento.capa ? <img src={evento.capa} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover" /> : 'capa'}</div>
    <span class="etiqueta">{formatarData(evento.data)}</span>
    <h3>{evento.nome}</h3>
    {evento.local && <p>{evento.local}</p>}
    <p>Ingressos ↗</p>
  </a>
)}
