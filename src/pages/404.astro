---
// Página de erro: aparece em qualquer endereço que não existe (ver wrangler.jsonc).
import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
---
<Base titulo="Página não encontrada" semIndice>
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Sumiu">Sumiu</h1>
    <p class="t-apoio">Esta página não existe ou mudou de endereço.</p>
  </header>
  <div class="conteudo">
    <p><Botao href="/agenda">Ver a agenda</Botao></p>
    <p><Botao href="/" tipo="linha">Voltar ao início</Botao></p>
  </div>
</Base>
