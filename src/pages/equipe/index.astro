---
// Página Equipe.
//
// Três blocos, cada um com um desenho próprio:
// 1. O Ed, fundador, abre a página com um crachá maior e as cores da foto dele. O bloco é
//    baixo de propósito: a equipe de hoje já aparece na primeira tela.
// 2. Quem faz hoje aparece em crachás, como os de produção que a equipe usa nas festas.
//    Sem foto, o crachá mostra a inicial do nome em tamanho de cartaz.
// 3. Quem trabalha fora da cabine (foto e vídeo, bar, som e luz) entra em pulseiras de acesso.
//    São parceiros recorrentes, não equipe fixa, e não têm página própria.
// 4. Quem já fez parte entra como line-up, no mesmo desenho das listas do Sobre. Com foto
//    cadastrada, ela aparece ao passar o cursor.
//
// Os textos marcados "(marcação)" ou "(a confirmar)" precisam passar por Gui e Ed.
import Base from '../../layouts/Base.astro';
import Botao from '../../components/Botao.astro';
import Arroba from '../../components/marca/Arroba.astro';
import { getCollection } from 'astro:content';
import { atributo, TEMAS_DO_SITE } from '../../lib/temas';
import { temaDaPessoa } from '../../lib/pessoas';
import { idade } from '../../lib/historia';

const reserva = atributo(TEMAS_DO_SITE[0]);
const pessoas = (await getCollection('pessoas')).sort((a, b) => a.data.ordem - b.data.ordem);
const atuais = pessoas.filter((p) => p.data.situacao === 'atual');
const anteriores = pessoas.filter((p) => p.data.situacao === 'anterior');

// O fundador sai da grade e ganha o bloco de abertura.
const fundador = atuais.find((p) => p.id === 'ed-luiz');
const time = atuais.filter((p) => p.id !== fundador?.id);
const temaFundador = fundador ? await temaDaPessoa(fundador.id, fundador.data.foto) : undefined;

// O que cada crachá libera. Brincadeira com o crachá de produção.
const acesso = { socios: 'Acesso total', residentes: 'Cabine', equipe: 'Produção' } as const;

// Fora da cabine: parceiros recorrentes, por área. "nota" explica quem é quem num coletivo.
const foraDaCabine = [
  { area: 'Foto e vídeo', nomes: [{ nome: 'Estilingue', nota: 'Lugh na foto, Robert no vídeo' }, { nome: 'Felipe César' }, { nome: 'Yuri' }] },
  { area: 'Bar', nomes: [{ nome: 'Jaci' }] },
  { area: 'Som e luz', nomes: [{ nome: 'Léo' }] },
];
---
<Base titulo="Equipe">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Equipe">Equipe</h1>
    <p class="t-apoio">Quem faz a @bsurda, na cabine e fora dela.</p>
  </header>

  {fundador && temaFundador && (
    <section class="fundador" aria-labelledby="t-fundador" data-tema={atributo(temaFundador)}>
      <a class="cracha cracha-grande" href={`/equipe/${fundador.id}`} tabindex="-1" aria-hidden="true">
        <span class="cracha-furo"></span>
        <span class="cracha-topo"><Arroba class="cracha-marca" /><span>Desde 2009</span></span>
        <span class="cracha-retrato"><img src={fundador.data.foto} alt="" /></span>
        <span class="cracha-texto">
          <strong class="cracha-nome">{fundador.data.nome}</strong>
          <span class="cracha-funcao">{fundador.data.funcao}</span>
        </span>
        <span class="cracha-acesso"><span>Acesso</span><strong>Total</strong></span>
      </a>
      <div class="fundador-texto">
        <p class="titulo-secao" data-anima="sobe">Fundador, produtor e DJ</p>
        <h2 id="t-fundador" class="t-secao" data-anima="sobe">{fundador.data.nome}</h2>
        <p class="t-apoio" data-anima="surge">Em 2009 o Ed quis uma festa que juntasse a pista do rock e a do pop. Criou a @bsurda e segue na produção e na cabine. (marcação)</p>
        <div class="fundador-rodape" data-anima="surge">
          <ul class="fundador-dados">
            <li><strong>{idade}</strong><span>anos de @bsurda</span></li>
            <li><strong>2019</strong><span>Melhor DJ do carnaval, BH Folia (a confirmar)</span></li>
          </ul>
          <p><Botao href={`/equipe/${fundador.id}`} tipo="linha">Página do Ed</Botao></p>
        </div>
      </div>
    </section>
  )}

  <section class="time" aria-labelledby="t-time" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-time" class="t-secao" data-anima="sobe">Quem faz hoje</h2>
    <ul class="crachas">
      {time.map((p, i) => (
        <li data-anima="surge" style={`--i:${i}`}>
          <a class="cracha" href={`/equipe/${p.id}`}>
            <span class="cracha-furo" aria-hidden="true"></span>
            <span class="cracha-topo" aria-hidden="true"><Arroba class="cracha-marca" /><span>Equipe</span></span>
            <span class="cracha-retrato" aria-hidden="true">
              {p.data.foto ? <img src={p.data.foto} alt="" loading="lazy" /> : <span class="cracha-inicial">{p.data.nome[0]}</span>}
            </span>
            <span class="cracha-texto">
              <strong class="cracha-nome">{p.data.nome}</strong>
              <span class="cracha-funcao">{p.data.funcao}</span>
            </span>
            <span class="cracha-acesso"><span>Acesso</span><strong>{acesso[p.data.grupo]}</strong></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="fora" aria-labelledby="t-fora">
    <h2 id="t-fora" class="t-secao" data-anima="sobe">Fora da cabine</h2>
    <p class="t-apoio fora-texto" data-anima="surge">Parceiros que voltam festa após festa. Sem eles não tem foto, não tem bar, não tem som.</p>
    <div class="areas">
      {foraDaCabine.map((g) => (
        <div class="area" data-anima="surge">
          <h3 class="titulo-secao">{g.area}</h3>
          <ul class="pulseiras">
            {g.nomes.map((n) => (
              <li class="pulseira">
                <span class="pulseira-ponta" aria-hidden="true"><Arroba class="pulseira-marca" /></span>
                <span class="pulseira-texto"><strong>{n.nome}</strong>{n.nota && <span>{n.nota}</span>}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {anteriores.length > 0 && (
    <section class="passado" aria-labelledby="t-passado">
      <h2 id="t-passado" class="titulo-secao" data-anima="sobe">Já passaram pela cabine</h2>
      <p class="nomes" data-anima="surge">
        {anteriores.map((p) => <a href={`/equipe/${p.id}`}>{p.data.nome}{p.data.foto && <img class="previa" src={p.data.foto} alt="" loading="lazy" />}</a>)}
      </p>
      <p class="t-pequeno passado-nota">Lista em construção. (a confirmar)</p>
      <p class="passado-botao" data-anima="surge"><Botao href="/sobre#t-palco" tipo="linha">A cena que já tocou com a gente</Botao></p>
    </section>
  )}
</Base>

<style>
  /* Abertura mais baixa que nas outras páginas, para o Ed e o começo da equipe caberem na primeira tela. */
  .abre.abre-cima { padding-top: clamp(2.5rem, 3.4vw, 3rem); padding-bottom: var(--e-3); }
  .abre .t-apoio { margin-top: var(--e-2); }
  /* Título de seção, igual ao do Sobre. */
  .t-secao { font-size: clamp(2.75rem, 9.5vw, 8.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }

  /* 1. Fundador. Crachá deitado e maior que os outros, com o nome em destaque; o texto dele ao lado.
     Bloco baixo: a equipe aparece logo abaixo. */
  .fundador { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding: var(--e-3) var(--margem) var(--e-3); }
  .fundador .cracha-grande { width: clamp(22rem, 34vw, 31rem); height: auto; grid-template-columns: 42% minmax(0, 1fr); grid-template-rows: auto 1fr auto; column-gap: clamp(1rem, 1.6vw, 1.5rem); padding: 0.9rem 1.25rem 0.9rem 0.9rem; transform: rotate(-1.6deg); }
  .fundador .cracha-grande:hover { transform: rotate(0deg) translateY(-0.4rem); }
  .fundador .cracha-grande .cracha-furo { display: none; }
  .fundador .cracha-grande .cracha-retrato { grid-column: 1; grid-row: 1 / -1; margin-top: 0; aspect-ratio: 4 / 5; }
  .fundador .cracha-grande .cracha-retrato img { object-position: 50% 22%; }
  .fundador .cracha-grande .cracha-topo { grid-column: 2; margin-top: 0.2rem; }
  .fundador .cracha-grande .cracha-texto { grid-column: 2; align-self: center; margin-top: 0.5rem; }
  .fundador .cracha-grande .cracha-nome { font-size: clamp(2rem, 3.6vw, 3.5rem); }
  .fundador .cracha-grande .cracha-acesso { grid-column: 2; margin-top: 0.6rem; }
  /* O nome já está no crachá; o título fica só para leitores de tela. */
  .fundador-texto .t-secao { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .fundador-texto .titulo-secao { margin-bottom: var(--e-2); color: var(--destaque-texto, var(--destaque)); }
  .fundador-texto .t-apoio { max-width: 38em; }
  /* Números e botão na mesma linha, para o bloco ficar baixo. */
  .fundador-rodape { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--e-3) var(--e-5); margin-top: var(--e-3); }
  .fundador-dados { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--e-3) var(--e-5); }
  .fundador-dados li { display: grid; gap: 0.35em; max-width: 12rem; }
  .fundador-dados strong { font-size: var(--t-5); font-weight: 800; line-height: 0.85; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .fundador-dados span { font-size: 0.9375rem; line-height: 1.25; color: var(--suave); }

  /* 2. Quem faz hoje: crachás. Superfície invertida (cor do texto), detalhes na cor de enfeite. */
  .time { padding: var(--e-3) var(--margem) var(--e-6); }
  .crachas { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); margin-top: var(--e-4); }
  .cracha { display: grid; grid-template-rows: auto auto 1fr auto auto; height: 100%; padding: 0.9rem 0.9rem 1rem; border-radius: clamp(1rem, 1.8vw, 1.5rem); background: var(--texto); color: var(--fundo); text-decoration: none; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  /* Pendurados, cada um cai de um jeito. */
  .crachas li:nth-child(odd) .cracha { transform: rotate(-1.6deg); }
  .crachas li:nth-child(even) .cracha { transform: rotate(1.2deg) translateY(0.5rem); }
  .crachas li:nth-child(3n) .cracha { transform: rotate(2.1deg); }
  .crachas li .cracha:hover, .crachas li .cracha:focus-visible { transform: rotate(0deg) translateY(-0.4rem); }
  .cracha-furo { justify-self: center; width: 2.75rem; height: 0.6rem; border-radius: 1rem; background: var(--fundo); }
  .cracha-topo { display: flex; align-items: center; justify-content: space-between; margin-top: 0.8rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .cracha-topo :global(.cracha-marca) { height: 1.5rem; width: auto; color: var(--enfeite); }
  .cracha-retrato { position: relative; display: block; overflow: hidden; margin-top: 0.7rem; aspect-ratio: 1; border-radius: clamp(0.6rem, 1vw, 0.9rem); background: color-mix(in srgb, var(--fundo) 12%, var(--texto)); }
  .cracha-retrato img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cracha-inicial { position: absolute; left: -0.04em; bottom: -0.2em; font-size: clamp(11rem, 19vw, 17rem); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em; text-transform: uppercase; color: var(--enfeite); }
  .cracha-texto { display: grid; gap: 0.3rem; margin-top: 0.9rem; }
  .cracha-nome { font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 800; line-height: 0.92; letter-spacing: -0.03em; text-transform: uppercase; }
  .cracha-funcao { font-size: 0.9375rem; line-height: 1.25; }
  .cracha-acesso { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; margin-top: 1rem; padding-top: 0.7rem; border-top: 2px solid var(--fundo); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.16em; }
  .cracha-acesso span { font-weight: 500; }
  .cracha-acesso strong { font-weight: 800; }

  /* 3. Fora da cabine: pulseiras de acesso, uma por parceiro, agrupadas por área. */
  .fora { padding: var(--e-5) var(--margem) var(--e-6); }
  .fora-texto { max-width: 30em; margin-top: var(--e-2); }
  .areas { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: var(--e-4) clamp(1.5rem, 4vw, 4rem); align-items: start; margin-top: var(--e-4); }
  .area .titulo-secao { margin-bottom: var(--e-2); }
  .pulseiras { display: grid; gap: 0.6rem; }
  .pulseira { display: flex; align-items: stretch; min-height: 3.75rem; border-radius: 0.6rem 2rem 2rem 0.6rem; background: var(--texto); color: var(--fundo); overflow: hidden; }
  .pulseiras li:nth-child(odd) { transform: rotate(-0.7deg); }
  .pulseiras li:nth-child(even) { transform: rotate(0.6deg); }
  .pulseira-ponta { display: grid; place-items: center; flex: none; width: 3.5rem; border-right: 2px dashed var(--fundo); }
  .pulseira-ponta :global(.pulseira-marca) { height: 1.5rem; width: auto; color: var(--enfeite); }
  .pulseira-texto { display: grid; align-content: center; gap: 0.15rem; padding: 0.6rem 1.4rem 0.6rem 0.9rem; }
  .pulseira-texto strong { font-size: clamp(1.25rem, 1.8vw, 1.625rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
  .pulseira-texto span { font-size: 0.875rem; line-height: 1.25; }

  /* 4. Quem já fez parte: line-up, no desenho das listas do Sobre. */
  .passado { padding: var(--e-5) var(--margem) var(--e-6); }
  .nomes { display: flex; flex-wrap: wrap; gap: 0.2em 0; font-size: var(--t-5); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; text-transform: uppercase; }
  .nomes a { position: relative; display: inline-flex; align-items: flex-start; margin-right: 0.3em; text-decoration: none; }
  /* Foto de quem já passou, só com cursor: aparece acima do nome, levemente torta. */
  .previa { position: absolute; left: 1em; bottom: 100%; z-index: 2; width: clamp(9rem, 14vw, 13rem); aspect-ratio: 4 / 5; object-fit: cover; border-radius: 1rem; opacity: 0; transform: rotate(-3deg) translateY(0.5rem); pointer-events: none; transition: opacity 0.2s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @media (hover: hover) { .nomes a:hover .previa, .nomes a:focus-visible .previa { opacity: 1; transform: rotate(-3deg) translateY(-0.4rem); } }
  .nomes a::before { content: ''; flex: none; width: 0.14em; height: 0.72em; margin: 0.12em 0.4em 0 0.18em; background: var(--destaque); transform: skewX(26.5deg); }
  .nomes a:hover { text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.12em; }
  .passado-nota { margin-top: var(--e-2); }
  .passado-botao { margin-top: var(--e-4); }

  @media (max-width: 820px) {
    /* Ed no celular: crachá na largura da tela, texto abaixo. A função já está no crachá. */
    .fundador { grid-template-columns: 1fr; gap: var(--e-3); padding-top: var(--e-2); }
    .fundador .cracha-grande { width: auto; grid-template-columns: 8.5rem minmax(0, 1fr); padding: 0.75rem 1rem 0.75rem 0.75rem; transform: rotate(-1deg); }
    .fundador .cracha-grande .cracha-nome { font-size: 1.75rem; }
    .fundador-rodape { display: block; }
    .fundador-rodape > p { margin-top: var(--e-3); }
    .fundador-texto .titulo-secao { display: none; }
    /* No celular o crachá deita: retrato à esquerda, texto à direita, um por linha. */
    .crachas { grid-template-columns: 1fr; gap: 0.75rem; }
    .crachas .cracha { grid-template-columns: 5.75rem minmax(0, 1fr); grid-template-rows: auto 1fr auto; column-gap: 0.9rem; padding: 0.75rem 0.9rem 0.75rem 0.75rem; }
    .crachas li .cracha, .crachas li:nth-child(even) .cracha, .crachas li:nth-child(3n) .cracha { transform: none; }
    .crachas li:nth-child(odd) .cracha { transform: rotate(-0.8deg); }
    .crachas li:nth-child(even) .cracha { transform: rotate(0.7deg); }
    .crachas .cracha-furo { display: none; }
    .crachas .cracha-retrato { grid-column: 1; grid-row: 1 / -1; margin-top: 0; }
    .crachas .cracha-inicial { font-size: 7.5rem; }
    .crachas .cracha-topo { grid-column: 2; margin-top: 0.1rem; }
    .crachas .cracha-texto { grid-column: 2; align-self: center; margin-top: 0.5rem; }
    .crachas .cracha-acesso { grid-column: 2; margin-top: 0.6rem; padding-top: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cracha, .previa { transition: none; } }
</style>
