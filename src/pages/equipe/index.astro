---
// Página Equipe.
//
// Três blocos:
// 1. Quem faz hoje, em crachás de produção, espalhados como numa mesa de produção antes da
//    festa, uns por cima dos outros. Só os crachás: fita e pilha em branco foram testadas e
//    saíram, a disposição dá conta sozinha. Duas cores: produção (Ed e Gui) e cabine (residentes). O do Ed é maior e leva
//    o selo "Fundador", que só ele tem. Tudo cabe numa tela, com o crachá sempre 5 por 7.
//    No celular todos têm o mesmo tamanho e ficam em fila, para arrastar de lado.
//    Com cursor, o crachá vira e mostra desde quando a pessoa está na festa.
// 2. Quem já fez parte, como line-up: os nomes separam os dois blocos mais visuais.
//    Com foto cadastrada, ela aparece ao passar o cursor.
// 3. Fora da cabine: parceiros recorrentes (foto e vídeo, bar, som e luz), em pulseiras de
//    acesso. Não têm página própria; quando houver link (perfil, site), a pulseira leva até ele.
//
// Os textos marcados "(marcação)" ou "(a confirmar)" precisam passar por Gui e Ed.
import Base from '../../layouts/Base.astro';
import Botao from '../../components/Botao.astro';
import Cracha from '../../components/Cracha.astro';
import Arroba from '../../components/marca/Arroba.astro';
import { getCollection } from 'astro:content';

const pessoas = (await getCollection('pessoas')).sort((a, b) => a.data.ordem - b.data.ordem);
const atuais = pessoas.filter((p) => p.data.situacao === 'atual');
// Quem já foi residente: os que saíram e os que seguem na equipe em outra função.
const anteriores = pessoas.filter((p) => p.data.situacao === 'anterior' || p.data.passouPelaCabine);

// Fora da cabine. "url" é opcional: perfil, site, o que fizer sentido para cada um.
// Com "url", informe também "destino", o nome curto que aparece na ponta da pulseira
// ("Instagram", "Site").
const foraDaCabine: { area: string; nome: string; url?: string; destino?: string }[] = [
  { area: 'Foto e vídeo', nome: 'Estilingue', url: 'https://www.instagram.com/estilingue/', destino: 'Instagram' },
  { area: 'Foto', nome: 'Felipe Cesar', url: 'https://www.instagram.com/felipecesard_/', destino: 'Instagram' },
  { area: 'Foto', nome: 'Yury Oliveira', url: 'https://www.instagram.com/hey.yury/', destino: 'Instagram' },
  { area: 'Bar', nome: 'Jaci', url: 'https://linktr.ee/jacigestaodebares', destino: 'Linktree' },
  { area: 'Som e luz', nome: 'Léo' },
];
const areas = [...new Set(foraDaCabine.map((n) => n.area))];
---
<Base titulo="Equipe">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Equipe">Equipe</h1>
    <p class="t-apoio">Quem faz a @bsurda, na cabine e fora dela.</p>
  </header>

  <section class="time" aria-labelledby="t-time">
    <h2 id="t-time" class="titulo-secao" data-anima="sobe">Quem faz hoje</h2>
    <div class="mesa">
      <ul class="crachas">
        {atuais.map((p, i) => (
          <li class:list={{ ed: p.id === 'ed-luiz' }} data-anima="surge" style={`--i:${i}`}>
            <Cracha nome={p.data.nome} funcao={p.data.funcao} grupo={p.data.grupo} foto={p.data.foto} desde={p.data.desde} numero={p.data.numero}
              href={`/equipe/${p.id}`} fundador={p.id === 'ed-luiz'} verso />
          </li>
        ))}
      </ul>
    </div>
    <p class="t-pequeno crachas-dica" aria-hidden="true">Arraste para ver todo mundo</p>
  </section>

  {anteriores.length > 0 && (
    <section class="passado" aria-labelledby="t-passado">
      <h2 id="t-passado" class="titulo-secao" data-anima="sobe">Já passaram pela cabine</h2>
      <p class="nomes" data-anima="surge">
        {anteriores.map((p) => <a href={`/equipe/${p.id}`}>{p.data.nome}{p.data.foto && <img class="previa" src={p.data.foto} alt="" loading="lazy" />}</a>)}
      </p>
      <p class="t-pequeno passado-nota">Lista em construção. (a confirmar)</p>
    </section>
  )}

  <section class="fora" aria-labelledby="t-fora">
    <h2 id="t-fora" class="t-secao" data-anima="sobe">Fora da cabine</h2>
    <p class="t-apoio fora-texto" data-anima="surge">Parceiros que voltam festa após festa. Sem eles não tem foto, não tem bar, não tem som.</p>
    <ul class="pulseiras" data-anima="surge">
      {foraDaCabine.map((n) => {
        const Tag = n.url ? 'a' : 'span';
        return (
          <li class:list={{ 'pulseira-b': areas.indexOf(n.area) % 2 === 1 }}>
            <Tag class="pulseira" href={n.url} target={n.url ? '_blank' : undefined} rel={n.url ? 'noopener' : undefined}>
              <span class="pulseira-cola" aria-hidden="true"></span>
              <strong>{n.nome}</strong>
              <span class="pulseira-area">{n.area}</span>
              <span class="pulseira-estampa" aria-hidden="true">
                <span class="pulseira-trilho">{Array.from({ length: 24 }).map(() => <><Arroba class="pulseira-marca" /><span>{n.area}</span></>)}</span>
              </span>
              {n.url && <span class="pulseira-destino">{n.destino ?? 'Abrir'}<span aria-hidden="true"> ↗</span></span>}
              <span class="pulseira-rabo" aria-hidden="true"></span>
            </Tag>
          </li>
        );
      })}
    </ul>
    <p class="fora-botao" data-anima="surge"><Botao href="/sobre#t-palco" tipo="linha">A cena que já tocou com a gente</Botao></p>
  </section>
</Base>

<style>
  /* Abertura mais baixa que nas outras páginas, para os crachás já aparecerem na primeira tela. */
  .abre.abre-cima { padding-top: clamp(2.5rem, 3.4vw, 3rem); padding-bottom: var(--e-3); }
  .abre .t-apoio { margin-top: var(--e-2); }
  /* Título de seção, igual ao do Sobre. */
  .t-secao { font-size: clamp(2.75rem, 9.5vw, 8.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }

  /* 1. Quem faz hoje. Composição de crachás: o do Ed ocupa duas linhas, os outros se arrumam ao lado. */
  .time { padding: var(--e-3) var(--margem) var(--e-6); }
  .time .titulo-secao { margin-bottom: var(--e-3); }
  /* Base (tela média): grade simples de três colunas. A mesa vem na tela larga, o trilho no celular. */
  .crachas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); }
  .crachas li { position: relative; }
  /* Pendurados ou largados, cada um cai de um jeito. A inclinação fica no crachá, e não no item
     da lista, porque o item já usa transform na animação de entrada. */
  .crachas li > :global(.cracha) { transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .crachas li:nth-child(odd) > :global(.cracha) { transform: rotate(-2.2deg); }
  .crachas li:nth-child(even) > :global(.cracha) { transform: rotate(1.6deg); }
  .crachas li:nth-child(3n) > :global(.cracha) { transform: rotate(3.1deg); }
  .crachas li.ed > :global(.cracha) { transform: rotate(-1.6deg); }
  .crachas li > :global(.cracha:hover), .crachas li > :global(.cracha:focus-visible) { transform: rotate(0deg) translateY(-0.3rem); }
  .crachas li:hover, .crachas li:focus-within { z-index: 5; }
  .crachas-dica { display: none; }

  /* A mesa. Tudo é medido pela altura e pela largura da própria mesa (cqh e cqw), para a
     composição caber numa tela em qualquer monitor sem deformar os crachás. */
  @media (min-width: 1101px) {
    .mesa { container-type: size; height: clamp(34rem, calc(100svh - 7.5rem), 60rem); }
    .crachas { position: relative; display: block; height: 100%;
      --lp: min(33cqh, 19.2cqw);              /* largura de um crachá pequeno */
      --ap: calc(var(--lp) * 1.4);            /* altura dele */
      --le: min(62cqh, 35cqw);                /* largura do crachá do Ed */
      /* O vão entre crachás divide a largura que sobra, para a composição ir de ponta a ponta em
         qualquer monitor. Em tela muito larga o vão para de crescer e o conjunto fica centralizado. */
      --sobra: calc(100cqw - var(--le) - 3 * var(--lp));
      --vao: clamp(1.2cqw, var(--sobra) / 3, 7cqw);
      --m: calc((var(--sobra) - 3 * var(--vao)) / 2);   /* margem que centraliza, quando sobra */
      --x0: calc(var(--m) + var(--le) + var(--vao));    /* onde começam os pequenos */
      --dx: calc(var(--lp) + var(--vao)); }             /* passo entre eles */
    .crachas li { position: absolute; width: var(--lp); }
    .crachas li.ed { left: var(--m); top: 4cqh; width: var(--le); z-index: 1; }
    .crachas li:nth-child(2) { left: var(--x0); top: 0; }
    .crachas li:nth-child(3) { left: calc(var(--x0) + var(--dx)); top: 4cqh; z-index: 2; }
    .crachas li:nth-child(4) { left: calc(var(--x0) + 2 * var(--dx)); top: 1cqh; }
    /* A linha de baixo tem dois, encaixados nos vãos da de cima. */
    .crachas li:nth-child(5) { left: calc(var(--x0) + 0.5 * var(--dx)); top: calc(var(--ap) + 5.5cqh); z-index: 3; }
    .crachas li:nth-child(6) { left: calc(var(--x0) + 1.5 * var(--dx)); top: calc(var(--ap) + 3.5cqh); z-index: 2; }
    .crachas li:hover, .crachas li:focus-within { z-index: 6; }

    /* No crachá grande tudo cresce junto. */
    .crachas li.ed :global(.cracha-nome) { font-size: clamp(2.5rem, 4.6vw, 4.5rem); }
    .crachas li.ed :global(.cracha-funcao) { font-size: 1.125rem; }
    .crachas li.ed :global(.cracha-selo) { top: 5.5rem; right: -1.4rem; width: 8.5rem; }
    .crachas li.ed :global(.cracha-selo strong) { font-size: 1rem; }
    .crachas li.ed :global(.cracha-selo span) { font-size: 2.25rem; }
    .crachas li.ed :global(.cracha-registro strong) { font-size: 1.75rem; }
    .crachas li.ed :global(.cracha-desde strong) { font-size: clamp(6rem, 11vw, 10rem); }
    .crachas li.ed :global(.cracha-desde span) { font-size: 1.125rem; }
    .crachas li:not(.ed) :global(.cracha-face) { padding: 0.7rem 0.8rem 0.8rem; }
    .crachas li:not(.ed) :global(.cracha-topo) { margin-top: 0.55rem; }
  }

  /* 2. Quem já fez parte: line-up, no desenho das listas do Sobre. */
  .passado { padding: var(--e-4) var(--margem) var(--e-6); }
  .passado .titulo-secao { margin-bottom: var(--e-3); }
  .nomes { display: flex; flex-wrap: wrap; gap: 0.2em 0; font-size: var(--t-5); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; text-transform: uppercase; }
  .nomes a { position: relative; display: inline-flex; align-items: flex-start; margin-right: 0.3em; text-decoration: none; }
  .nomes a::before { content: ''; flex: none; width: 0.14em; height: 0.72em; margin: 0.12em 0.4em 0 0.18em; background: var(--destaque); transform: skewX(26.5deg); }
  .nomes a:hover { text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.12em; }
  /* Foto de quem já passou, só com cursor: aparece acima do nome, levemente torta. */
  .previa { position: absolute; left: 1em; bottom: 100%; z-index: 2; width: clamp(9rem, 14vw, 13rem); aspect-ratio: 4 / 5; object-fit: cover; border-radius: 1rem; opacity: 0; transform: rotate(-3deg) translateY(0.5rem); pointer-events: none; transition: opacity 0.2s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @media (hover: hover) { .nomes a:hover .previa, .nomes a:focus-visible .previa { opacity: 1; transform: rotate(-3deg) translateY(-0.4rem); } }
  .passado-nota { margin-top: var(--e-2); }

  /* 3. Fora da cabine: pulseiras de acesso. A ponta destacável diz a área; o corpo, o nome. */
  .fora { padding: var(--e-4) var(--margem) var(--e-6); }
  .fora-texto { max-width: 30em; margin-top: var(--e-2); }
  /* Pulseira de papel, como as de entrada: todas do mesmo tamanho, com a aba de cola
     (em zigue-zague) numa ponta, a estampa repetida no corpo e a sobra na outra ponta.
     A cor muda por área, como muda por tipo de acesso na festa: uma usa o subtema vivo
     com aba na cor do texto, a outra o contrário. */
  .pulseiras { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.1rem; max-width: 68rem; margin-top: var(--e-4); }
  .pulseiras li { --p-fundo: var(--vivo); --p-texto: var(--sobre-vivo); --p-aba: var(--texto); --p-risco: var(--fundo); }
  .pulseiras li.pulseira-b { --p-fundo: var(--texto); --p-texto: var(--fundo); --p-aba: var(--vivo); --p-risco: var(--sobre-vivo); }
  .pulseiras li:nth-child(odd) { transform: rotate(-0.6deg); }
  .pulseiras li:nth-child(even) { transform: rotate(0.5deg); margin-left: 2.5%; margin-right: -2.5%; }
  .pulseira { display: flex; align-items: center; height: clamp(3.25rem, 4.6vw, 4.25rem); border-radius: 3px; background: var(--p-fundo); color: var(--p-texto); text-decoration: none; overflow: hidden; white-space: nowrap; }
  .pulseira-cola { flex: none; align-self: stretch; width: clamp(3.5rem, 9%, 7rem); background-color: var(--p-aba);
    background-image: linear-gradient(135deg, var(--p-risco) 25%, transparent 25%), linear-gradient(225deg, var(--p-risco) 25%, transparent 25%), linear-gradient(315deg, var(--p-risco) 25%, transparent 25%), linear-gradient(45deg, var(--p-risco) 25%, transparent 25%);
    background-size: 14px 14px; background-position: -7px 0, -7px 0, 0 0, 0 0; background-blend-mode: normal; opacity: 1; }
  .pulseira-cola { box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--p-aba) 62%, transparent); }
  .pulseira strong { flex: none; padding: 0 0.9rem 0 1rem; font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
  /* A área, uma vez, para quem lê com leitor de tela; na tela ela aparece na estampa. */
  .pulseira-area { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .pulseira-estampa { flex: 1; min-width: 0; overflow: hidden; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; -webkit-mask-image: linear-gradient(90deg, #000 10rem, rgba(0, 0, 0, 0.5) 20rem); mask-image: linear-gradient(90deg, #000 10rem, rgba(0, 0, 0, 0.5) 20rem); }
  /* A estampa é um trilho com o mesmo desenho repetido; ao passar o cursor, ele corre, como se a
     pulseira estivesse sendo puxada do rolo. Metade do trilho é igual à outra, então o laço não tem emenda. */
  .pulseira-trilho { display: inline-flex; align-items: center; gap: 0.9rem; padding-right: 0.9rem; animation: puxa 26s linear infinite; animation-play-state: paused; }
  @keyframes puxa { to { transform: translateX(-50%); } }
  .pulseiras li { transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @media (hover: hover) and (pointer: fine) {
    .pulseiras li:hover, .pulseiras li:focus-within { transform: rotate(0deg) translateX(0.75rem); }
    .pulseiras li:hover .pulseira-trilho, .pulseiras li:focus-within .pulseira-trilho { animation-play-state: running; }
  }
  /* Pulseira com link: o destino fica escrito perto da sobra, com a seta de link externo. */
  .pulseira-destino { flex: none; padding: 0 0.9rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.16em; }
  .pulseira-estampa :global(.pulseira-marca) { flex: none; height: 1.35rem; width: auto; }
  .pulseira-estampa span { flex: none; }
  .pulseira-rabo { flex: none; align-self: stretch; width: clamp(1rem, 3%, 2.25rem); background: var(--p-aba); }
  a.pulseira:hover .pulseira-destino, a.pulseira:focus-visible .pulseira-destino { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .fora-botao { margin-top: var(--e-5); }

  @media (max-width: 820px) {
    /* No celular os crachás continuam em pé, todos do mesmo tamanho, numa fila para arrastar de
       lado. O próximo sempre aparece um pouco, para avisar que tem mais. */
    .crachas { display: flex; gap: 0.9rem; margin: 0 calc(-1 * var(--margem)); padding: 0.75rem var(--margem) 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margem); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .crachas::-webkit-scrollbar { display: none; }
    .crachas li { flex: 0 0 min(72%, 17rem); scroll-snap-align: start; }
    .crachas li.ed :global(.cracha-selo) { right: -0.6rem; }
    .crachas-dica { display: block; margin-top: var(--e-1, 0.5rem); }
    .pulseiras { gap: 0.9rem; }
    .pulseiras li:nth-child(even) { margin-left: 0; margin-right: 0; }
    .pulseira-cola { width: 2.75rem; }
    .pulseira strong { font-size: 1.375rem; padding: 0 0.7rem 0 0.75rem; }
    .pulseira-estampa { -webkit-mask-image: none; mask-image: none; }
  }
  @media (prefers-reduced-motion: reduce) { .crachas li > :global(.cracha), .previa, .pulseiras li { transition: none; } .pulseira-trilho { animation: none; } }
</style>
