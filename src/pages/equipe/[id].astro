---
import Base from '../../layouts/Base.astro';
import Cracha from '../../components/Cracha.astro';
import { getCollection, render } from 'astro:content';
import Botao from '../../components/Botao.astro';
import { atributo } from '../../lib/temas';
import { temaDaPessoa } from '../../lib/pessoas';

export async function getStaticPaths() {
  const pessoas = await getCollection('pessoas');
  return pessoas.map((pessoa) => ({ params: { id: pessoa.id }, props: { pessoa } }));
}
const { pessoa } = Astro.props;
const { Content } = await render(pessoa);
const alumni = pessoa.data.situacao === 'anterior';
// "Fotógrafo e DJ" vira "fotógrafo e DJ" no meio da frase; "DJ residente" continua como está.
const f = pessoa.data.funcao;
const funcaoNaFrase = /^[A-ZÀ-Ú][a-zà-ú]/.test(f) ? f[0].toLowerCase() + f.slice(1) : f;
const projetos = (await getCollection('projetos')).filter((pr) => pr.data.pessoas.some((ref) => ref.id === pessoa.id));
// O tema vem da foto da pessoa. Sem foto, um par fixo da marca.
const tema = await temaDaPessoa(pessoa.id, pessoa.data.foto);
---
<Base titulo={pessoa.data.nome} tema={tema} imagem={pessoa.data.foto}>
  <div class="pessoa" data-tema={atributo(tema)}>
    <div class="pessoa-crachas">
      <div class="pessoa-verso" aria-hidden="true">
        {/* Sem a condição de fundador no verso (escolha do Gui): nesta página o selo da frente está sempre à vista. */}
        <Cracha lado="verso" nome={pessoa.data.nome} funcao={pessoa.data.funcao} grupo={pessoa.data.grupo} desde={pessoa.data.desde} ate={pessoa.data.ate} alumni={alumni} numero={pessoa.data.numero} sigla={pessoa.data.sigla} />
      </div>
      <div class="pessoa-frente">
        <Cracha nome={pessoa.data.nome} funcao={pessoa.data.funcao} grupo={pessoa.data.grupo} foto={pessoa.data.foto} desde={pessoa.data.desde} ate={pessoa.data.ate} alumni={alumni} numero={pessoa.data.numero} sigla={pessoa.data.sigla} fundador={pessoa.id === 'ed-luiz'} />
      </div>
    </div>
    <div class="pessoa-texto">
      <p class="etiqueta">{pessoa.data.situacao === 'atual' ? pessoa.data.funcao : `Fez parte da @bsurda como ${funcaoNaFrase}`}</p>
      <h1 class="t-grande">{pessoa.data.nome}</h1>
      <p class="so-leitor">{alumni ? `Na @bsurda de ${pessoa.data.desde ?? 'ano a confirmar'} a ${pessoa.data.ate ?? 'ano a confirmar'}.` : `Na @bsurda desde ${pessoa.data.desde ?? 'data a confirmar'}.`}</p>
      <div class="prosa"><Content /></div>
      {pessoa.data.instagram && <p><Botao href={pessoa.data.instagram} externo>Instagram</Botao></p>}

      {pessoa.data.links.length > 0 && (
        <section aria-labelledby="t-outros">
          <h2 id="t-outros" class="titulo-secao">Outros projetos</h2>
          <ul>{pessoa.data.links.map((l) => <li><a class="link" href={l.url} target="_blank" rel="noopener">{l.rotulo}</a></li>)}</ul>
        </section>
      )}

      {projetos.length > 0 && (
        <section aria-labelledby="t-na">
          <h2 id="t-na" class="titulo-secao">Na @bsurda</h2>
          <ul>{projetos.map((pr) => <li><a class="t-medio" href={`/projetos/${pr.id}`}>{pr.data.nome}</a></li>)}</ul>
        </section>
      )}

      {/* O caminho de volta fica no fim, onde a leitura termina. No topo ele competia com os crachás. */}
      <p class="pessoa-volta"><Botao href="/equipe" tipo="linha">Toda a equipe</Botao></p>
    </div>
  </div>
</Base>

<style>
  .pessoa { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); padding: clamp(2rem, 5vw, 4rem) var(--margem) clamp(3.5rem, 9vw, 8rem); align-items: start; }
  /* Frente e verso do crachá da pessoa, largados um sobre o outro como na mesa da Equipe:
     a frente por cima, o verso aparecendo por trás, cada um num ângulo. No celular, que não tem
     o giro do hover, é aqui que o verso aparece. */
  .pessoa-texto .pessoa-volta { margin-top: clamp(2.5rem, 5vw, 4rem); }
  /* Crachás maiores que os pequenos da Equipe e menores que o do Ed lá: o verso precisa caber inteiro. */
  .pessoa-crachas { --l: clamp(15.5rem, 23vw, 21rem); position: relative; width: calc(var(--l) * 1.97); height: calc(var(--l) * 1.4 * 1.16); }
  .pessoa-frente, .pessoa-verso { position: absolute; width: var(--l); transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .pessoa-frente { left: 0; top: 0; z-index: 1; transform: rotate(-3deg); }
  .pessoa-verso { left: calc(var(--l) * 0.93); top: calc(var(--l) * 0.18); transform: rotate(4deg); }
  .pessoa-frente :global(.cracha-face), .pessoa-verso :global(.cracha-face) { box-shadow: 0 0 0 3px var(--fundo); }
  /* Aqui o selo do fundador fica dentro do crachá: solto para fora, ele caía em cima do verso. */
  .pessoa-frente :global(.cracha-selo) { right: 0.5rem; top: 3.4rem; }
  /* Registro mais contido, e com quebra de linha como garantia, para nunca sair do crachá. */
  .pessoa-verso :global(.cracha-registro) { flex-wrap: wrap; row-gap: 0.15rem; }
  .pessoa-verso :global(.cracha-registro strong) { font-size: 1.125rem; }
  .pessoa-verso :global(.cracha-registro span span) { font-size: 0.5625rem; letter-spacing: 0.12em; }
  /* Passar o cursor no verso traz ele para a frente. */
  @media (hover: hover) and (pointer: fine) {
    .pessoa-verso:hover { z-index: 2; transform: rotate(1deg) translateY(-0.4rem); }
  }
  .pessoa-texto > * + * { margin-top: 1.25rem; }
  .pessoa-texto section { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .pessoa-texto .titulo-secao { margin-bottom: 0.75rem; }
  @media (max-width: 720px) {
    .pessoa { grid-template-columns: minmax(0, 1fr); }
    /* No celular não cabem lado a lado em tamanho legível: ficam em escada, a frente em cima à
       esquerda e o verso descendo à direita, por baixo dela. */
    .pessoa-crachas { --l: min(13.5rem, 60vw); width: 100%; height: calc(var(--l) * 1.4 * 1.78); }
    .pessoa-verso { left: auto; right: 0; top: calc(var(--l) * 1.4 * 0.74); transform: rotate(3deg); }
    /* Selo menor no celular, para não cobrir o rosto na foto. */
    .pessoa-frente :global(.cracha-selo) { width: 4.5rem; top: 2.9rem; right: 0.4rem; }
    .pessoa-frente :global(.cracha-selo strong) { font-size: 0.5625rem; }
    .pessoa-frente :global(.cracha-selo span) { font-size: 1.125rem; }
    .pessoa-verso :global(.cracha-desde strong) { font-size: 2.75rem; }
    .pessoa-verso :global(.cracha-intervalo strong) { font-size: 1.75rem; }
    .pessoa-verso :global(.cracha-registro strong) { font-size: 1.125rem; }
    .pessoa-verso :global(.cracha-verso) { padding: 0.8rem 0.9rem 0.9rem; overflow: hidden; }
    /* Num crachá deste tamanho as linhas miúdas do verso encolhem para caber sem cortar. */
    .pessoa-verso :global(.cracha-topo) { font-size: 0.625rem; letter-spacing: 0.12em; }
    .pessoa-verso :global(.cracha-acesso) { font-size: 0.5625rem; letter-spacing: 0.1em; }
    .pessoa-verso :global(.cracha-registro span span) { font-size: 0.5625rem; letter-spacing: 0.1em; }
    .pessoa-verso :global(.cracha-codigo) { font-size: 0.5625rem; letter-spacing: 0.14em; }
  }
  @media (prefers-reduced-motion: reduce) { .pessoa-frente, .pessoa-verso { transition: none; } }
</style>
