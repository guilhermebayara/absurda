---
import Base from '../../layouts/Base.astro';
import Cracha from '../../components/Cracha.astro';
import { getCollection, render } from 'astro:content';
import Botao from '../../components/Botao.astro';
import { atributo } from '../../lib/temas';
import { temaDaPessoa } from '../../lib/pessoas';

export async function getStaticPaths() {
  const pessoas = await getCollection('pessoas');
  return pessoas.map((pessoa) => ({ params: { id: pessoa.id }, props: { pessoa } }));
}
const { pessoa } = Astro.props;
const { Content } = await render(pessoa);
const projetos = (await getCollection('projetos')).filter((pr) => pr.data.pessoas.some((ref) => ref.id === pessoa.id));
// O tema vem da foto da pessoa. Sem foto, um par fixo da marca.
const tema = await temaDaPessoa(pessoa.id, pessoa.data.foto);
---
<Base titulo={pessoa.data.nome} tema={tema} imagem={pessoa.data.foto}>
  <div class="pessoa" data-tema={atributo(tema)}>
    <div class="pessoa-cracha">
      <Cracha nome={pessoa.data.nome} funcao={pessoa.data.funcao} grupo={pessoa.data.grupo} foto={pessoa.data.foto} desde={pessoa.data.desde} fundador={pessoa.id === 'ed-luiz'} />
    </div>
    <div class="pessoa-texto">
      <a class="voltar" href="/equipe">Toda a equipe</a>
      <p class="etiqueta">{pessoa.data.situacao === 'atual' ? pessoa.data.funcao : `Fez parte da @bsurda como ${pessoa.data.funcao.toLowerCase()}`}</p>
      <h1 class="t-grande">{pessoa.data.nome}</h1>
      {pessoa.data.situacao === 'atual' && (
        <ul class="pessoa-dados">
          <li><strong>{pessoa.data.desde ?? 'XXXX'}</strong><span>na @bsurda desde</span></li>
          <li><strong>{pessoa.data.desde ? new Date().getFullYear() - pessoa.data.desde : 'X'}</strong><span>anos de festa</span></li>
        </ul>
      )}
      <div class="prosa"><Content /></div>
      {pessoa.data.instagram && <p><Botao href={pessoa.data.instagram} externo>Instagram</Botao></p>}

      {pessoa.data.links.length > 0 && (
        <section aria-labelledby="t-outros">
          <h2 id="t-outros" class="titulo-secao">Outros projetos</h2>
          <ul>{pessoa.data.links.map((l) => <li><a class="link" href={l.url} target="_blank" rel="noopener">{l.rotulo}</a></li>)}</ul>
        </section>
      )}

      {projetos.length > 0 && (
        <section aria-labelledby="t-na">
          <h2 id="t-na" class="titulo-secao">Na @bsurda</h2>
          <ul>{projetos.map((pr) => <li><a class="t-medio" href={`/projetos/${pr.id}`}>{pr.data.nome}</a></li>)}</ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .pessoa { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); padding: clamp(2rem, 5vw, 4rem) var(--margem) clamp(3.5rem, 9vw, 8rem); align-items: start; }
  /* O crachá da pessoa, o mesmo da página Equipe, pendurado ao lado do texto. */
  .pessoa-cracha { width: clamp(15rem, 24vw, 21rem); transform: rotate(-1.5deg); }
  .pessoa-dados { display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4); }
  .pessoa-dados li { display: grid; gap: 0.3em; }
  .pessoa-dados strong { font-size: var(--t-4); font-weight: 800; line-height: 0.85; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .pessoa-dados span { font-size: 0.9375rem; color: var(--suave); }
  .pessoa-texto > * + * { margin-top: 1.25rem; }
  .pessoa-texto section { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .pessoa-texto .titulo-secao { margin-bottom: 0.75rem; }
  @media (max-width: 720px) { .pessoa { grid-template-columns: 1fr; } .pessoa-cracha { width: min(17rem, 78%); } }
</style>
