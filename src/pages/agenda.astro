---
// Agenda: duas partes com trabalhos diferentes.
// Próximos: poucos, todos com o mesmo peso, feitos para escolher uma data e comprar.
// Passados: o arquivo. O ano é o protagonista e os eventos viram uma lista
// tipográfica densa, com a capa aparecendo ao passar o mouse.
import Base from '../layouts/Base.astro';
import CartaoEvento from '../components/CartaoEvento.astro';
import Faixa from '../components/Faixa.astro';
import Botao from '../components/Botao.astro';
import { SITE } from '../config';
import { getEventos, partesDaData } from '../lib/eventos';
import { atributo, TEMAS_DO_SITE } from '../lib/temas';
import marcos from '../data/marcos.json';

const { proximos, passados } = await getEventos();
const temaInicial = proximos[0]?.tema ?? TEMAS_DO_SITE[0];
// Agrupa os passados por ano.
const anos = new Map<number, typeof passados>();
for (const e of passados) {
  const ano = partesDaData(e.data).ano;
  anos.set(ano, [...(anos.get(ano) ?? []), e]);
}
// Anos que só têm marco (sem eventos registrados) também aparecem, para a linha
// do tempo não pular os anos de que ainda não há arquivo.
for (const m of marcos) if (!anos.has(Number(m.ano))) anos.set(Number(m.ano), []);
const lista = [...anos].sort((a, b) => b[0] - a[0]);
// Marcos da história, por ano (os mesmos da página Sobre).
const marcosDe = (ano: number) => marcos.filter((m) => Number(m.ano) === ano);
const plural = (n: number) => (n === 1 ? '1 data' : `${n} datas`);
---
<Base titulo="Agenda" tema={temaInicial}>
  <header class="abre abre-cima" data-tema={atributo(temaInicial)}>
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Agenda">Agenda</h1>
    <p class="t-apoio">
      {proximos.length > 0 ? `${plural(proximos.length)} pela frente` : 'Nenhuma data anunciada no momento'}, e o que já rolou desde 2009.
    </p>
  </header>

  <section class="proximos" aria-labelledby="t-proximos">
    <h2 id="t-proximos" class="titulo-secao" data-anima="sobe">Vem aí</h2>
    {proximos.length > 0
      ? (
        <div class="proximos-grade">
          {proximos.map((e) => <CartaoEvento evento={e} />)}
        </div>
      )
      : <p class="t-apoio">As próximas aparecem aqui assim que os ingressos abrirem. Enquanto isso, acompanhe pelo <a href={SITE.redes.instagram}>Instagram</a>.</p>}
  </section>

  <div data-tema="sorteio" data-reserva={atributo(TEMAS_DO_SITE[0])}>
    <Faixa texto={`${SITE.lema} desde 2009`} />

    <section class="arquivo" aria-labelledby="t-passados">
      <header class="arquivo-abre">
        <h2 id="t-passados" class="t-gigante ecoa" data-eco="Já rolou" data-anima="eco">Já rolou</h2>
        <div class="arquivo-fotos">
          <p class="t-apoio">As fotos das edições recentes ficam no Pixieset, separadas por festa. As de 2009 a 2013 estão no Flickr: cada festa dessa época leva direto ao álbum.</p>
          <Botao href={SITE.fotos} externo tipo="linha">Fotos no Pixieset</Botao>
        </div>
      </header>

      <!-- Atalho para os anos: fica preso no topo enquanto se rola pelo arquivo -->
      <nav class="anos-nav" aria-label="Anos">
        <ul>
          {lista.map(([ano]) => <li><a href={`#ano-${ano}`} data-ano={ano}>{ano}</a></li>)}
        </ul>
      </nav>

      {lista.map(([ano, eventos]) => (
        <details class="ano" id={`ano-${ano}`}>
          <summary>
            <span class="ano-numero">{ano}</span>
            {marcosDe(ano).length > 0 && (
              <span class="ano-marcos">
                {marcosDe(ano).map((m) => <span><i aria-hidden="true"></i>{m.titulo}{m.tema && <em>{m.tema}</em>}</span>)}
              </span>
            )}
            <span class="ano-sinal" aria-hidden="true">
              <svg class="ano-arco" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" /></svg>
              <svg class="ano-mais" viewBox="0 0 16 16"><path d="M2.5 8h11" /><path class="ano-mais-v" d="M8 2.5v11" /></svg>
            </span>
          </summary>
          <div class="ano-corpo">
            {marcosDe(ano).map((m) => (
              <p class="marco"><span aria-hidden="true"></span><strong>{m.titulo}</strong>{m.tema && <b>{m.tema}</b>}{m.texto && <em>{m.texto}</em>}</p>
            ))}
            {eventos.length === 0 && <p class="sem-arquivo">As festas deste ano ainda não estão no arquivo.</p>}
            <ul class="linhas">
              {eventos.map((e) => {
                const d = partesDaData(e.data);
                return (
                  <li>
                    {/* Sem link (como os trios de carnaval mais antigos), a linha é só registro */}
                    <Fragment>
                      {e.url
                        ? (
                          <a class="linha" href={e.url} target="_blank" rel="noopener" data-espia={e.capa ?? ''}>
                            <span class="linha-data">{d.dia} {d.mes}</span>
                            <span class="linha-nome">{e.nome}</span>
                            <span class="linha-local"><span>{e.local ?? ''}</span>{e.album && <span class="linha-fotos">Fotos no Flickr</span>}</span>
                            {e.capaPequena && <img class="linha-mini" src={e.capaPequena} alt="" loading="lazy" />}
                            <span class="so-leitor"> (abre em outra aba)</span>
                          </a>
                        )
                        : (
                          <div class="linha" data-espia={e.capa ?? ''}>
                            <span class="linha-data">{d.dia} {d.mes}</span>
                            <span class="linha-nome">{e.nome}</span>
                            <span class="linha-local">{e.local ?? ''}</span>
                            {e.capaPequena && <img class="linha-mini" src={e.capaPequena} alt="" loading="lazy" />}
                          </div>
                        )}
                    </Fragment>
                  </li>
                );
              })}
            </ul>
          </div>
        </details>
      ))}

      <p class="arquivo-fim"><Botao href={SITE.fotos} externo tipo="linha">Se ache nas fotos</Botao></p>
      <!-- Capa que acompanha o cursor na lista -->
      <div class="espia-capa" aria-hidden="true"><img alt="" /></div>
    </section>
  </div>
</Base>

<script>
  // A capa do evento acompanha o cursor enquanto ele passa pela lista.
  const espia = document.querySelector<HTMLElement>('.espia-capa');
  const imagem = espia?.querySelector('img');
  if (espia && imagem && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.linhas .linha').forEach((el) => {
      el.addEventListener('pointerenter', (e) => {
        if (!el.dataset.espia) return;
        espia.style.setProperty('--x', `${e.clientX}px`);
        espia.style.setProperty('--y', `${e.clientY}px`);
        imagem.src = el.dataset.espia;
        espia.classList.add('visivel');
      });
      el.addEventListener('pointerleave', () => espia.classList.remove('visivel'));
      el.addEventListener('pointermove', (e) => {
        espia.style.setProperty('--x', `${e.clientX}px`);
        espia.style.setProperty('--y', `${e.clientY}px`);
        espia.style.setProperty('--giro', `${Math.max(-8, Math.min(8, e.movementX * 0.6))}deg`);
      });
    });
  }

  // Abrir e fechar um ano: o corpo cresce ou encolhe e o conteúdo entra junto, de leve.
  // Abre em 0,45s e fecha um pouco mais rápido. Quem pede menos movimento fica com a troca seca.
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)');
  const curva = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
  const emCurso = new WeakMap<HTMLElement, Animation>();
  const alternar = (bloco: HTMLDetailsElement, abrir: boolean) => {
    const corpo = bloco.querySelector<HTMLElement>('.ano-corpo');
    if (!corpo || calmo.matches) { bloco.open = abrir; return; }
    const anterior = emCurso.get(corpo);
    if (anterior) { anterior.onfinish = null; anterior.oncancel = null; anterior.cancel(); }
    bloco.classList.toggle('fechando', !abrir);
    if (abrir) bloco.open = true;
    const altura = corpo.offsetHeight;
    const quadros = abrir
      ? [{ height: '0px', opacity: 0, transform: 'translateY(-0.6rem)' }, { height: `${altura}px`, opacity: 1, transform: 'none' }]
      : [{ height: `${altura}px`, opacity: 1, transform: 'none' }, { height: '0px', opacity: 0, transform: 'translateY(-0.6rem)' }];
    corpo.style.overflow = 'clip';
    const anima = corpo.animate(quadros, { duration: abrir ? 450 : 320, easing: curva });
    emCurso.set(corpo, anima);
    anima.onfinish = () => {
      corpo.style.overflow = '';
      if (!abrir) { bloco.open = false; bloco.classList.remove('fechando'); }
    };
  };
  document.querySelectorAll<HTMLDetailsElement>('details.ano').forEach((bloco) => {
    bloco.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      alternar(bloco, !bloco.open || bloco.classList.contains('fechando'));
    });
  });

  // Atalho de anos: marca o ano que está na tela e abre o ano clicado.
  const atalhos = [...document.querySelectorAll<HTMLAnchorElement>('.anos-nav a')];
  const blocos = [...document.querySelectorAll<HTMLDetailsElement>('details.ano')];
  const fila = document.querySelector<HTMLElement>('.anos-nav ul');
  // Só um ano fica marcado por vez: o que cruza uma linha a 27% do alto da tela.
  // A conta é refeita do zero a cada vez. Antes ela dependia da ordem dos avisos do navegador
  // e, ao tocar num ano, quem acabava marcado era o seguinte (o tocado ainda estava abrindo).
  let marcado = '';
  let travaAte = 0;
  const pintar = (id: string) => {
    if (id === marcado) return;
    marcado = id;
    for (const a of atalhos) {
      const atual = `ano-${a.dataset.ano}` === id;
      if (atual) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      // Traz o ano marcado para o meio da fila, rolando só a fila (nunca a página).
      if (atual && fila) {
        const ra = a.getBoundingClientRect();
        const rf = fila.getBoundingClientRect();
        fila.scrollTo({ left: fila.scrollLeft + ra.left - rf.left - (rf.width - ra.width) / 2, behavior: calmo.matches ? 'auto' : 'smooth' });
      }
    }
  };
  const medir = () => {
    if (performance.now() < travaAte) return;
    const linha = window.innerHeight * 0.27;
    const bloco = blocos.find((b) => { const r = b.getBoundingClientRect(); return r.top <= linha && r.bottom > linha; });
    if (bloco) pintar(bloco.id);
  };
  for (const a of atalhos) {
    a.addEventListener('click', () => {
      const bloco = document.getElementById(`ano-${a.dataset.ano}`) as HTMLDetailsElement | null;
      if (!bloco) return;
      if (!bloco.open) alternar(bloco, true);
      // O ano tocado fica marcado na hora; a medição volta quando ele termina de abrir.
      pintar(bloco.id);
      travaAte = performance.now() + 600;
      setTimeout(medir, 650);
    });
  }
  if (blocos.length > 0) {
    const marca = new IntersectionObserver(medir, { rootMargin: '-25% 0px -70% 0px' });
    blocos.forEach((b) => marca.observe(b));
    // Abrir ou fechar um ano muda a altura dos blocos sem rolar a página: mede de novo.
    blocos.forEach((b) => b.addEventListener('toggle', () => setTimeout(medir, 500)));
  }
</script>

<style>
  .abre .t-apoio { margin-top: var(--e-3); }

  .proximos { padding: var(--e-4) var(--margem) var(--e-5); }
  .proximos-grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--e-3); }
  @media (max-width: 1000px) { .proximos-grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .proximos-grade { grid-template-columns: 1fr; } }

  .arquivo { position: relative; isolation: isolate; padding: var(--e-6) var(--margem); }
  .arquivo-abre { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--e-4); align-items: end; margin-bottom: var(--e-5); }
  .arquivo-fotos { display: grid; gap: var(--e-3); justify-items: start; margin-bottom: calc(clamp(3.25rem, 13.5vw, 13rem) * 0.565); }
  @media (max-width: 820px) { .arquivo-abre { grid-template-columns: 1fr; } }

  /* Atalho de anos: uma fila que rola para o lado, presa no topo */
  .anos-nav { position: sticky; top: 0; z-index: 5; margin: 0 calc(var(--margem) * -1); padding: 0.9rem var(--margem); background: var(--fundo); border-bottom: 1.5px solid var(--texto); }
  .anos-nav ul { display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); overflow-x: auto; scrollbar-width: none; }
  .anos-nav ul::-webkit-scrollbar { display: none; }
  .anos-nav a { position: relative; display: block; padding-left: 0.9em; font-size: clamp(0.875rem, 1.05vw, 1rem); font-weight: 800; letter-spacing: 0.08em; text-decoration: none; transition: color 0.2s; }
  .anos-nav a::before { content: ''; position: absolute; left: 0.2em; top: 50%; width: 0.36em; height: 1.45em; margin-top: -0.725em; background: var(--destaque); transform: skewX(26.5deg) scaleY(0); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .anos-nav a[aria-current] { color: var(--destaque-texto); }
  .anos-nav a[aria-current]::before { transform: skewX(26.5deg) scaleY(1); }
  /* Hover só em aparelho com cursor: no toque ele fica preso no último ano tocado, e dois
     anos apareciam marcados ao mesmo tempo. */
  @media (hover: hover) {
    .anos-nav a:hover { color: var(--destaque-texto); }
    .anos-nav a:hover::before { transform: skewX(26.5deg) scaleY(1); }
  }

  /* Cada ano: o número gigante é o título e também o botão que abre e fecha */
  .ano { border-bottom: 1.5px solid var(--texto); scroll-margin-top: 3.5rem; }
  .ano summary { display: flex; align-items: baseline; gap: var(--e-3); padding: var(--e-3) 0 var(--e-2); cursor: pointer; list-style: none; }
  .ano summary::-webkit-details-marker { display: none; }
  .ano-numero { flex: none; min-width: calc(4ch - 0.12em); font-size: clamp(3.5rem, 12vw, 11rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.05em; transition: color 0.3s; }
  .ano summary:hover .ano-numero { color: var(--destaque); }
  /* O sinal de abrir é o anel do "@" com um "+" dentro. Aberto, o "+" vira "−". */
  .ano-sinal { position: relative; align-self: center; flex: none; width: clamp(2.25rem, 3.6vw, 3.25rem); aspect-ratio: 1; margin-left: auto; }
  .ano-arco { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transform: rotate(158.5deg); transition: transform 0.7s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  .ano-arco circle { fill: none; stroke: currentColor; stroke-width: 3; stroke-dasharray: 75.8 31; }
  .ano-mais { position: absolute; inset: 0; margin: auto; width: 42%; height: 42%; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: butt; }
  .ano-mais-v { transform-origin: center; transition: transform 0.4s cubic-bezier(0.62, 0.05, 0.01, 0.99); }
  .ano[open] .ano-mais-v { transform: scaleY(0); }
  .ano summary:hover .ano-arco { transform: rotate(518.5deg); }
  .ano summary:hover .ano-sinal { color: var(--destaque); }
  /* Com o ano fechado, os marcos aparecem ao lado do número. Aberto, eles descem para o corpo, com o texto completo. */
  .ano-marcos { display: grid; gap: 0.3em; align-self: center; color: var(--destaque-texto); font-size: var(--t-3); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; }
  .ano-marcos span { display: flex; align-items: center; gap: 0.6em; }
  .ano-marcos i { flex: none; width: 0.18em; height: 0.8em; background: var(--destaque); transform: skewX(26.5deg); }
  .ano[open]:not(.fechando) .ano-marcos { display: none; }
  /* Ao fechar, os marcos voltam para o lado do número sem estalo; o sinal já mostra "+". */
  .ano.fechando .ano-marcos { animation: marcos-voltam 0.32s ease both; }
  .ano.fechando .ano-mais-v { transform: none; }
  @keyframes marcos-voltam { from { opacity: 0; } }
  @media (max-width: 720px) { .ano summary { flex-wrap: wrap; } .ano-marcos { order: 3; flex-basis: 100%; font-size: 1rem; } }
  .ano-corpo { padding-bottom: var(--e-4); }

  /* Marco do ano: entra antes da lista, com a barra do logo */
  .marco { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.8em; margin: var(--e-2) 0 var(--e-3); color: var(--destaque); font-size: var(--t-4); line-height: 1.05; }
  .marco span { align-self: center; flex: none; width: 0.18em; height: 0.8em; background: var(--destaque); transform: skewX(26.5deg); }
  .marco strong { font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase; }
  /* Etiqueta do tipo de marco (por enquanto, só Carnaval) */
  .marco b, .ano-marcos em { padding: 0.2em 0.6em; border: 1.5px solid currentColor; border-radius: 99px; font-size: 0.75rem; font-style: normal; font-weight: 700; letter-spacing: 0.08em; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .marco b { align-self: center; color: var(--destaque-texto); }
  .marco em { font-size: var(--t-apoio); font-style: normal; color: var(--texto); }

  .sem-arquivo { color: var(--suave); font-size: var(--t-apoio); }

  /* Lista de eventos: uma linha por data. A capa passa por trás dos nomes. */
  .linhas li { border-top: 1px solid var(--linha); }
  .linhas .linha { position: relative; z-index: 2; display: grid; grid-template-columns: 6.5rem minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--e-3); align-items: baseline; padding: 0.7rem 0; text-decoration: none; transition: padding 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s; }
  .linhas a.linha:hover, .linhas a.linha:focus-visible { padding-left: 0.9rem; color: var(--destaque-texto); }
  .linha-data { font-size: 0.9375rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .linha-nome { font-size: var(--t-3); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; }
  .linha-local { font-size: 0.9375rem; color: var(--suave); }
  .linhas .linha:hover .linha-local { color: inherit; }
  /* Marca das festas antigas cujo link leva ao álbum de fotos */
  /* Local e etiqueta em colunas próprias: os dois começam sempre no mesmo ponto, linha após linha. */
  .linha-local { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--e-2); align-items: baseline; }
  .linha-fotos { display: inline-block; padding: 0.15em 0.6em; border: 1.5px solid currentColor; border-radius: 99px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
  .linha-mini { display: none; }
  @media (max-width: 720px) {
    /* No celular não existe hover: a capa vira miniatura ao lado */
    .linhas .linha { grid-template-columns: 4.75rem minmax(0, 1fr); grid-template-areas: 'mini data' 'mini nome' 'mini local'; gap: 0.15rem 0.9rem; align-items: start; }
    .linha-mini { display: block; grid-area: mini; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.4rem; margin-top: 0.2rem; }
    .linha-data { grid-area: data; font-size: 0.8125rem; }
    .linha-nome { grid-area: nome; }
    .linha-local { grid-area: local; font-size: 0.8125rem; grid-template-columns: auto auto; justify-content: start; column-gap: 0.8em; }
    .linha-local > span:first-child:empty { display: none; }
  }

  .arquivo-fim { margin-top: var(--e-5); text-align: right; }

  .espia-capa { position: fixed; left: 0; top: 0; z-index: 1; width: clamp(15rem, 24vw, 24rem); aspect-ratio: 16 / 9; overflow: hidden; border-radius: clamp(0.6rem, 1.2vw, 1rem); background: var(--texto); box-shadow: 0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.55); pointer-events: none; opacity: 0; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(0.85); transition: opacity 0.2s, transform 0.18s ease-out; }
  .espia-capa.visivel { opacity: 1; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(1); }
  .espia-capa img { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .anos-nav a::before, .ano-arco, .ano-mais-v, .linhas .linha, .espia-capa { transition: none; } }
  /* TESTE (branch qa-faixa-safari): em tela de toque a prévia que segue o cursor nunca aparece.
     Fora da página, ela deixa de ser um elemento fixo que o Safari possa levar em conta ao
     escolher a cor das barras. */
  @media (hover: none) { .espia-capa { display: none; } }
</style>
