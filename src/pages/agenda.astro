---
// Agenda: duas partes com trabalhos diferentes.
// Próximos: poucos, todos com o mesmo peso, feitos para escolher uma data e comprar.
// Passados: o arquivo. O ano é o protagonista e os eventos viram uma lista
// tipográfica densa, com a capa aparecendo ao passar o mouse.
import Base from '../layouts/Base.astro';
import CartaoEvento from '../components/CartaoEvento.astro';
import Faixa from '../components/Faixa.astro';
import Botao from '../components/Botao.astro';
import { SITE } from '../config';
import { getEventos, partesDaData } from '../lib/eventos';
import { atributo, TEMAS_DO_SITE } from '../lib/temas';
import marcos from '../data/marcos.json';

const { proximos, passados } = await getEventos();
const temaInicial = proximos[0]?.tema ?? TEMAS_DO_SITE[0];
// Agrupa os passados por ano.
const anos = new Map<number, typeof passados>();
for (const e of passados) {
  const ano = partesDaData(e.data).ano;
  anos.set(ano, [...(anos.get(ano) ?? []), e]);
}
const lista = [...anos].sort((a, b) => b[0] - a[0]);
const primeiroAno = lista.at(-1)?.[0];
// Os dois anos mais recentes ficam abertos; os outros abrem ao clicar.
const abertos = new Set(lista.slice(0, 2).map(([ano]) => ano));
// Marcos da história, por ano (os mesmos da página Sobre).
const marcosDe = (ano: number) => marcos.filter((m) => Number(m.ano) === ano);
const plural = (n: number) => (n === 1 ? '1 data' : `${n} datas`);
---
<Base titulo="Agenda" tema={temaInicial}>
  <header class="abre" data-tema={atributo(temaInicial)}>
    <h1 class="t-gigante ecoa" data-eco="Agenda">Agenda</h1>
    <p class="t-apoio">
      {proximos.length > 0 ? `${plural(proximos.length)} pela frente` : 'Nenhuma data anunciada no momento'}{primeiroAno && ` e ${passados.length} no arquivo, desde ${primeiroAno}.`}
    </p>
  </header>

  <section class="proximos" aria-labelledby="t-proximos">
    <h2 id="t-proximos" class="titulo-secao" data-anima="sobe">Vem aí</h2>
    {proximos.length > 0
      ? (
        <div class="proximos-grade">
          {proximos.map((e, i) => <CartaoEvento evento={e} principal selo={i === 0 ? 'Próximo evento' : undefined} />)}
        </div>
      )
      : <p class="t-apoio">As próximas aparecem aqui assim que os ingressos abrirem. Enquanto isso, acompanhe pelo <a href={SITE.redes.instagram}>Instagram</a>.</p>}
  </section>

  <div data-tema="sorteio" data-reserva={atributo(TEMAS_DO_SITE[0])}>
    <Faixa texto={`${passados.length} datas desde ${primeiroAno ?? 2009}`} />

    <section class="arquivo" aria-labelledby="t-passados">
      <header class="arquivo-abre">
        <h2 id="t-passados" class="t-gigante ecoa ecoa-direita" data-eco="Já rolou" data-anima="eco">Já rolou</h2>
        <div class="arquivo-fotos">
          <p class="t-apoio">As fotos de todas as edições ficam no Pixieset, separadas por festa.</p>
          <Botao href={SITE.fotos} externo tipo="linha">Fotos no Pixieset</Botao>
        </div>
      </header>

      <!-- Atalho para os anos: fica preso no topo enquanto se rola pelo arquivo -->
      <nav class="anos-nav" aria-label="Anos">
        <ul>
          {lista.map(([ano]) => <li><a href={`#ano-${ano}`} data-ano={ano}>{ano}</a></li>)}
        </ul>
      </nav>

      {lista.map(([ano, eventos]) => (
        <details class="ano" id={`ano-${ano}`} open={abertos.has(ano)}>
          <summary>
            <span class="ano-numero">{ano}</span>
            <span class="ano-conta">{plural(eventos.length)}</span>
            <span class="ano-sinal" aria-hidden="true"></span>
          </summary>
          <div class="ano-corpo">
            {marcosDe(ano).map((m) => (
              <p class="marco"><span aria-hidden="true"></span><strong>{m.titulo}</strong>{m.texto && <em>{m.texto}</em>}</p>
            ))}
            <ul class="linhas">
              {eventos.map((e) => {
                const d = partesDaData(e.data);
                return (
                  <li>
                    <a href={e.url} target="_blank" rel="noopener" data-espia={e.capa ?? ''}>
                      <span class="linha-data">{d.dia} {d.mes}</span>
                      <span class="linha-nome">{e.nome}</span>
                      <span class="linha-local">{e.local ?? ''}</span>
                      {e.capaPequena && <img class="linha-mini" src={e.capaPequena} alt="" loading="lazy" />}
                      <span class="so-leitor"> (abre em outra aba)</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </details>
      ))}

      <p class="arquivo-fim"><Botao href={SITE.fotos} externo tipo="linha">Se ache nas fotos</Botao></p>
      <!-- Capa que acompanha o cursor na lista -->
      <div class="espia-capa" aria-hidden="true"><img alt="" /></div>
    </section>
  </div>
</Base>

<script>
  // A capa do evento acompanha o cursor enquanto ele passa pela lista.
  const espia = document.querySelector<HTMLElement>('.espia-capa');
  const imagem = espia?.querySelector('img');
  if (espia && imagem && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.linhas a').forEach((el) => {
      el.addEventListener('pointerenter', () => {
        if (!el.dataset.espia) return;
        imagem.src = el.dataset.espia;
        espia.classList.add('visivel');
      });
      el.addEventListener('pointerleave', () => espia.classList.remove('visivel'));
      el.addEventListener('pointermove', (e) => {
        espia.style.setProperty('--x', `${e.clientX}px`);
        espia.style.setProperty('--y', `${e.clientY}px`);
        espia.style.setProperty('--giro', `${Math.max(-8, Math.min(8, e.movementX * 0.6))}deg`);
      });
    });
  }

  // Atalho de anos: marca o ano que está na tela e abre o ano clicado.
  const atalhos = [...document.querySelectorAll<HTMLAnchorElement>('.anos-nav a')];
  const blocos = [...document.querySelectorAll<HTMLDetailsElement>('details.ano')];
  for (const a of atalhos) {
    a.addEventListener('click', () => {
      const bloco = document.getElementById(`ano-${a.dataset.ano}`) as HTMLDetailsElement | null;
      if (bloco) bloco.open = true;
    });
  }
  if (blocos.length > 0) {
    const marca = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          for (const a of atalhos) {
            const atual = `ano-${a.dataset.ano}` === e.target.id;
            a.toggleAttribute('aria-current', atual);
            if (atual) a.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          }
        }
      },
      { rootMargin: '-25% 0px -70% 0px' },
    );
    blocos.forEach((b) => marca.observe(b));
  }
</script>

<style>
  .abre .t-apoio { margin-top: var(--e-3); }

  .proximos { padding: var(--e-4) var(--margem) var(--e-5); }
  .proximos-grade { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--e-3); }
  @media (max-width: 1000px) { .proximos-grade { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .proximos-grade { grid-template-columns: 1fr; } }

  .arquivo { position: relative; isolation: isolate; padding: var(--e-6) var(--margem); }
  .arquivo-abre { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--e-4); align-items: end; margin-bottom: var(--e-5); }
  .arquivo-fotos { display: grid; gap: var(--e-3); justify-items: start; padding-bottom: 0.6em; }
  @media (max-width: 820px) { .arquivo-abre { grid-template-columns: 1fr; } }

  /* Atalho de anos: uma fila que rola para o lado, presa no topo */
  .anos-nav { position: sticky; top: 0; z-index: 5; margin: 0 calc(var(--margem) * -1); padding: 0.9rem var(--margem); background: var(--fundo); border-bottom: 1.5px solid var(--texto); }
  .anos-nav ul { display: flex; gap: clamp(1rem, 2.4vw, 2.25rem); overflow-x: auto; scrollbar-width: none; }
  .anos-nav ul::-webkit-scrollbar { display: none; }
  .anos-nav a { position: relative; display: block; padding-left: 0.9em; font-size: clamp(0.875rem, 1.05vw, 1rem); font-weight: 800; letter-spacing: 0.08em; text-decoration: none; transition: color 0.2s; }
  .anos-nav a::before { content: ''; position: absolute; left: 0.2em; top: 50%; width: 0.36em; height: 1.45em; margin-top: -0.725em; background: var(--destaque); transform: skewX(26.5deg) scaleY(0); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .anos-nav a:hover, .anos-nav a[aria-current] { color: var(--destaque); }
  .anos-nav a:hover::before, .anos-nav a[aria-current]::before { transform: skewX(26.5deg) scaleY(1); }

  /* Cada ano: o número gigante é o título e também o botão que abre e fecha */
  .ano { border-bottom: 1.5px solid var(--texto); scroll-margin-top: 3.5rem; }
  .ano summary { display: flex; align-items: baseline; gap: var(--e-3); padding: var(--e-3) 0 var(--e-2); cursor: pointer; list-style: none; }
  .ano summary::-webkit-details-marker { display: none; }
  .ano-numero { font-size: clamp(3.5rem, 12vw, 11rem); font-weight: 800; line-height: 0.84; letter-spacing: -0.05em; transition: color 0.3s; }
  .ano summary:hover .ano-numero { color: var(--destaque); }
  .ano-conta { font-size: var(--t-3); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  /* O sinal de abrir é o anel do "@": gira e fecha a abertura quando o ano está aberto */
  .ano-sinal { align-self: center; flex: none; width: clamp(1.75rem, 3vw, 2.75rem); aspect-ratio: 1; margin-left: auto; border: 0.22em solid currentColor; border-radius: 50%; border-left-color: transparent; font-size: clamp(0.8rem, 1.2vw, 1.1rem); transform: rotate(-45deg); transition: transform 0.6s cubic-bezier(0.62, 0.05, 0.01, 0.99), border-color 0.3s; }
  .ano[open] .ano-sinal { transform: rotate(135deg); border-left-color: currentColor; }
  .ano-corpo { padding-bottom: var(--e-4); }

  /* Marco do ano: entra antes da lista, com a barra do logo */
  .marco { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.8em; margin: var(--e-2) 0 var(--e-3); color: var(--destaque); font-size: var(--t-4); line-height: 1.05; }
  .marco span { align-self: center; flex: none; width: 0.18em; height: 0.8em; background: currentColor; transform: skewX(26.5deg); }
  .marco strong { font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase; }
  .marco em { font-size: var(--t-apoio); font-style: normal; color: var(--texto); }

  /* Lista de eventos: uma linha por data. A capa passa por trás dos nomes. */
  .linhas li { border-top: 1px solid var(--linha); }
  .linhas a { position: relative; z-index: 2; display: grid; grid-template-columns: 6.5rem minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--e-3); align-items: baseline; padding: 0.7rem 0; text-decoration: none; transition: padding 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s; }
  .linhas a:hover, .linhas a:focus-visible { padding-left: 0.9rem; color: var(--destaque); }
  .linha-data { font-size: 0.9375rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .linha-nome { font-size: var(--t-3); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; text-transform: uppercase; }
  .linha-local { font-size: 0.9375rem; color: var(--suave); }
  .linhas a:hover .linha-local { color: inherit; }
  .linha-mini { display: none; }
  @media (max-width: 720px) {
    /* No celular não existe hover: a capa vira miniatura ao lado */
    .linhas a { grid-template-columns: 4.75rem minmax(0, 1fr); grid-template-areas: 'mini data' 'mini nome' 'mini local'; gap: 0.15rem 0.9rem; align-items: start; }
    .linha-mini { display: block; grid-area: mini; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.4rem; margin-top: 0.2rem; }
    .linha-data { grid-area: data; font-size: 0.8125rem; }
    .linha-nome { grid-area: nome; }
    .linha-local { grid-area: local; font-size: 0.8125rem; }
  }

  .arquivo-fim { margin-top: var(--e-5); text-align: right; }

  .espia-capa { position: fixed; left: 0; top: 0; z-index: 1; width: clamp(15rem, 24vw, 24rem); aspect-ratio: 16 / 9; overflow: hidden; border-radius: clamp(0.6rem, 1.2vw, 1rem); background: var(--texto); box-shadow: 0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.55); pointer-events: none; opacity: 0; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(0.85); transition: opacity 0.2s, transform 0.18s ease-out; }
  .espia-capa.visivel { opacity: 1; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(1); }
  .espia-capa img { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .anos-nav a::before, .ano-sinal, .linhas a, .espia-capa { transition: none; } }
</style>
