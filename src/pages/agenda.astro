---
import Base from '../layouts/Base.astro';
import CardEvento from '../components/CardEvento.astro';
import { SITE } from '../config';
import { getEventos } from '../lib/eventos';
const { proximos, passados } = await getEventos();
---
<Base titulo="Agenda">
  <h1>Agenda</h1>
  {proximos.length > 0
    ? <ul class="grade">{proximos.map((e) => <li><CardEvento evento={e} /></li>)}</ul>
    : <p>Nenhuma data anunciada no momento. Acompanhe pelo <a href={SITE.redes.instagram}>Instagram</a>.</p>}

  <h2>Eventos passados</h2>
  <p>As fotos de todas as edições estão no Pixieset.</p>
  <a class="botao" href={SITE.fotos} target="_blank" rel="noopener">Ver fotos ↗</a>
  <ul class="grade" style="margin-top:1.5rem">{passados.map((e) => <li><CardEvento evento={e} passado /></li>)}</ul>
</Base>
