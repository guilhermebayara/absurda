---
// Página de um projeto.
//
// Estrutura comum a todos, nesta ordem. Cada bloco só aparece quando o projeto tem o que mostrar,
// então uma página pode ficar incompleta sem parecer quebrada:
// 1. Abertura: nome, resumo e a ficha (desde quando, quantas edições, situação). Com foto de
//    capa, a abertura vira um cartão com a foto e o texto por cima dela.
// 2. Próxima data: os eventos marcados daquele projeto, vindos da Agenda.
// 3. O texto do projeto (o corpo do arquivo em src/content/projetos).
// 4. Edições históricas (campo "historicas"): as que marcaram, com uma linha dizendo por quê.
// 5. Edições especiais (campo "especiais"): séries que não viraram projeto. Hoje, só a @bsurda.
//    (As históricas vêm antes das especiais: pedido do Gui.)
// 6. Histórico: projeto de poucas edições mostra todas; projeto de muitas mostra a conta por
//    ano e manda para a Agenda. A @bsurda não repete a Agenda aqui.
// 7. Quem faz e o próximo projeto.
//
// Personalização por projeto (do Gui): a base é comum, mas cada projeto pode pedir blocos
// próprios. Eles entram entre o texto e o histórico, por campos novos no arquivo do projeto.
import Base from '../../layouts/Base.astro';
import Capa from '../../components/Capa.astro';
import Botao from '../../components/Botao.astro';
import CartaoEvento from '../../components/CartaoEvento.astro';
import { getCollection, getEntries, render } from 'astro:content';
import { atributo } from '../../lib/temas';
import ElencoWig from '../../components/ElencoWig.astro';
import EventosWig from '../../components/EventosWig.astro';
import { getEventos } from '../../lib/eventos';
import { foto } from '../../lib/imagens';
import { resumoDoProjeto, edicoesDoProjeto, daEspecial, ehPrima, proximoTrio, temasDoProjeto } from '../../lib/projetos';
import { partesDaData } from '../../lib/eventos';
import { eventosArredondados } from '../../lib/historia';

export async function getStaticPaths() {
  const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return projetos.map((projeto, i) => ({
    params: { id: projeto.id },
    props: { projeto, seguinte: projetos[(i + 1) % projetos.length] },
  }));
}
const { projeto, seguinte } = Astro.props;
const { Content } = await render(projeto);
const pessoas = await getEntries(projeto.data.pessoas);
const rotulos = { ativo: '', 'em-elaboracao': 'Em elaboração', arquivo: 'Projeto adormecido', independente: 'Hoje independente' };
// Temas do projeto (da foto de capa ou da paleta dele). A página sorteia um a cada visita.
const temas = await temasDoProjeto(projeto.id, projeto.data.capa);
const temaSeguinte = (await temasDoProjeto(seguinte.id, seguinte.data.capa))[0];
const capa = projeto.data.capa;

const eventos = await getEventos();
const r = resumoDoProjeto(projeto.id, eventos);
const ehFesta = projeto.id === 'absurda';
// Conta da ficha (do Gui). A festa mostra o mesmo número arredondado do Sobre ("+400"); a WIG soma
// os eventos só dela (ver edicoesDoProjeto).
const edicoes = edicoesDoProjeto(projeto.id, r);
const desde = projeto.data.desde ?? r.desde;
const ate = r.porAno.length > 0 ? r.porAno[r.porAno.length - 1].ano : undefined;
const parado = projeto.data.situacao === 'arquivo';
const dia = (iso: string) => new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Sao_Paulo' }).replace(/\./g, '').replace(/ de /g, ' ');

const especiais = projeto.data.especiais.map((s) => {
  const edicoes = eventos.passados.filter((e) => daEspecial(s.filtro, e)).reverse();
  const anos = [...new Set(edicoes.map((e) => e.data.slice(0, 4)))];
  return { ...s, edicoes, periodo: anos.length === 0 ? '' : anos.length === 1 ? anos[0] : `${anos[0]} a ${anos[anos.length - 1]}` };
});
const historicas = projeto.data.historicas.flatMap((h) => {
  const e = eventos.passados.find((evento) => evento.id === h.evento);
  return e ? [{ ...h, e }] : [];
});
// Histórico. Cada projeto pode pedir um desenho (campo "historico"); sem pedido, até doze
// edições cabe a lista inteira e, acima disso, a conta por ano.
const modo = projeto.data.historico;
const listaInteira = !ehFesta && !modo && r.passados.length > 0 && r.passados.length <= 12;
const contaPorAno = !ehFesta && !modo && r.passados.length > 12;
const maior = Math.max(1, ...r.porAno.map((a) => a.n));
// Por ano, do mais recente para o mais antigo, com os eventos do ano em ordem de data.
const anos = [...r.porAno].reverse().map((a) => {
  const doAno = r.passados.filter((e) => e.data.startsWith(a.ano)).reverse();
  // "5ª Parada", "6 Parada": o número da edição, quando o título traz.
  const numero = doAno.map((e) => e.nome.match(/(\d+)\s*ª?\s*parada/i)?.[1]).find(Boolean);
  return { ano: a.ano, eventos: doAno, numero };
});
// Histórico anual com subeventos: junta os eventos da Agenda com a programação que não passou
// por ela (campo "programacao"), e escolhe uma imagem para o ano.
const programacao = projeto.data.programacao;
const anosSub = [...new Set([...anos.map((a) => a.ano), ...programacao.map((g) => g.ano)])].sort().reverse().map((ano) => {
  const daAgenda = anos.find((a) => a.ano === ano);
  const extra = programacao.find((g) => g.ano === ano);
  const comCapa = daAgenda?.eventos.find((e) => e.capaPequena || e.capa);
  // A linha que resume as lives fica só na Agenda: aqui a programação completa já diz tudo.
  const itens = extra?.itens ?? [];
  return { ano, eventos: (daAgenda?.eventos ?? []).filter((e) => !(e.lives && itens.length > 0)), itens, numero: extra?.numero ?? daAgenda?.numero, arte: extra?.arte ?? comCapa?.capaPequena ?? comCapa?.capa };
});
const tituloHistorico = projeto.data.tituloHistorico ?? 'Histórico';
// Capas das edições especiais: a versão grande do arquivo pelo foto(), e não a -p de 240 px, que
// aparecia borrada (escolha do Gui, 23 nov 2026). Medida da caixa: clamp(9.5rem, 15vw, 13rem), quadrada
// (caixa: 1, para a capa deitada vir larga o bastante para o recorte). Capa do Sympla (evento escrito à
// mão) fica na -xs, de 600 px: a -lg tem 1.400.
const tamanhoEspecial = '(max-width: 1013px) 9.5rem, (max-width: 1386px) 15vw, 13rem';
const capaEspecial = (e: { capa?: string; capaPequena?: string }) => (e.capa && !e.capa.includes('images.sympla.com.br') ? e.capa : (e.capaPequena ?? e.capa));
const primasConfig = projeto.data.primas;
const primas = primasConfig ? eventos.passados.filter((e) => ehPrima(primasConfig.filtro, e)) : [];
// Trio sem data anunciada: a próxima saída sai da regra do calendário.
const saidaDoTrio = projeto.id === 'bloco' && r.proximos.length === 0 ? partesDaData(proximoTrio()) : null;
const anoDaSaida = saidaDoTrio ? new Date(proximoTrio()).getUTCFullYear() : null;
---
<Base titulo={projeto.data.nome} descricao={projeto.data.resumo} temas={temas} imagem={projeto.data.capa}>
  <header class:list={['abre', 'abre-cima', { 'abre-foto': capa }]} data-tema="sorteio" data-reserva={atributo(temas[0])} data-temas={temas.map(atributo).join(';')}>
    <div class="abre-cartao">
      {capa && <img class="abre-imagem" {...foto(capa)} alt="" fetchpriority="high" style={projeto.data.foco ? `object-position:${projeto.data.foco}` : undefined} />}
      <div class="abre-texto">
        {rotulos[projeto.data.situacao] && <p class="etiqueta">{rotulos[projeto.data.situacao]}</p>}
        {capa
          ? <h1 class="t-gigante">{projeto.data.nome}</h1>
          : <h1 class="t-gigante ecoa ecoa-cima" data-eco={projeto.data.nome}>{projeto.data.nome}</h1>}
        <p class="t-apoio">{projeto.data.resumo}</p>
        <dl class="ficha">
          {desde && !parado && <div><dt>Desde</dt><dd>{desde}</dd></div>}
          {desde && parado && <div><dt>Período</dt><dd>{desde === ate || !ate ? desde : `${desde} a ${ate}`}</dd></div>}
          {ehFesta && <div><dt>Eventos</dt><dd>+{eventosArredondados}</dd></div>}
          {!ehFesta && edicoes > 0 && <div><dt>Edições</dt><dd>{edicoes}</dd></div>}
          {/* Links do projeto fora do site: texto, do mesmo peso, sem ícone (como na ficha de pessoa). */}
          {projeto.data.links.length > 0 && (
            <div class="ficha-links"><dt>Links</dt><dd>{projeto.data.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.rotulo}<span class="so-leitor"> (abre em outra aba)</span></a>)}</dd></div>
          )}
        </dl>
      </div>
    </div>
  </header>
  {projeto.data.arcoiris && <div class="arcoiris" aria-hidden="true"></div>}

  {r.proximos.length > 0 && (
    <section class="bloco" aria-labelledby="t-proxima">
      <h2 id="t-proxima" class="titulo-secao" data-anima="sobe">{r.proximos.length > 1 ? 'Próximas datas' : 'Próxima data'}</h2>
      <div class="proximas">
        {r.proximos.slice(0, 3).map((e) => <CartaoEvento evento={e} principal />)}
      </div>
      {r.proximos.length > 3 && <p class="bloco-fim"><Botao href="/agenda" tipo="linha">Agenda completa</Botao></p>}
    </section>
  )}

  {saidaDoTrio && (
    <section class="bloco" aria-labelledby="t-proxima">
      <h2 id="t-proxima" class="titulo-secao" data-anima="sobe">Próxima data</h2>
      <p class="saida" data-anima="surge">{saidaDoTrio.semana.slice(0, 3)}, {saidaDoTrio.dia} {saidaDoTrio.mes} {anoDaSaida}</p>
      <p class="t-apoio bloco-texto" data-anima="surge">O Trio sai sempre no domingo antes do domingo de carnaval. Pode anotar.</p>
    </section>
  )}


  <div class="conteudo prosa">
    <Content />
    {projeto.data.fora && <p><Botao href={projeto.data.fora.url} externo>{projeto.data.fora.rotulo}</Botao></p>}
  </div>

  {/* A WIG mostra quem a faz, em crachás da WIG, antes das edições com a @bsurda e no lugar do
      "Quem faz" dos outros projetos (pedido do Gui). */}
  {projeto.id === 'wig' && <ElencoWig />}
  {/* Os projetos da WIG, com as datas de cada um. Os eventos só dela não entram na Agenda (pedido do Gui). */}
  {projeto.id === 'wig' && <EventosWig />}

  {historicas.length > 0 && (
    <section class="bloco" aria-labelledby="t-historicas">
      <h2 id="t-historicas" class="t-secao" data-anima="sobe">Edições históricas</h2>
      <ul class="historicas">
        {historicas.map((h, i) => (
          <li data-anima="surge" style={`--i:${i}`}>
            <a class="historica-capa" href={h.e.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><Capa src={h.e.capa} inteira proporcao="16 / 9" /></a>
            <p class="historica-data">{dia(h.e.data)}{h.e.local && <span>{h.e.local}</span>}</p>
            <h3 class="historica-nome"><a href={h.e.url} target="_blank" rel="noopener">{h.e.nome}<span class="so-leitor"> (abre em outra aba)</span></a></h3>
            <p class="historica-porque">{h.porque}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {especiais.length > 0 && (
    <section class="bloco" aria-labelledby="t-especiais">
      <h2 id="t-especiais" class="t-secao" data-anima="sobe">Edições especiais</h2>
      <p class="t-apoio bloco-texto" data-anima="surge">Não viraram projeto, mas viraram nome (e saudade).</p>
      <ul class="especiais">
        {especiais.map((s) => (
          <li class="especial" data-anima="surge">
            <div class="especial-cabeca">
              <h3 class="t-grande">{s.nome}</h3>
              <p class="especial-dados">{s.periodo}{s.edicoes.length > 0 && <span>{s.edicoes.length} {s.edicoes.length === 1 ? 'edição' : 'edições'}</span>}</p>
              {s.texto && <p class="especial-texto">{s.texto}</p>}
            </div>
            {s.edicoes.length > 0 && (
              <ul class="especial-capas">
                {s.edicoes.map((e) => (
                  <li>
                    {/* Edição sem link (sem álbum nem página de ingresso): só a capa e o nome. */}
                    {e.url ? (
                      <a href={e.url} target="_blank" rel="noopener">
                        {e.capaPequena || e.capa ? <img {...foto(capaEspecial(e), tamanhoEspecial, { caixa: 1 })} alt="" loading="lazy" /> : <span class="sem-capa" aria-hidden="true">@</span>}
                        <span class="especial-legenda">{e.nome}<span>{dia(e.data)}</span><span class="so-leitor"> (abre em outra aba)</span></span>
                      </a>
                    ) : (
                      <div class="especial-sem-link">
                        {e.capaPequena || e.capa ? <img {...foto(capaEspecial(e), tamanhoEspecial, { caixa: 1 })} alt="" loading="lazy" /> : <span class="sem-capa" aria-hidden="true">@</span>}
                        <span class="especial-legenda">{e.nome}<span>{dia(e.data)}</span></span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(listaInteira || contaPorAno || (modo && (anos.length > 0 || programacao.length > 0))) && (
    <section class="bloco" aria-labelledby="t-historico">
      <h2 id="t-historico" class="t-secao" data-anima="sobe">{tituloHistorico}</h2>
      {listaInteira && (
        <ul class="edicoes">
          {r.passados.map((e) => (
            <li data-anima="surge">
              <a href={e.url} target="_blank" rel="noopener">
                <span class="edicao-data">{dia(e.data)}</span>
                <strong>{e.nome}</strong>
                <span>{e.local ?? ''}<span class="so-leitor"> (abre em outra aba)</span></span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {modo === 'anual' && (
        <ul class="anuais">
          {anos.flatMap((a) => a.eventos.map((e) => ({ ano: a.ano, e }))).map(({ ano, e }, i) => (
            <li data-anima="surge" style={`--i:${i % 4}`}>
              <a href={e.url} target="_blank" rel="noopener">
                <span class="anual-ano">{ano}</span>
                {e.capaPequena || e.capa
                  ? <img {...foto(e.capa ?? e.capaPequena, '(max-width: 1000px) 45vw, 16rem')} alt="" loading="lazy" />
                  : <span class="anual-sem-capa" aria-hidden="true">@</span>}
                <strong>{e.nome}</strong>
                {e.local && <span class="anual-local">{e.local}</span>}
                <span class="so-leitor"> (abre em outra aba)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {modo === 'anual-sub' && (
        <div class="anos">
          {anosSub.map((a) => (
            <div class="ano" data-anima="surge">
              <div class="ano-cabeca">
                <h3 class="ano-numero">{a.ano}{a.numero && <span>{a.numero}ª edição</span>}</h3>
                {a.arte && <img class="ano-arte" {...foto(a.arte, '(max-width: 720px) 40vw, 14rem')} alt="" loading="lazy" />}
              </div>
              <ul class="ano-eventos">
                {a.eventos.map((e) => (
                  e.url
                    ? <li><a href={e.url} target="_blank" rel="noopener"><span class="edicao-data">{dia(e.data).slice(0, 6)}</span><strong>{e.nome}</strong><span>{e.local ?? ''}<span class="so-leitor"> (abre em outra aba)</span></span></a></li>
                    : <li><p><span class="edicao-data">{dia(e.data).slice(0, 6)}</span><strong>{e.nome}</strong><span>{e.local ?? ''}</span></p></li>
                ))}
                {a.itens.length > 0 && a.eventos.length > 0 && <li class="ano-rotulo">Programação completa</li>}
                {a.itens.map((i) => (
                  <li class="ano-item"><p><span class="edicao-data">{i.quando}</span><strong>{i.nome}</strong><span>{i.local ?? ''}</span></p></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
      {contaPorAno && (
        <div class="conta" data-conta>
          <p class="t-apoio bloco-texto" data-anima="surge">Toque num ano para ver as edições.</p>
          <ul class="por-ano" data-anima="surge">
            {r.porAno.map((a, i) => (
              <li style={`--p:${a.n / maior}`}>
                <button type="button" aria-pressed={i === r.porAno.length - 1 ? 'true' : 'false'} data-ano={a.ano}>
                  <strong>{a.n}</strong><span>{a.ano}</span><span class="so-leitor"> {a.n === 1 ? 'edição' : 'edições'}</span>
                </button>
              </li>
            ))}
          </ul>
          {anos.map((a, i) => (
            <div class="conta-ano" data-painel={a.ano} hidden={i !== 0}>
              <h3 class="conta-titulo">{a.ano}<span>{a.eventos.length} {a.eventos.length === 1 ? 'edição' : 'edições'}</span></h3>
              <ul class="edicoes">
                {a.eventos.map((e) => (
                  <li><a href={e.url} target="_blank" rel="noopener"><span class="edicao-data">{dia(e.data).slice(0, 6)}</span><strong>{e.nome}</strong><span>{e.local ?? ''}<span class="so-leitor"> (abre em outra aba)</span></span></a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  {primas.length > 0 && (
    <section class="bloco" aria-labelledby="t-primas">
      <h2 id="t-primas" class="t-secao" data-anima="sobe">{primasConfig?.titulo}</h2>
      {primasConfig?.texto && <p class="t-apoio bloco-texto" data-anima="surge">{primasConfig.texto}</p>}
      <ul class="edicoes">
        {primas.map((e) => (
          <li data-anima="surge">
            <a href={e.url} target="_blank" rel="noopener">
              <span class="edicao-data">{dia(e.data)}</span>
              <strong>{e.nome}</strong>
              <span>{e.local ?? ''}<span class="so-leitor"> (abre em outra aba)</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {ehFesta && (
    <section class="bloco" aria-labelledby="t-historico">
      <h2 id="t-historico" class="t-secao" data-anima="sobe">Histórico</h2>
      <p class="t-apoio bloco-texto" data-anima="surge">Todas as edições, desde a primeira, estão na Agenda. Bora relembrar?</p>
      <p class="bloco-fim"><Botao href="/agenda">Abrir a Agenda</Botao></p>
    </section>
  )}

  {projeto.id !== 'wig' && pessoas.length > 0 && (
    <section class="secao" aria-labelledby="t-quem">
      <h2 id="t-quem" class="titulo-secao">Quem faz</h2>
      <ul class="grade">
        {pessoas.map((p) => (
          <li><a class="card" href={`/equipe/${p.id}`}><Capa src={p.data.foto} tamanho="(max-width: 1000px) 45vw, 16rem" /><h3>{p.data.nome}</h3><p>{p.data.funcao}</p></a></li>
        ))}
      </ul>
    </section>
  )}

  <a class="seguinte" href={`/projetos/${seguinte.id}`} data-tema={atributo(temaSeguinte)}>
    <span class="etiqueta">Próximo projeto</span>
    <span class="t-gigante">{seguinte.data.nome}</span>
  </a>
</Base>

<script>
  // Conta por ano: cada coluna é um botão que mostra as edições daquele ano logo abaixo.
  // Sem script, o ano mais recente já vem aberto e os outros ficam na Agenda.
  document.querySelectorAll<HTMLElement>('[data-conta]').forEach((conta) => {
    const botoes = conta.querySelectorAll<HTMLButtonElement>('button[data-ano]');
    const paineis = conta.querySelectorAll<HTMLElement>('[data-painel]');
    botoes.forEach((botao) => botao.addEventListener('click', () => {
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
      paineis.forEach((p) => { p.hidden = p.dataset.painel !== botao.dataset.ano; });
    }));
  });
</script>

<style>
  .abre .etiqueta { margin-bottom: 0.75rem; }
  .t-secao { font-size: clamp(2.75rem, 9.5vw, 8.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }
  /* Abertura com foto: um cartão, com a foto cobrindo tudo e o texto por cima, na parte de
     baixo. O degradê escuro garante a leitura do texto claro sobre qualquer foto. */
  .abre-foto .abre-cartao { position: relative; display: grid; align-items: end; min-height: clamp(26rem, 78svh, 54rem); overflow: hidden; border-radius: clamp(1rem, 2.5vw, 2.25rem); color: #fff; }
  .abre-imagem { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .abre-foto .abre-texto { position: relative; padding: 22svh clamp(1.1rem, 3vw, 3rem) clamp(1.25rem, 3vw, 3rem); background: linear-gradient(to top, rgb(13 10 12 / 0.92), rgb(13 10 12 / 0.6) 55%, transparent); }
  .abre-foto .t-apoio { margin-top: var(--e-2); }
  .abre-foto { padding-bottom: var(--e-4); }
  .seguinte { display: grid; gap: 1rem; padding: clamp(3.5rem, 9vw, 8rem) var(--margem); border-top: 1px solid var(--linha); text-decoration: none; }
  .seguinte:hover .t-gigante { text-decoration: underline; text-decoration-thickness: 0.04em; }

  /* Parada: um fio de arco-íris logo abaixo da abertura. É o único arco-íris da página. */
