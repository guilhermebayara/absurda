---
// Página Projetos.
//
// Cada projeto em atividade ocupa uma faixa alta, e a página inteira troca para as cores dele
// quando a faixa chega ao meio da tela (data-tema, o mesmo mecanismo da Agenda). A ordem é a
// do campo "ordem", definida pelo Gui pela prioridade na agenda da festa.
// Em cada faixa: nome, resumo, desde quando existe, quantas edições a Agenda registra e a
// próxima data, quando há uma marcada.
// No fim, em linhas compactas, os projetos adormecidos e os que seguiram caminho próprio.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Botao from '../../components/Botao.astro';
import { getEventos, partesDaData } from '../../lib/eventos';
import { resumoDoProjeto, proximoTrio } from '../../lib/projetos';
import { atributo, temaPara } from '../../lib/temas';

const eventos = await getEventos();
const projetos = (await getCollection('projetos'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((p) => ({ ...p, r: resumoDoProjeto(p.id, eventos) }));
const vivos = projetos.filter((p) => p.data.situacao === 'ativo' || p.data.situacao === 'em-elaboracao');
const adormecidos = projetos.filter((p) => p.data.situacao === 'arquivo');
const independentes = projetos.filter((p) => p.data.situacao === 'independente');
const quando = (iso: string) => { const d = partesDaData(iso); return `${d.semana.slice(0, 3)}, ${d.dia} ${d.mes}`; };
const periodo = (r: { porAno: { ano: string }[] }) => {
  const a = r.porAno.map((x) => x.ano);
  return a.length === 0 ? '' : a[0] === a[a.length - 1] ? a[0] : `${a[0]} a ${a[a.length - 1]}`;
};
---
<Base titulo="Projetos">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Projetos">Projetos</h1>
    <p class="t-apoio">Texto de marcação: uma frase sobre tudo o que a @bsurda faz além da festa.</p>
  </header>

  {vivos.map((p) => {
    const desde = p.data.desde ?? p.r.desde;
    const proxima = p.r.proximos[0]?.data ?? (p.id === 'bloco' ? proximoTrio() : undefined);
    return (
      <article class="faixa" data-tema={atributo(temaPara(p.id))}>
        {p.data.situacao === 'em-elaboracao' && <p class="etiqueta" data-anima="surge">Em elaboração</p>}
        <h2 class="t-gigante" data-anima="sobe"><a href={`/projetos/${p.id}`}>{p.data.nome}</a></h2>
        <div class="faixa-pe" data-anima="surge">
          <p class="t-apoio">{p.data.resumo}</p>
          <dl class="ficha">
            {desde && <div><dt>Desde</dt><dd>{desde}</dd></div>}
            {p.id !== 'absurda' && p.r.passados.length > 0 && <div><dt>Edições</dt><dd>{p.r.passados.length}</dd></div>}
            {proxima && <div><dt>Próxima data</dt><dd>{quando(proxima)}</dd></div>}
          </dl>
          <Botao href={`/projetos/${p.id}`}>Conhecer<span class="so-leitor"> {p.data.nome}</span></Botao>
        </div>
      </article>
    );
  })}

  <section class="outros" aria-labelledby="t-outros">
    <h2 id="t-outros" class="t-secao" data-anima="sobe">Também são da casa</h2>
    {[{ titulo: 'Adormecidos', lista: adormecidos }, { titulo: 'Seguiram caminho próprio', lista: independentes }].filter((g) => g.lista.length > 0).map((g) => (
      <div class="grupo">
        <h3 class="etiqueta" data-anima="surge">{g.titulo}</h3>
        <ul class="linhas">
          {g.lista.map((p) => (
            <li data-anima="surge">
              <a href={`/projetos/${p.id}`}>
                <strong>{p.data.nome}</strong>
                <span>{p.data.resumo}</span>
                <span class="linha-periodo">{p.data.situacao === 'arquivo' ? periodo(p.r) : p.r.desde ? `Desde ${p.r.desde}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>

<style>
  .abre .t-apoio { margin-top: var(--e-2); }
  .t-secao { font-size: clamp(2.75rem, 9.5vw, 8.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }

  /* Faixa de projeto: alta, com o nome em cima e o resto embaixo, para a troca de cores da
     página acontecer com uma faixa de cada vez na tela. */
  .faixa { display: grid; grid-template-rows: auto 1fr; align-content: start; gap: var(--e-3); min-height: min(88svh, 56rem); padding: var(--e-5) var(--margem); border-top: 2px solid var(--texto); }
  .faixa .etiqueta { grid-row: 1; }
  .faixa h2 a { text-decoration: none; }
  .faixa h2 a:hover, .faixa h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: 0.05em; text-underline-offset: 0.08em; }
  .faixa-pe { align-self: end; display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--e-3) var(--e-5); align-items: end; }
  .faixa-pe .t-apoio { max-width: 26em; }
  .ficha { display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4); }
  .ficha div { display: grid; gap: 0.4rem; }
  .ficha dt { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .ficha dd { margin: 0; font-size: var(--t-4); font-weight: 800; line-height: 0.95; letter-spacing: -0.035em; text-transform: uppercase; font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* Adormecidos e independentes: linhas compactas. */
  .outros { padding: var(--e-5) var(--margem) var(--e-6); border-top: 2px solid var(--texto); }
  .grupo { margin-top: var(--e-4); }
  .linhas { margin-top: var(--e-2); border-top: 2px solid var(--texto); }
  .linhas a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; gap: 0.35rem var(--e-3); align-items: baseline; padding: var(--e-3) 0; border-bottom: 2px solid var(--texto); text-decoration: none; }
  .linhas strong { font-size: var(--t-5); font-weight: 800; line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; }
  .linhas a:hover strong, .linhas a:focus-visible strong { text-decoration: underline; text-decoration-thickness: 0.05em; text-underline-offset: 0.08em; }
  .linhas span { font-size: 1.0625rem; line-height: 1.35; }
  .linha-periodo { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }

  @media (max-width: 820px) {
    .faixa { min-height: 0; padding-block: var(--e-5); }
    .faixa-pe { grid-template-columns: 1fr; align-items: start; }
    .linhas a { grid-template-columns: 1fr; }
  }
</style>
