---
import Base from '../../layouts/Base.astro';
import Capa from '../../components/Capa.astro';
import { getCollection } from 'astro:content';
import Botao from '../../components/Botao.astro';
const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const rotulos = { ativo: '', 'em-elaboracao': 'Em elaboração', arquivo: 'Arquivo' };
---
<Base titulo="Projetos">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Projetos">Projetos</h1>
    <p class="t-apoio">Texto de marcação: uma frase sobre tudo o que a @bsurda faz além da festa.</p>
  </header>

  {projetos.map((p) => (
    <article class="projeto" data-anima="surge">
      <div>
        {rotulos[p.data.situacao] && <p class="etiqueta">{rotulos[p.data.situacao]}</p>}
        <h2 class="t-grande"><a href={`/projetos/${p.id}`}>{p.data.nome}</a></h2>
        <p class="t-apoio">{p.data.resumo}</p>
        <Botao href={`/projetos/${p.id}`}>Conhecer<span class="so-leitor"> {p.data.nome}</span></Botao>
      </div>
      <a href={`/projetos/${p.id}`} tabindex="-1" aria-hidden="true"><Capa src={p.data.capa} proporcao="4 / 3" /></a>
    </article>
  ))}
</Base>

<style>
  .projeto { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(1.5rem, 5vw, 5rem); align-items: center; padding: clamp(3rem, 8vw, 7rem) var(--margem); border-top: 1px solid var(--linha); }
  .projeto > div > * + * { margin-top: 1.25rem; }
  .projeto h2 a { text-decoration: none; }
  .projeto h2 a:hover { text-decoration: underline; text-decoration-thickness: 0.05em; }
  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 720px) { .projeto { grid-template-columns: 1fr; } }
</style>
