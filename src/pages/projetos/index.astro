---
// Página Projetos: um mural de cartazes.
//
// Todos os projetos aparecem juntos, cada um num cartaz nas próprias cores (da foto de capa,
// ou da paleta do projeto). A ordem é a do campo "ordem", definida pelo Gui.
//
// O mural bebe da mesa da Equipe: não é uma grade certinha. No desktop cada cartaz tem lugar e
// tamanho próprios (a @bsurda é o maior; Halloween, Trio e Tibum são retratos, e o do Halloween é o mais alto), as
// colunas terminam em alturas diferentes e cada cartaz fica levemente torto. A informação
// dentro do cartaz é sempre a mesma: nome e ficha. O resumo fica para a página do projeto.
//
// Cartaz com foto: a foto ocupa o cartaz inteiro e o texto fica numa placa embaixo, na cor do
// projeto, meio transparente e com a foto desfocada atrás. A placa tem margem e canto próprios,
// para o texto nunca encostar no canto arredondado do cartaz.
// Adormecidos e independentes ficam embaixo, em cartazes vazados (só contorno).
// As cores rodam: a página sorteia um tema do site, como as outras, e cada cartaz sorteia um
// dos temas do seu projeto, evitando a cor da página e a de um cartaz já sorteado.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getEventos, partesDaData } from '../../lib/eventos';
import { eventosArredondados } from '../../lib/historia';
import { resumoDoProjeto, edicoesDoProjeto, proximoTrio, temasDoProjeto } from '../../lib/projetos';
import { atributo, type Tema } from '../../lib/temas';

const eventos = await getEventos();
const projetos = (await getCollection('projetos'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .map((p) => ({ ...p, r: resumoDoProjeto(p.id, eventos) }));
const vivos = projetos.filter((p) => p.data.situacao === 'ativo' || p.data.situacao === 'em-elaboracao');
const adormecidos = projetos.filter((p) => p.data.situacao === 'arquivo');
const independentes = projetos.filter((p) => p.data.situacao === 'independente');
// Temas de cada projeto (da foto de capa ou da paleta dele). O cartaz abre no primeiro, e o
// script do fim da página sorteia um da lista a cada visita.
const temas: Record<string, Tema[]> = {};
for (const p of projetos) temas[p.id] = await temasDoProjeto(p.id, p.data.capa);
const cores = (id: string) => { const t = temas[id][0]; return `--f:${t.fundo};--t:${t.texto};--d:${t.destaque}`; };
const quando = (iso: string) => { const d = partesDaData(iso); return `${d.semana.slice(0, 3)}, ${d.dia} ${d.mes}`; };
const periodo = (r: { porAno: { ano: string }[] }) => {
  const a = r.porAno.map((x) => x.ano);
  return a.length === 0 ? '' : a[0] === a[a.length - 1] ? a[0] : `${a[0]} a ${a[a.length - 1]}`;
};
---
<Base titulo="Projetos">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Projetos">Projetos</h1>
    <p class="t-apoio">Da festa principal nasceu muita coisa: trio no carnaval, Parada no Orgulho, piscina de dia e festas com nome próprio.</p>
  </header>

  <section class="mural-area" aria-label="Projetos em atividade">
    <ul class="mural mural-vivo">
      {vivos.map((p, i) => {
        const desde = p.data.desde ?? p.r.desde;
        const proxima = p.r.proximos[0]?.data ?? (p.id === 'bloco' ? proximoTrio() : undefined);
        return (
          <li class:list={['cartaz', { 'cartaz-foto': p.data.capa, 'cartaz-arcoiris': p.data.arcoiris }]} style={`${cores(p.id)};--i:${i}`} data-cores={temas[p.id].map(atributo).join(';')} data-anima="surge">
            <a href={`/projetos/${p.id}`}>
              {p.data.capa && <img class="cartaz-imagem" src={p.data.capa} alt="" loading="lazy" style={p.data.foco ? `object-position:${p.data.foco}` : undefined} />}
              {(p.data.situacao === 'em-elaboracao' || proxima) && (
                <p class="cartaz-aviso">{p.data.situacao === 'em-elaboracao' ? 'Em elaboração' : `Próxima: ${quando(proxima)}`}</p>
              )}
              {!p.data.capa && <i class="cartaz-barra" aria-hidden="true"></i>}
              <div class="cartaz-placa">
                <h2 class="cartaz-nome">{p.data.nome}</h2>
                <p class="cartaz-ficha">
                  {desde && <span>Desde {desde}</span>}
                  {p.id === 'absurda' && <span>+{eventosArredondados} eventos</span>}
                  {p.id !== 'absurda' && p.r.passados.length > 0 && <span>{p.r.passados.length} {p.r.passados.length === 1 ? 'edição' : 'edições'}</span>}
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {/* Fim da página: uma faixa só, com dois grupos lado a lado no desktop. A WIG fica do tamanho
      de um cartaz comum (nunca maior que os projetos vivos), sólida e com foto; os adormecidos ao lado,
      vazados. */}
  <div class="fim-mural">
  {/* Projeto que hoje é independente mas segue junto (a WIG): cartaz sólido, com foto, como os
      vivos. Não é adormecido, e não pode parecer um (pedido do Gui). */}
  {independentes.length > 0 && (
    <section class="familia" aria-labelledby="t-familia">
      <h2 id="t-familia" class="titulo-secao" data-anima="sobe">{independentes.length === 1 ? 'Também é da casa' : 'Também são da casa'}</h2>
      <ul class="mural mural-familia">
        {independentes.map((p, i) => {
          const desde = p.data.desde ?? p.r.desde;
          const n = edicoesDoProjeto(p.id, p.r);
          return (
            <li class:list={['cartaz', { 'cartaz-foto': p.data.capa }]} style={`${cores(p.id)};--i:${i}`} data-cores={temas[p.id].map(atributo).join(';')} data-anima="surge">
              <a href={`/projetos/${p.id}`}>
                {p.data.capa && <img class="cartaz-imagem" src={p.data.capa} alt="" loading="lazy" style={p.data.foco ? `object-position:${p.data.foco}` : undefined} />}
                <p class="cartaz-aviso">Hoje independente</p>
                {!p.data.capa && <i class="cartaz-barra" aria-hidden="true"></i>}
                <div class="cartaz-placa">
                  <h3 class="cartaz-nome">{p.data.nome}</h3>
                  <p class="cartaz-ficha">
                    {desde && <span>Desde {desde}</span>}
                    {n > 0 && <span>{n} {n === 1 ? 'edição' : 'edições'}</span>}
                  </p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {adormecidos.length > 0 && (
    <section class="outros" aria-labelledby="t-outros">
      <h2 id="t-outros" class="titulo-secao" data-anima="sobe">Adormecidos</h2>
      <ul class="mural mural-vazado">
        {adormecidos.map((p, i) => (
          <li class="cartaz cartaz-vazado" style={`--i:${i}`} data-anima="surge">
            <a href={`/projetos/${p.id}`}>
              <div class="cartaz-placa">
                <h3 class="cartaz-nome">{p.data.nome}</h3>
                <p class="cartaz-ficha"><span>{periodo(p.r)}</span></p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  </div>
</Base>

<script is:inline>
  // Cada cartaz sorteia um dos temas do seu projeto (data-cores). Fica de fora o fundo que a
  // página está usando, para o cartaz não sumir, e o de um cartaz já sorteado, quando há opção.
  (function () {
    // A cor da página está no estilo da raiz (posta pelo sorteio). O valor calculado vem como
    // rgb(), por isso a leitura direta; se faltar, converte.
    var raiz = document.documentElement;
    var pagina = raiz.style.getPropertyValue('--fundo').trim().toLowerCase();
    if (!pagina) {
      var m = getComputedStyle(raiz).getPropertyValue('--fundo').match(/\d+/g);
      if (m) pagina = '#' + m.slice(0, 3).map(function (v) { return ('0' + Number(v).toString(16)).slice(-2); }).join('');
    }
    var usados = [pagina];
    document.querySelectorAll('.cartaz[data-cores]').forEach(function (cartaz) {
      var opcoes = cartaz.dataset.cores.split(';').filter(Boolean);
      var livres = opcoes.filter(function (o) { return usados.indexOf(o.split('|')[0].toLowerCase()) === -1; });
      var lista = livres.length > 0 ? livres : opcoes;
      var t = lista[Math.floor(Math.random() * lista.length)].split('|');
      // Projeto de um tema só que calhou de ser o da página: ganha um contorno para não sumir.
      if (t[0].toLowerCase() === pagina) cartaz.classList.add('cartaz-contorno');
      usados.push(t[0].toLowerCase());
      cartaz.style.setProperty('--f', t[0]);
      cartaz.style.setProperty('--t', t[1]);
      cartaz.style.setProperty('--d', t[2]);
    });
  })();
</script>

<style>
  .abre .t-apoio { margin-top: var(--e-2); }

  .mural-area { padding: var(--e-3) var(--margem) var(--e-5); }
  .mural { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(15rem, auto); gap: clamp(0.7rem, 1.2vw, 1.25rem); }

  /* Cartaz: objeto sólido, nas cores do projeto. --canto é o canto do cartaz e --folga, a
     distância do conteúdo até a borda; a placa de texto usa os dois para ficar concêntrica. */
  .cartaz { --canto: clamp(0.85rem, 1.5vw, 1.35rem); --folga: clamp(0.5rem, 0.8vw, 0.75rem); container-type: inline-size; min-width: 0; rotate: var(--giro, 0deg); translate: 0 var(--sobe, 0); transition: rotate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), translate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cartaz a { position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; padding: var(--folga); border-radius: var(--canto); background: var(--f); color: var(--t); text-decoration: none; overflow: hidden; }
  .cartaz-contorno a { box-shadow: inset 0 0 0 2px var(--t); }
  .cartaz-imagem { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Placa de texto. Sem foto, é transparente e o cartaz inteiro é a cor do projeto. Com foto,
     é a cor do projeto meio transparente, com a foto desfocada atrás. */
  .cartaz-placa { position: relative; display: grid; gap: 0.5rem; padding: clamp(0.7rem, 1.2vw, 1.15rem); border-radius: calc(var(--canto) - var(--folga)); }
  /* 70% é o mínimo que mantém a leitura (4,5:1) no pior caso: placa clara sobre foto escura, ou o contrário. */
  .cartaz-foto .cartaz-placa { background: color-mix(in srgb, var(--f) 70%, transparent); -webkit-backdrop-filter: blur(18px) saturate(1.3); backdrop-filter: blur(18px) saturate(1.3); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .cartaz-foto .cartaz-placa { background: color-mix(in srgb, var(--f) 94%, transparent); } }
  .cartaz-nome { font-size: clamp(1.375rem, 13cqw, 5.5rem); font-weight: 800; line-height: 0.88; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }
  .cartaz-ficha { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-top: 0.55rem; border-top: 2px solid currentColor; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-variant-numeric: tabular-nums; }
  .cartaz-ficha:empty { display: none; }

  /* Aviso no alto (próxima data, em elaboração): uma etiqueta sólida, legível sobre qualquer foto. */
  .cartaz-aviso { position: absolute; top: calc(var(--folga) + 0.15rem); left: calc(var(--folga) + 0.15rem); max-width: calc(100% - 3.5rem); padding: 0.4rem 0.65rem; border-radius: 99rem; background: var(--f); color: var(--t); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; line-height: 1.25; }
  .cartaz:not(.cartaz-foto) .cartaz-aviso { padding-inline: clamp(0.7rem, 1.2vw, 1.15rem) 0; top: calc(var(--folga) + 0.6rem); left: var(--folga); background: none; }
  /* A barra inclinada no canto é enfeite (cor de destaque). */
  .cartaz-barra { position: absolute; top: calc(var(--folga) + 0.7rem); right: calc(var(--folga) + 1.1rem); width: 0.6rem; height: 1.6rem; background: var(--d); transform: skewX(26.5deg); }

  /* Parada: um fio de arco-íris no lugar do fio da ficha. É o único arco-íris do cartaz. */
  .cartaz-arcoiris .cartaz-ficha { border-top: 0; padding-top: 0.85rem; background: linear-gradient(to right, #e40303 0 16.66%, #ff8c00 0 33.33%, #ffed00 0 50%, #008026 0 66.66%, #24408e 0 83.33%, #732982 0) top / 100% 4px no-repeat; }

  .cartaz a:focus-visible { outline: 3px solid var(--texto); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .cartaz:hover, .cartaz:focus-within { rotate: 0deg; translate: 0 calc(var(--sobe, 0rem) - 0.4rem); z-index: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .cartaz { transition: none; } }

  /* Celular: duas colunas, com os dois primeiros de ponta a ponta, e os cartazes quase retos. */
  .mural-vivo .cartaz:nth-child(1) { grid-column: 1 / -1; min-height: 23rem; }
  /* O Halloween é um retrato: ocupa duas linhas da coluna da esquerda, ao lado do Trio e da Parada. */
  .mural-vivo .cartaz:nth-child(2) { grid-row: span 2; }
  .mural-vivo .cartaz:nth-child(1) .cartaz-nome { font-size: clamp(2.5rem, 17cqw, 7rem); }
  .mural-vivo .cartaz:nth-child(4n+1) { --giro: -0.5deg; }
  .mural-vivo .cartaz:nth-child(4n+2) { --giro: 0.4deg; }
  .mural-vivo .cartaz:nth-child(4n+3) { --giro: 0.6deg; }
  .mural-vivo .cartaz:nth-child(4n) { --giro: -0.4deg; }

  /* Hoje independente (a WIG): cartaz sólido, com foto, da altura dos adormecidos. Fica ao lado
     deles no desktop, sem nunca crescer mais que um cartaz comum dos projetos vivos. */
  .fim-mural { display: grid; gap: var(--e-4) clamp(0.7rem, 1.2vw, 1.25rem); padding: var(--e-3) var(--margem) var(--e-6); }
  .fim-mural .mural { margin-top: var(--e-3); }
  .mural-familia { grid-template-columns: minmax(0, 1fr); grid-auto-rows: minmax(13rem, auto); }
  .mural-familia .cartaz { --giro: -0.4deg; }
  /* A placa fica estreita, para a foto aparecer: a WIG se reconhece pelo elenco. */
  .mural-familia .cartaz-placa { max-width: min(100%, 20rem); }
  .mural-familia .cartaz-nome { font-size: clamp(1.75rem, 10cqw, 3.5rem); }

  /* Adormecidos: cartazes vazados, só o contorno, na cor da página. */
  .mural-vazado { grid-auto-rows: minmax(11rem, auto); }
  .cartaz-vazado a { background: none; color: var(--texto); border: 2px dashed var(--texto); }
  .cartaz-vazado .cartaz-nome { font-size: clamp(1.375rem, 13cqw, 4.5rem); }
  .cartaz-vazado:nth-child(odd) { --giro: 0.5deg; }
  .cartaz-vazado:nth-child(even) { --giro: -0.6deg; }

  /* Desktop: o mural. Quatro colunas e linhas baixas; cada cartaz ocupa um bloco próprio.
     As colunas da direita trocam a altura dos cartazes entre si, e os fins de coluna não se
     alinham. Um nono projeto em diante entra sozinho, com três linhas de altura. */
  @media (min-width: 1000px) {
    .mural-vivo { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(3.6rem, 5.4vw, 5.6rem); grid-auto-flow: dense; }
    .mural-vivo .cartaz { grid-row: span 3; min-height: 0; }
    .mural-vivo .cartaz:nth-child(1) { grid-column: 1 / 3; grid-row: 1 / 7; min-height: 0; --giro: -0.7deg; }
    .mural-vivo .cartaz:nth-child(2) { grid-column: 3; grid-row: 1 / 9; --giro: 0.8deg; --sobe: 0.6rem; }
    .mural-vivo .cartaz:nth-child(3) { grid-column: 4; grid-row: 1 / 6; --giro: -1.1deg; }
    .mural-vivo .cartaz:nth-child(4) { grid-column: 4; grid-row: 6 / 10; --giro: 0.9deg; --sobe: 0.5rem; }
    .mural-vivo .cartaz:nth-child(5) { grid-column: 1; grid-row: 7 / 11; --giro: 1deg; }
    .mural-vivo .cartaz:nth-child(6) { grid-column: 2; grid-row: 7 / 13; --giro: -0.8deg; --sobe: 0.4rem; }
    .mural-vivo .cartaz:nth-child(7) { grid-column: 4; grid-row: 10 / 13; --giro: -0.9deg; }
    .mural-vivo .cartaz:nth-child(8) { grid-column: 3; grid-row: 9 / 12; --giro: 0.7deg; --sobe: 0.3rem; }
    .mural-vivo .cartaz:nth-child(1) .cartaz-nome { font-size: clamp(2.5rem, 18cqw, 10rem); }
    .fim-mural { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; }
    .fim-mural > .familia { grid-column: span 2; }
    .fim-mural > .outros { grid-column: span 2; }
    .fim-mural > :only-child { grid-column: 1 / -1; }
    .mural-familia, .mural-vazado { grid-auto-rows: clamp(15rem, 19vw, 19rem); }
    /* A placa da WIG abraça o texto: sem sobra à direita. */
    .mural-familia .cartaz-placa { align-self: flex-start; width: max-content; max-width: 100%; }
    .mural-vazado { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
