---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
const rotulos = { ativo: 'Ativo', 'em-elaboracao': 'Em elaboração', arquivo: 'Arquivo' };
---
<Base titulo="Projetos">
  <h1>Projetos</h1>
  <ul class="grade">
    {projetos.map((p) => (
      <li>
        <a class="card" href={`/projetos/${p.id}`}>
          <div class="img">capa</div>
          <span class="etiqueta">{rotulos[p.data.situacao]}</span>
          <h3>{p.data.nome}</h3>
          <p>{p.data.resumo}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
