---
import Base from '../layouts/Base.astro';
import Capa from '../components/Capa.astro';
import marcos from '../data/marcos.json';
import { TEMAS_DE_POSICAO, TEMAS_DO_SITE, atributo } from '../lib/temas';
const reserva = atributo(TEMAS_DO_SITE[0]);
// Aqui os marcos contam a história na ordem em que aconteceram, do primeiro ano ao atual.
// (Na agenda eles aparecem do mais recente para trás, como índice do arquivo.)
type Marco = { id: string; ano: string; titulo: string; texto?: string; tema?: string };
const porAno = new Map<string, Marco[]>();
for (const m of marcos as Marco[]) porAno.set(m.ano, [...(porAno.get(m.ano) ?? []), m]);
const anosDosMarcos = [...porAno.keys()].sort();
const verbos = ['Ocupamos', 'Carnavalizamos', 'Viramos', 'Desfilamos', 'Estruturamos', 'Renascemos'];
---
<Base titulo="Sobre">
  <header class="abre abre-cima">
    <h1 class="t-gigante ecoa ecoa-cima ecoa-direita" data-eco="Sem frescuras desde 2009">Sem frescuras desde 2009</h1>
    <p class="t-apoio">Texto de marcação com a história da @bsurda.</p>
  </header>

  {verbos.map((v, i) => (
    <section class:list={['verbo', { 'verbo-cor': i % 2 === 1 }]} data-anima="surge">
      <h2 class="t-gigante">{v}</h2>
      <Capa proporcao="16 / 10" />
    </section>
  ))}

  <!-- Marcos: o ano fica preso na tela, gigante, e vira conforme a história passa ao lado.
       Mesmo universo da agenda (número grande, barra inclinada, etiquetas), outra leitura:
       lá é índice que se abre, aqui é uma narrativa contínua. -->
  <section class="marcos" aria-labelledby="t-marcos" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-marcos" class="titulo-secao" data-anima="sobe">Marcos</h2>
    <div class="marcos-grade">
      <div class="marcos-ano" aria-hidden="true">
        <p class="marcos-num">{anosDosMarcos[0].split('').map((d) => <span>{d}</span>)}</p>
        <p class="marcos-conta"><span class="marcos-barra"></span><span class="marcos-idade"></span></p>
      </div>
      <ol class="marcos-lista">
        {anosDosMarcos.map((ano) => (
          <li class="marcos-grupo" data-ano={ano}>
            <h3 class="marcos-rotulo">{ano}</h3>
            <ul>
              {porAno.get(ano)!.map((m) => (
                <li class="marcos-item">
                  <p class="marcos-titulo"><strong>{m.titulo}</strong>{m.tema && <b>{m.tema}</b>}</p>
                  {m.texto && <p class="marcos-texto">{m.texto}</p>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Posicionamento: a @bsurda sempre se posicionou e esteve em manifestações e nas Paradas de BH.
       Texto e fotos de marcação, a escrever.
       Este trecho tem paleta fechada (TEMAS_DE_POSICAO em lib/temas.ts): enquanto ele está na
       tela, a página sai do tema sorteado e usa só as cores permitidas. O primeiro tema da lista
       fica no data-tema para valer mesmo sem o sorteio. -->
  <section class="secao" aria-labelledby="t-posicao" data-tema={atributo(TEMAS_DE_POSICAO[0])} data-tema-lista={TEMAS_DE_POSICAO.map(atributo).join(';')}>
    <h2 id="t-posicao" class="titulo-secao" data-anima="sobe">De que lado a gente está</h2>
    <p class="t-grande posicao" data-anima="surge">A @bsurda é uma festa LGBTQIA+ e de esquerda. Sempre foi, e a gente nunca escondeu.</p>
    <div class="posicao-texto" data-anima="surge">
      <p>Existir em público já é tomar posição, e a gente ocupa a pista e a rua desde 2009. Quando o país cobrou que cada um dissesse de que lado estava, a gente disse: contra o golpe que tirou Dilma e contra o governo Temer que saiu dele. Depois, contra Bolsonaro e tudo o que ele representou para quem é LGBTQIA+.</p>
      <p>Nas eleições de 2022 e de 2026 fizemos campanha por Lula, e mais de uma vez fomos atração voluntária em manifestações nas ruas de Belo Horizonte. Apoiamos com frequência candidaturas do PT e do PSOL.</p>
      <p>É pelo mesmo motivo que já levamos o nosso trio para a Parada do Orgulho LGBTQIA+ de BH e que criamos a nossa própria Parada, em 2020. Festa, para nós, sempre foi um jeito de fazer política.</p>
    </div>
    {/* Rascunho, a revisar por Gui e Ed. Faltam: datas e nomes das manifestações, e fotos. */}
  </section>

  <section class="secao" aria-labelledby="t-palco" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-palco" class="titulo-secao">Quem já passou pelo palco</h2>
    <p class="t-grande palco">Pabllo Vittar, Jão, Karol Conka, Elke Maravilha, Gloria Groove, Banda Uó, Bonde do Rolê, Kaya Conky, Pepita, Aretuza Lovi, Gretchen</p>
    <p class="t-pequeno" style="margin-top:1.5rem">Lista de marcação, a completar.</p>
  </section>
</Base>

<script>
  // O número preso mostra o ano do grupo que está no meio da tela. Só os algarismos
  // que mudam se movem, como um contador. O marco em leitura acende.
  const num = document.querySelector<HTMLElement>('.marcos-num');
  const idade = document.querySelector<HTMLElement>('.marcos-idade');
    const itens = [...document.querySelectorAll<HTMLElement>('.marcos-item')];
  if (num && itens.length > 0) {
    document.documentElement.classList.add('marcos-vivos');
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)');
    const casas = [...num.querySelectorAll('span')];
    let atual = num.textContent ?? '';
    const mostrar = (ano: string) => {
      if (ano === atual) return;
      const sobe = Number(ano) > Number(atual);
      [...ano].forEach((d, i) => {
        const casa = casas[i];
        if (!casa || casa.textContent === d) return;
        casa.textContent = d;
        if (!calmo.matches) casa.animate([{ transform: `translateY(${sobe ? 28 : -28}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
      });
      atual = ano;
      if (idade) { const n = Number(ano) - 2009; idade.textContent = n === 0 ? 'o começo' : n === 1 ? '1 ano de festa' : `${n} anos de festa`; }
    };
    if (idade) idade.textContent = 'o começo';
    let pedido = 0;
    const medir = () => {
      pedido = 0;
      const meio = window.innerHeight * 0.45;
      let perto: HTMLElement | null = null, menor = Infinity;
      for (const it of itens) {
        const r = it.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - meio);
        if (d < menor) { menor = d; perto = it; }
      }
      for (const it of itens) it.classList.toggle('aceso', it === perto);
      // O ano do número é sempre o do marco aceso, para os dois nunca se desencontrarem.
      mostrar(perto?.closest<HTMLElement>('.marcos-grupo')?.dataset.ano ?? atual);
    };
    const pedir = () => { if (!pedido) pedido = requestAnimationFrame(medir); };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    medir();
  }
</script>

<style>
  .marcos { padding: var(--e-6) var(--margem); border-top: 1px solid var(--linha); }
  .marcos-grade { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); column-gap: var(--e-4); align-items: start; margin-top: var(--e-4); }
  /* O ano preso: um número só para a seção inteira */
  .marcos-ano { position: sticky; top: 24svh; }
  .marcos-num { display: flex; font-size: clamp(4.5rem, 19vw, 19rem); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .marcos-num span { display: block; }
  .marcos-conta { display: flex; align-items: center; gap: 0.7em; margin-top: var(--e-3); color: var(--destaque); font-size: var(--t-3); font-weight: 800; letter-spacing: -0.02em; text-transform: uppercase; }
  .marcos-barra { flex: none; width: 0.18em; height: 0.8em; background: currentColor; transform: skewX(26.5deg); }
  /* A história: grupos por ano se afastam (e-5), marcos do mesmo ano ficam perto (e-3) */
  .marcos-grupo + .marcos-grupo { margin-top: var(--e-5); }
  .marcos-rotulo { font-size: var(--t-rotulo); font-weight: 700; letter-spacing: 0.14em; color: var(--suave); margin-bottom: var(--e-2); }
  .marcos-item + .marcos-item { margin-top: var(--e-3); }
  .marcos-item { position: relative; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .marcos-titulo { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25em 0.6em; font-size: var(--t-4); line-height: 1.02; transition: color 0.3s; }
  .marcos-titulo strong { font-weight: 800; letter-spacing: -0.03em; text-transform: uppercase; }
  .marcos-titulo b { padding: 0.2em 0.6em; border: 1.5px solid currentColor; border-radius: 99px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .marcos-texto { max-width: 34em; margin-top: var(--e-1); font-size: var(--t-apoio); line-height: 1.35; color: var(--suave); }
  /* O marco em leitura acende: ganha a cor de destaque e a barra da marca ao lado */
  .marcos-item::before { content: ''; position: absolute; left: -1.3rem; top: 0.25em; width: 0.5rem; height: calc(var(--t-4) * 0.8); background: var(--destaque); transform: skewX(26.5deg) scaleY(0); transform-origin: bottom; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); }
  :global(.marcos-vivos) .marcos-item.aceso { transform: translateX(1.3rem); }
  :global(.marcos-vivos) .marcos-item.aceso .marcos-titulo { color: var(--destaque); }
  :global(.marcos-vivos) .marcos-item.aceso .marcos-texto { color: var(--texto); }
  :global(.marcos-vivos) .marcos-item.aceso::before { transform: skewX(26.5deg) scaleY(1); }
  /* Com o número preso mostrando o ano, o rótulo de cada grupo fica só para leitores de tela */
  @media (min-width: 821px) {
    :global(.marcos-vivos) .marcos-rotulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .marcos-lista { padding: 12svh 0 30svh; }
  }
  /* No celular o ano vira uma faixa presa no topo e a história corre embaixo */
  @media (max-width: 820px) {
    .marcos-grade { grid-template-columns: 1fr; }
    .marcos-ano { top: 0; z-index: 3; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--e-2); margin: 0 calc(-1 * var(--margem)); padding: var(--e-2) var(--margem); background: var(--fundo); border-bottom: 1.5px solid var(--texto); }
    .marcos-num { font-size: 24vw; }
    .marcos-conta { margin: 0 0 0.3em; font-size: 0.9375rem; }
    .marcos-lista { padding: var(--e-4) 0 0 0.75rem; }
    .marcos-rotulo { display: none; }
    :global(.marcos-vivos) .marcos-item.aceso { transform: none; }
    .marcos-item::before { left: -0.75rem; width: 0.35rem; }
  }
  @media (prefers-reduced-motion: reduce) { .marcos-item, .marcos-item::before, .marcos-titulo { transition: none; } }

  .verbo { display: grid; grid-template-columns: 1fr minmax(12rem, 0.8fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; padding: clamp(3rem, 8vw, 7rem) var(--margem); border-top: 1px solid var(--linha); }
  .verbo h2 { font-size: clamp(2rem, 9.5vw, 9rem); overflow-wrap: anywhere; }
  .verbo-cor h2 { color: var(--destaque); }
  .palco { max-width: 22em; }
  .posicao { max-width: 18em; }
  .posicao-texto { display: grid; gap: var(--e-2); max-width: 36em; margin-top: var(--e-4); font-size: var(--t-apoio); line-height: 1.4; }
  @media (max-width: 720px) { .verbo { grid-template-columns: 1fr; } }
</style>
