---
import Base from '../layouts/Base.astro';
import MarcoSobre from '../components/MarcoSobre.astro';
import PolaroideTrio from '../components/PolaroideTrio.astro';
import BarraInclinada from '../components/BarraInclinada.astro';
import Capa from '../components/Capa.astro';
import { foto as fotoMenor } from '../lib/imagens';
// No Sobre as fotos são pedidas como num celular de 2x, mesmo num iPhone (escolha do Gui, 23 nov 2026).
// O terceiro valor é a proporção da caixa, quando a foto aparece recortada (ver src/lib/imagens.ts).
const foto = (src: string, sizes?: string, caixa?: number) => fotoMenor(src, sizes, { ate2x: true, caixa });
import Botao from '../components/Botao.astro';
import marcos from '../data/marcos.json';
import atracoes from '../data/atracoes.json';
import { TEMAS_DE_POSICAO, TEMAS_DO_SITE, atributo } from '../lib/temas';
import { lineup, totalDeLugares, cidades, numeros, palco } from '../lib/historia';
import { getCollection } from 'astro:content';

// Quem tem página no site (Equipe): o nome, onde aparecer nas listas, leva até ela.
// Sem foto no hover: a prévia taparia os nomes vizinhos.
const paginas = new Map((await getCollection('pessoas')).map((p) => [p.data.nome.toLowerCase(), `/equipe/${p.id}`]));
const reserva = atributo(TEMAS_DO_SITE[0]);

// PÁGINA EM EXERCÍCIO. O conteúdo é guia: o que está marcado com "(a confirmar)" ou
// "(marcação)" veio de pesquisa (matérias, apresentação comercial de 2019, release da
// Parada de 2025, arquivo de eventos) e precisa passar por Gui e Ed antes de valer.

// Aqui os marcos contam a história na ordem em que aconteceram, do primeiro ano ao atual.
// (Na agenda eles aparecem do mais recente para trás, como índice do arquivo.)
// Dentro de cada ano, vale a ordem do arquivo src/data/marcos.json: ao incluir um marco, ponha
// na posição da data dele (em 2026: Trio em fevereiro, Câmara em junho, ato e Halloween em outubro).
type Marco = { id: string; ano: string; titulo: string; texto?: string; tema?: string };
const porAno = new Map<string, Marco[]>();
for (const m of marcos as Marco[]) porAno.set(m.ano, [...(porAno.get(m.ano) ?? []), m]);
const anosDosMarcos = [...porAno.keys()].sort();

// Lugares improváveis: onde festa LGBTQIA+ não costumava entrar.
// As fotos vêm da pasta do Gui no Drive (10_site/Sobre/Lugares improvaveis), reduzidas para 1600px.
const improvaveis = [
  { nome: 'Uma piscina de clube', ano: '2014', texto: 'O primeiro Tibum, na União Israelita. Boia e canga liberadas, sapatênis proibido.', capa: '/sobre/improvaveis/piscina.jpg' },
  // As aspas em "hotel" são de propósito (pedido do Gui): uma piscadela, sem declarar nada.
  { nome: 'Um “hotel”', ano: '2015', texto: 'Os 6 anos no Hotel Diamante, com Elke Maravilha.', capa: '/sobre/improvaveis/hotel-diamante.jpg' },
  { nome: 'A Guaicurus', ano: '2015', texto: 'Os residentes no palco da Virada Cultural, na rua mais falada do baixo centro.', capa: '/sobre/improvaveis/guaicurus.jpg' },
  { nome: 'Um viaduto', ano: '2016', texto: 'O primeiro trio, parado embaixo do Santa Tereza, com 12 mil pessoas em volta.', capa: '/sobre/trio-2016.jpg' },
  { nome: 'Um parque na serra', ano: '2016', texto: 'QE @bsurda no Parque das Mangabeiras: mais de 3 mil pessoas ao ar livre, com música e gastronomia das 14h às 22h.', capa: '/sobre/improvaveis/mangabeiras.jpg' },
  { nome: 'Um estádio de futebol', ano: '2018', texto: 'A edição 200 foi a primeira festa LGBT dentro do Mineirão. Voltamos outras três.', capa: '/sobre/improvaveis/mineirao-200.jpg' },
  { nome: 'Um parque de diversões', ano: '2018', texto: 'Festa para mil pessoas no Ita Park, entre os brinquedos.', capa: '/sobre/improvaveis/ita-park.jpg' },
  { nome: 'A Praça Sete', ano: '2024', texto: 'Virada Cultural, no marco zero da cidade.', capa: '/sobre/improvaveis/praca-sete.jpg' },
  { nome: 'A Funarte', ano: '2025', texto: 'A 5ª Parada da @bsurda fechou um mês de ocupação de BH.', capa: '/sobre/improvaveis/funarte.jpg' },
];

// Capas das quatro vezes no Mineirão: a versão grande do arquivo, pelo foto() (escolha do Gui, 23 nov
// 2026). A pequena (-p, 240 px) aparecia borrada. As versões menores saem só no dist.
const mineirao = [
  { data: '9 jun 2018', nome: 'Edição 200', capa: '/arquivo/sympla-273251.jpg' },
  { data: '25 out 2019', nome: 'Halloween de 10 anos', capa: '/arquivo/sympla-563012.jpg' },
  { data: '18 jan 2020', nome: 'I Hate Remix', capa: '/arquivo/sympla-721521.jpg' },
  { data: '19 out 2024', nome: 'Halloween de 15 anos', capa: '/arquivo/sympla-2232912.jpg' },
];

// O trio, ano a ano. A foto troca conforme a página rola.
// "arte" marca imagem que é arte de divulgação (e não foto): aparece inteira sobre fundo desfocado.
const trio: Array<{ ano: string; numero: string; texto: string; foto: string; foco?: string; arte?: boolean }> = [
  { ano: '2016', numero: '12 mil', texto: 'O primeiro. Trio parado no Viaduto Santa Tereza, mais de 6 horas de festa.', foto: '/sobre/trio-2016.jpg' },
  { ano: '2018', numero: '20 mil', texto: 'Trio embargado no dia. A festa aconteceu assim mesmo, na Andradas.', foto: '/sobre/trio-2018.jpg' },
  { ano: '2019', numero: '42 mil', texto: 'Em movimento pela primeira vez: da Praça da Estação, subindo a Bahia até a Afonso Pena.', foto: '/sobre/trio-2019.jpg' },
  { ano: '2020', numero: '60 mil', texto: 'Trio maior, mesmo trajeto.', foto: '/sobre/trio-2020.jpg' },
  { ano: '2023', numero: '75 mil', texto: 'A rua de novo depois da pandemia, saindo do Viaduto Santa Tereza. O maior público da nossa história.', foto: '/sobre/trio-2023.jpg' },
  { ano: '2025', numero: 'De novo', texto: 'Depois de um 2024 sem trio, a segunda volta: 23 de fevereiro, do Viaduto Santa Tereza à Afonso Pena.', foto: '/sobre/trio-2025.jpg' },
  // Foto em pé: "foco" diz que parte dela fica à vista quando a tela é mais larga que alta.
  { ano: '2026', numero: '10 anos', texto: '8 de fevereiro. Uma década de Trio da @bsurda, no mesmo caminho até a Afonso Pena.', foto: '/sobre/trio-2026.jpg', foco: '50% 88%' },
];
// No toque, o Trio é uma pilha de polaroides (escolha do Gui). Cada ano assenta com rotação e deslocamento
// próprios, fixos (não sorteados), como fotos jogadas numa mesa. A pilha é toda escrita em
// keyframes aqui, porque cada cartão tem o seu trajeto: entra subindo junto com o dedo, assenta, e
// a cada cartão novo que chega é empurrado um pouquinho, fica um pouco menor e mais escuro.
// Medida única: --passo (altura do cartão mais a folga e o respiro). O trajeto dos cartões e o trecho de
// rolagem saem dela, e nunca da altura da tela.
const pousoTrio = [
  { giro: -2.4, x: -0.35, y: 0.1 },
  { giro: 1.8, x: 0.45, y: -0.15 },
  { giro: -1.2, x: -0.2, y: 0.2 },
  { giro: 2.6, x: 0.3, y: 0 },
  { giro: -1.9, x: -0.45, y: 0.15 },
  { giro: 1.3, x: 0.35, y: -0.1 },
  { giro: -0.7, x: 0, y: 0 },
];
const pilhaCss = (() => {
  const n = trio.length;
  const ultimo = n - 1;
  const fundoMax = 4; // a partir daqui o cartão já está todo coberto e não muda mais
  const sel = (k: number) => `html.pino-novo .trio-mesa > .trio-quadros > .trio-quadro:nth-child(${k + 1})`;
  const selLinha = (k: number) => `html.pino-novo .trio .trio-mesa > .trio-quadros > .trio-quadro:nth-child(${k + 1})`;
  const pose = (k: number, fundo: number) => {
    const p = pousoTrio[k % pousoTrio.length];
    const d = Math.min(fundo, fundoMax);
    const lado = Math.sign(p.giro) || 1;
    const x = (p.x + d * 0.12 * lado).toFixed(3);
    const y = (p.y - d * 0.45).toFixed(3);
    const giro = (p.giro + d * 0.35 * lado).toFixed(2);
    const escala = (1 - d * 0.035).toFixed(3);
    return `translate(${x}rem, ${y}rem) rotate(${giro}deg) scale(${escala})`;
  };
  const sombra = (fundo: number) => Math.min(fundo * 0.18, 0.72).toFixed(2);
  let css = '@property --passo { syntax: "<length>"; inherits: true; initial-value: 0px; }\n@media (prefers-reduced-motion: no-preference) {\n';
  for (let k = 0; k < n; k++) {
    const ini = Math.max(k - 2, 0);
    const fim = ultimo;
    if (fim <= ini) continue;
    const pc = (t: number) => (((t - ini) / (fim - ini)) * 100).toFixed(3) + '%';
    const quadros: Array<[number, string, string?]> = [];
    // Antes de entrar, o cartão segue a posição que teria numa lista comum (k passos abaixo do
    // primeiro), limitada a dois passos: daí para baixo ele já está fora da tela e só espera.
    if (k >= 2) quadros.push([k - 2, 'transform: translate(0rem, calc(var(--passo) * 2)) rotate(0deg) scale(1)']);
    if (k >= 1) {
      quadros.push([k - 1, 'transform: translate(0rem, var(--passo)) rotate(0deg) scale(1)']);
      quadros.push([k - 0.3, 'transform: translate(0rem, calc(var(--passo) * 0.3)) rotate(0deg) scale(1)']);
    }
    quadros.push([k, `transform: ${pose(k, 0)}`]);
    for (let j = k + 1; j <= ultimo; j++) {
      quadros.push([j - 0.3, `transform: ${pose(k, j - k - 1)}`]);
      quadros.push([j, `transform: ${pose(k, j - k)}`]);
    }
    css += `@keyframes trio-pilha-${k} {
${quadros.map(([t, d]) => `  ${pc(t)} { ${d}; }`).join('\n')}
}
`;
    const escuros: Array<[number, string]> = [[Math.max(k, ini), '0']];
    for (let j = k + 1; j <= ultimo; j++) { escuros.push([j - 0.3, sombra(j - k - 1)]); escuros.push([j, sombra(j - k)]); }
    css += `@keyframes trio-pilha-escuro-${k} {
${escuros.map(([t, o]) => `  ${pc(t)} { opacity: ${o}; }`).join('\n')}
}
`;
    const faixa = `contain calc(0% + var(--passo) * ${ini}) contain calc(0% + var(--passo) * ${fim})`;
    css += `${sel(k)} { animation: trio-pilha-${k} linear both; }
${sel(k)}::after { animation: trio-pilha-escuro-${k} linear both; }
`;
    css += `${selLinha(k)} { animation-timeline: --mesa; animation-range: ${faixa}; }
${selLinha(k)}::after { animation-timeline: --mesa; animation-range: ${faixa}; }
`;
  }
  return css + '}\n';
})();

// A cena de BH que já tocou, cantou e performou com a gente, em ordem alfabética para não
// ter fila nem ego. Os nomes vêm de src/data/atracoes.json, gerado pela planilha "Atrações do
// site" (npm run atracoes; ver notas/briefs/atracoes.md). Quem é ou já foi da equipe (ver a regra
// logo abaixo) aparece na cor de destaque, espalhado pela lista.
// Regra do Gui: todo mundo que tem crachá na página Equipe, de hoje ou de "Já fizeram parte",
// consta nesta lista e é destacado. Por isso a lista da equipe sai sozinha de lá: pessoa nova
// na Equipe entra aqui sem ninguém lembrar. Quem trabalha fora da cabine (as pulseiras) não
// entra; a Ayumi entra porque, além da pulseira, tem crachá.
// Marca entre parênteses depois do nome, no mesmo peso (coluna "Marca ou país" da planilha): a marca
// com que um estilista desfilou, quando ela não leva o nome dele. "em memória" e "riscado" também
// vêm da planilha (coluna "Marcação no site").
const equipe = (await getCollection('pessoas')).map((p) => p.data.nome);
const chave = (nome: string) => nome.toLocaleLowerCase('pt-BR');
type Nome = { nome: string; marca?: string; memoria?: boolean; riscado?: boolean };
const cena = [...(atracoes.cena as Nome[]), ...equipe.map((nome): Nome => ({ nome }))]
  // Quem é da equipe e também está na planilha entra uma vez só (vale a linha da planilha).
  .filter((c, i, lista) => lista.findIndex((n) => chave(n.nome) === chave(c.nome)) === i)
  .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR', { sensitivity: 'base' }))
  .map((c) => ({ ...c, daEquipe: equipe.some((n) => chave(n) === chave(c.nome)) }));

// Posições tomadas. (Anos a confirmar.)
const posicoes = [
  { ano: '2016', frase: 'Contra o golpe' },
  { ano: '2017', frase: 'Fora Temer' },
  { ano: '2018', frase: 'Ele não' },
  { ano: '2022', frase: 'Com Lula' },
  { ano: '2026', frase: 'Com Lula, de novo' },
];

const alem = [
  { titulo: 'Parada da @bsurda', texto: 'Nasceu virtual em 2020. Em 2025 ocupou 9 espaços de BH durante um mês, com mais de 30 artistas, e terminou em festa na Funarte MG.' },
  { titulo: 'Na quarentena', texto: 'Shows online, campanhas solidárias, podcasts e uma clínica de atendimento psicológico.' },
  { titulo: 'Ações sociais', texto: 'Arrecadação de fundos, roupas e alimentos para grupos como o Lá da Favelinha e o Transvest.' },
  { titulo: 'Oficinas e cursos', texto: 'Vogue, drag e produção cultural para pessoas LGBTQIA+.' },
];

const premios = [
  { titulo: 'Homenagem da Câmara Municipal de BH', de: '22 de junho de 2026, pela defesa dos direitos LGBTQIAPN+' },
  { titulo: 'Melhor balada LGBT de BH', de: 'Bhaz, 2017 e 2018' },
  { titulo: 'Melhor festa', de: 'Guia Gay BH, 2015 a 2018' },
  { titulo: 'Melhor festa', de: 'Prêmio Gayzada, 2018' },
  { titulo: 'Melhor DJ do carnaval', de: 'BH Folia, 2019 (Ed Luiz)' },
];
---
<Base titulo="Sobre" imagem="/sobre/mineirao-10-anos.jpg">
  <!-- 1. Abertura: título curto, a frase que resume, e a rua em foto -->
  <header class="abre abre-cima sobre-abre">
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Desde 2009">Desde 2009</h1>
    <p class="t-apoio">Uma festa pop LGBTQIA+ de BH que ganhou a rua e virou produtora, sem frescuras desde a primeira noite.</p>
  </header>
  <figure class="janela" data-paralaxe>
    <img {...foto('/sobre/mineirao-10-anos.jpg')} alt="Pista da @bsurda dentro do Mineirão, na festa de 10 anos, em 2019" />
  </figure>

  <!-- 2. Como começou, e o tamanho que tomou -->
  <section class="origem" aria-labelledby="t-origem">
    <h2 id="t-origem" class="titulo-secao" data-anima="sobe">Como começou</h2>
    <div class="origem-grade">
      <p class="t-grande origem-frase" data-anima="surge">Uma festa que tocasse de tudo, para todo mundo se sentir bem.</p>
      <div class="origem-texto" data-anima="surge">
        <p>Em 2009, as festas de BH tocavam ou só rock ou só pop. O Ed Luiz quis uma que juntasse as duas pistas e as pessoas das duas. O “sem frescuras” saiu daí.</p>
        <p>Ela quase se chamou Candy. Virou @bsurda, com arroba, porque o Twitter estava começando a bombar.</p>
      </div>
    </div>
    <ul class="numeros">
      {numeros.map((x) => (
        <li>
          <p class="numero">{x.mais && <span>+</span>}<b data-conta={x.n}>{x.n}</b></p>
          <p class="numero-rotulo">{x.rotulo}{x.nota && <small> ({x.nota})</small>}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. Por onde passou: casas, lugares improváveis, estrada -->
  <section class="lugares" aria-labelledby="t-lugares" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-lugares" class="t-secao" data-anima="sobe">Sem endereço fixo</h2>
    <p class="t-apoio lugares-texto" data-anima="surge">A @bsurda não para quieta. Já passou por dezenas de endereços de BH, de inferninho a galpão, de parque a estádio. Cada casa nova abriu uma porta nova pra nossa pista.</p>
    <div class="lineup" aria-label="Endereços por onde a festa passou">
      {lineup.map((faixa, i) => (
        <p class={`lineup-${i + 1}`}>{faixa.map((nome) => <span>{nome}</span>)}</p>
      ))}
    </div>
    <p class="t-pequeno casas-nota">{totalDeLugares} endereços até aqui.</p>

    <div class="improvaveis-topo">
      <h3 class="titulo-secao">Lugares improváveis</h3>
      <p class="improvaveis-setas">
        <button type="button" data-rolar="-1" aria-label="Anterior"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" /></svg></button>
        <button type="button" data-rolar="1" aria-label="Próximo"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg></button>
      </p>
    </div>
    {/* Recebe foco pelo teclado e rola pelas setas do teclado (QA de produção, 22 nov 2026). */}
    <ul class="improvaveis" tabindex="0" aria-label="Lugares improváveis">
      {improvaveis.map((l, i) => (
        <li class:list={{ torto: i % 2 === 1 }}>
          <div class="improvavel-foto"><Capa src={l.capa} proporcao="16 / 9" tamanho="(max-width: 1000px) 85vw, 52vw" ate2x /><span class="improvavel-ano">{l.ano}</span></div>
          <h4>{l.nome}</h4>
          <p>{l.texto}</p>
        </li>
      ))}
    </ul>

    <div class="estrada">
      <h3 class="titulo-secao">E pegou estrada</h3>
      <p class="cidades">
        {cidades.map((c) => <span>{c}</span>)}
      </p>
    </div>
  </section>

  <!-- 4. Mineirão: bloco invertido, o estádio como palavra -->
  <section class="mineirao" aria-labelledby="t-mineirao">
    <p class="mineirao-palavra" aria-hidden="true">Mineirão</p>
    <div class="mineirao-grade">
      <div>
        <h2 id="t-mineirao" class="t-grande">A primeira festa LGBT dentro do Mineirão.</h2>
        <p class="t-apoio">Pra muita gente da nossa pista, foi também a primeira vez dentro de um estádio de futebol (e não foi pra ver jogo). Voltamos outras três vezes.</p>
      </div>
      <ol class="mineirao-vezes">
        {mineirao.map((m, i) => (
          <li style={`--i:${i}`}>
            <img {...foto(m.capa, '5.5rem', 16 / 9)} alt="" loading="lazy" />
            <p><span>{m.data}</span>{m.nome}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Marcos: o ano fica preso na tela, gigante, e vira conforme a história passa ao lado.
       Mesmo universo da agenda (número grande, barra inclinada, etiquetas), outra leitura:
       lá é índice que se abre, aqui é uma narrativa contínua. -->
  <section class="marcos" aria-labelledby="t-marcos" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-marcos" class="titulo-secao" data-anima="sobe">Marcos</h2>
    <div class="marcos-grade" data-trilho>
      <div class="marcos-ano" aria-hidden="true" data-barra="estreita">
        <p class="marcos-num">{anosDosMarcos[0].split('').map((d) => <span>{d}</span>)}</p>
        <p class="marcos-conta"><BarraInclinada class="marcos-barra" /><span class="marcos-idade"></span></p>
      </div>
      <ol class="marcos-lista">
        {anosDosMarcos.map((ano) => (
          <li class="marcos-grupo" data-ano={ano}>
            <h3 class="marcos-rotulo">{ano}</h3>
            <ul>
              {porAno.get(ano)!.map((m) => <MarcoSobre titulo={m.titulo} tema={m.tema} texto={m.texto} />)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. A rua: o trio ano a ano. No desktop a foto fica presa e troca conforme a página rola. -->
  <!-- No toque, o Trio é uma pilha de polaroides; os keyframes de cada uma vêm do alto do arquivo. -->
  <style is:inline set:html={pilhaCss}></style>
  <section class="trio" aria-labelledby="t-trio" style={`--n:${trio.length}`}>
    <div class="trio-pino">
      <h2 id="t-trio" class="trio-titulo">Trio da @bsurda</h2>
      <div class="trio-mesa">
      <ol class="trio-quadros">
        {trio.map((t, i) => <PolaroideTrio {...t} ativa={i === 0} />)}
      </ol>
      </div>
      <p class="trio-regra">Sempre no último domingo antes do carnaval.</p>
    </div>
  </section>

  <!-- 7. O palco -->
  <section class="palco" aria-labelledby="t-palco" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-palco" class="t-secao" data-anima="sobe">Quem a gente trouxe</h2>
    <p class="nomes">
      {palco.map((a) => <span>{a.riscado ? <s>{a.nome}</s> : a.nome}{a.memoria && <sup class="memoria"><i aria-hidden="true">†</i>em memória</sup>}{a.de && <sup><i aria-hidden="true">{a.bandeira}</i>{a.de}</sup>}</span>)}
    </p>
    <h2 class="t-secao cena-titulo" data-anima="sobe">E a cena de BH, que é a base de tudo</h2>
    <p class="nomes nomes-cena">
      {cena.map((c) => {
        const pagina = paginas.get(c.nome.toLowerCase());
        const texto = <>{c.riscado ? <s>{c.nome}</s> : c.nome}{c.marca && ` (${c.marca})`}{c.memoria && <sup class="memoria"><i aria-hidden="true">†</i>em memória</sup>}</>;
        return <span class:list={{ residente: c.daEquipe }}>{pagina ? <a href={pagina}>{texto}</a> : texto}</span>;
      })}
    </p>
    <p class="legenda"><i aria-hidden="true"></i>Equipe @bsurda: de hoje e de outras fases</p>
