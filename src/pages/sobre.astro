<script>
  // O número preso mostra o ano do grupo que está no meio da tela. Só os algarismos
  // que mudam se movem, como um contador. O marco em leitura acende.
  const num = document.querySelector<HTMLElement>('.marcos-num');
  const idade = document.querySelector<HTMLElement>('.marcos-idade');
    const itens = [...document.querySelectorAll<HTMLElement>('.marcos-item')];
  if (num && itens.length > 0) {
    document.documentElement.classList.add('marcos-vivos');
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)');
    const casas = [...num.querySelectorAll('span')];
    let atual = num.textContent ?? '';
    const mostrar = (ano: string) => {
      if (ano === atual) return;
      const sobe = Number(ano) > Number(atual);
      [...ano].forEach((d, i) => {
        const casa = casas[i];
        if (!casa || casa.textContent === d) return;
        casa.textContent = d;
        if (!calmo.matches) casa.animate([{ transform: `translateY(${sobe ? 28 : -28}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
      });
      atual = ano;
      if (idade) { const n = Number(ano) - 2009; idade.textContent = n === 0 ? 'o começo' : n === 1 ? '1 ano de festa' : `${n} anos de festa`; }
    };
    if (idade) idade.textContent = 'o começo';
    let pedido = 0;
    const medir = () => {
      pedido = 0;
      const meio = window.innerHeight * 0.45;
      let perto: HTMLElement | null = null, menor = Infinity;
      for (const it of itens) {
        const r = it.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - meio);
        if (d < menor) { menor = d; perto = it; }
      }
      for (const it of itens) it.classList.toggle('aceso', it === perto);
      // O ano do número é sempre o do marco aceso, para os dois nunca se desencontrarem.
      mostrar(perto?.closest<HTMLElement>('.marcos-grupo')?.dataset.ano ?? atual);
    };
    const pedir = () => { if (!pedido) pedido = requestAnimationFrame(medir); };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    medir();
  }

  // ---------- O resto da página ----------
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Números da abertura: contam de zero até o valor, uma vez, quando entram na tela.
  const contadores = document.querySelectorAll<HTMLElement>('[data-conta]');
  if (contadores.length > 0 && !semMovimento.matches) {
    const ver = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        ver.unobserve(e.target);
        const el = e.target as HTMLElement;
        const alvo = Number(el.dataset.conta);
        const inicio = performance.now();
        const passo = (agora: number) => {
          const t = Math.min(1, (agora - inicio) / 1400);
          el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - t, 4))));
          if (t < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      }
    }, { threshold: 0.6 });
    contadores.forEach((c) => ver.observe(c));
  }

  // Carrossel dos lugares improváveis: as setas andam um cartão por vez.
  const fila = document.querySelector<HTMLElement>('.improvaveis');
  document.querySelectorAll<HTMLButtonElement>('[data-rolar]').forEach((b) => {
    b.addEventListener('click', () => {
      const cartao = fila?.querySelector('li');
      if (!fila || !cartao) return;
      fila.scrollBy({ left: Number(b.dataset.rolar) * (cartao.getBoundingClientRect().width + 24), behavior: semMovimento.matches ? 'auto' : 'smooth' });
    });
  });

  // Fotos em paralaxe e o trio: tudo no mesmo passo de rolagem.
  const janelas = [...document.querySelectorAll<HTMLElement>('[data-paralaxe]')];
  const secaoTrio = document.querySelector<HTMLElement>('.trio');
  const quadros = [...document.querySelectorAll<HTMLElement>('.trio-quadro')];
  const listaTrio = document.querySelector<HTMLElement>('.trio-quadros');
  // No toque, as polaroides aparecem todas de uma vez (quem as move é a animação ligada à
  // rolagem, e não este script).
  const raizTrio = document.documentElement.classList;
  const trioEmCartoes = raizTrio.contains('pino-novo') || raizTrio.contains('toque');
  // Pilha viva: os cartões que já estão por baixo perdem o texto e trocam a foto
  // por uma pequena, para o Safari não segurar sete fotos grandes em camadas animadas. E o cartão
  // que ainda está abaixo da tela fica escondido (nada animado fora da tela). A altura da tela
  // entra só aqui, para esconder; o trajeto dos cartões não depende dela.
  const mesa = document.querySelector<HTMLElement>('.trio-mesa');
  const pilhaViva = () => raizTrio.contains('pino-novo') && !semMovimento.matches;
  const fotosGrandes = quadros.map((q) => q.querySelector('img')?.getAttribute('src') ?? '');
  const versoesGrandes = quadros.map((q) => q.querySelector('img')?.getAttribute('srcset') ?? '');
  const porBaixo = quadros.map(() => false);
  const longe = quadros.map(() => false);
  const simplifica = () => {
    if (!mesa) return;
    const viva = pilhaViva();
    const passo = viva ? parseFloat(getComputedStyle(mesa).getPropertyValue('--passo')) : 0;
    const andado = -mesa.getBoundingClientRect().top;
    // Primeiro as leituras, depois as trocas de classe.
    const abaixo = quadros.map((q) => viva && q.getBoundingClientRect().top > window.innerHeight + 40);
    quadros.forEach((q, k) => {
      if (abaixo[k] !== longe[k]) { longe[k] = abaixo[k]; q.classList.toggle('longe', abaixo[k]); }
      const baixo = viva && passo > 0 && andado >= (k + 1) * passo;
      if (baixo === porBaixo[k]) return;
      porBaixo[k] = baixo;
      q.classList.toggle('por-baixo', baixo);
      const img = q.querySelector('img');
      if (!img) return;
      // Com srcset, trocar só o src não muda a foto: a miniatura entra sem srcset, e a grande volta com ele.
      if (baixo) { img.removeAttribute('srcset'); img.src = q.dataset.mini ?? fotosGrandes[k]; }
      else { img.src = fotosGrandes[k]; if (versoesGrandes[k]) img.srcset = versoesGrandes[k]; }
    });
  };
  if (trioEmCartoes) quadros.forEach((q) => q.classList.add('ativo'));
  let quadroAtual = 0;
  let naFila = 0;
  const rolar = () => {
    naFila = 0;
    const tela = window.innerHeight;
    if (!semMovimento.matches) {
      for (const j of janelas) {
        const r = j.getBoundingClientRect();
        if (r.bottom < 0 || r.top > tela) continue;
        // De -1 (entrando por baixo) a 1 (saindo por cima)
        const p = (r.top + r.height / 2 - tela / 2) / (tela / 2 + r.height / 2);
        j.style.setProperty('--desvio', `${(p * -7).toFixed(2)}%`);
      }
    }
    if (trioEmCartoes) simplifica();
    if (secaoTrio && quadros.length > 0 && !trioEmCartoes) {
      const r = secaoTrio.getBoundingClientRect();
      const curso = r.height - tela;
      const p = curso > 0 ? Math.min(0.999, Math.max(0, -r.top / curso)) : 0;
      const i = Math.floor(p * quadros.length);
      if (i !== quadroAtual) {
        quadros[quadroAtual]?.classList.remove('ativo');
        quadros[i]?.classList.add('ativo');
        quadroAtual = i;
      }
      (listaTrio ?? secaoTrio).style.setProperty('--avanco', p.toFixed(3));
    }
  };
  const chamar = () => { if (!naFila) naFila = requestAnimationFrame(rolar); };
  addEventListener('scroll', chamar, { passive: true });
  addEventListener('resize', chamar);
  rolar();
</script>

<style>
  .marcos { padding: var(--e-6) var(--margem); border-top: 1px solid var(--linha); }
  .marcos-grade { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); column-gap: var(--e-4); align-items: start; margin-top: var(--e-4); }
  /* O ano preso: um número só para a seção inteira */
  .marcos-ano { position: sticky; top: 24svh; }
  .marcos-num { display: flex; font-size: clamp(4.5rem, 19vw, 19rem); font-weight: 800; line-height: 0.8; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .marcos-num span { display: block; }
  .marcos-conta { display: flex; align-items: center; gap: 0.7em; margin-top: var(--e-3); color: var(--destaque-texto); font-size: var(--t-3); font-weight: 800; letter-spacing: -0.02em; text-transform: uppercase; }
  .marcos-conta :global(.marcos-barra) { flex: none; width: 0.18em; height: 0.8em; background: var(--destaque); }
  /* A história: grupos por ano se afastam (e-5), marcos do mesmo ano ficam perto (e-3) */
  .marcos-grupo + .marcos-grupo { margin-top: var(--e-5); }
  .marcos-rotulo { font-size: var(--t-rotulo); font-weight: 700; letter-spacing: 0.14em; color: var(--suave); margin-bottom: var(--e-2); }

  /* Com o número preso mostrando o ano, o rótulo de cada grupo fica só para leitores de tela */
  @media (min-width: 821px) {
    :global(.marcos-vivos) .marcos-rotulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .marcos-lista { padding: 12svh 0 30svh; }
  }
  /* No celular o ano vira uma faixa presa no topo e a história corre embaixo */
  @media (max-width: 820px) {
    .marcos-grade { grid-template-columns: 1fr; }
    .marcos-ano { top: 0; z-index: 3; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--e-2); margin: 0 calc(-1 * var(--margem)); padding: var(--e-2) var(--margem); background: var(--fundo); border-bottom: 1.5px solid var(--texto); }
    .marcos-num { font-size: 24vw; }
    .marcos-conta { margin: 0 0 0.3em; font-size: 0.9375rem; }
    .marcos-lista { padding: var(--e-4) 0 0 0.75rem; }
    .marcos-rotulo { display: none; }
  }

  /* ---------- Hierarquia da página ----------
     Quatro degraus de título, do maior para o menor:
     1. título da página (.t-gigante, com eco);
     2. título de seção (.t-secao): Sem endereço fixo, Quem a gente trouxe, Além da pista;
     3. destaque de conteúdo (--t-5): headliners, cidades, frases, nomes nos cartões;
     4. subtítulo e rótulo de bloco (.titulo-secao, --t-4): Lugares improváveis, E pegou estrada, Reconhecimento.
     O título de seção fica um degrau acima do conteúdo que ele abre, para nunca empatar com ele.
     Exceção: quando a seção abre com um texto gigante próprio (a frase de Como começou, o ano
     dos Marcos, a faixa do posicionamento), o título vira chamada pequena (.titulo-secao). */
  .t-secao { font-size: clamp(2.75rem, 9.5vw, 8.75rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; text-transform: uppercase; text-wrap: balance; }

  /* ---------- Abertura ---------- */
  .sobre-abre .t-apoio { max-width: 30em; }
  /* Janela de foto: a imagem é mais alta que a moldura e desliza devagar com a rolagem */
  .janela { margin: 0 var(--margem); height: clamp(20rem, 78svh, 52rem); overflow: hidden; border-radius: clamp(1rem, 2.5vw, 2.25rem); }
  .janela { position: relative; }
  .janela img { position: absolute; left: 0; top: -8%; width: 100%; height: 116%; max-width: none; object-fit: cover; object-position: 50% 100%; transform: translateY(var(--desvio, 0%)); will-change: transform; }
  .janela-baixa { height: clamp(14rem, 44svh, 30rem); }

  /* ---------- Como começou ---------- */
  .origem { padding: var(--e-6) var(--margem); }
  .origem-grade { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--e-4); align-items: end; }
  .origem-frase { max-width: 13em; }
  .origem-texto { display: grid; gap: var(--e-2); font-size: var(--t-apoio); line-height: 1.4; }
  .origem small, .numero-rotulo small { font-size: 0.75em; color: var(--suave); }
  .numeros { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--e-3); margin-top: var(--e-5); padding-top: var(--e-3); border-top: 1.5px solid var(--texto); }
  .numero { display: flex; align-items: flex-start; font-size: var(--t-5); font-weight: 800; line-height: 0.85; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  /* O "+" fica à meia altura dos algarismos, com folga: o espaçamento apertado do número
     (letter-spacing negativo) fazia o sinal encostar no primeiro algarismo. */
  .numero span { align-self: center; font-size: 0.5em; line-height: 1; letter-spacing: 0; margin-right: 0.12em; color: var(--destaque-texto); }
  .numero-rotulo { margin-top: var(--e-1); font-size: var(--t-rotulo); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---------- Sem endereço fixo ---------- */
  .lugares { padding: var(--e-6) 0; border-top: 1px solid var(--linha); }
  .lugares > h2, .lugares-texto, .casas, .improvaveis-topo, .estrada { margin-left: var(--margem); margin-right: var(--margem); }
  /* Ritmo dentro de uma seção, por proximidade: título e parágrafo formam o cabeçalho e ficam
     colados (--e-2); do cabeçalho para o conteúdo que ele abre, um respiro bem maior (--e-4);
     nota ou legenda colada ao conteúdo que explica (--e-2); novo sub-bloco, --e-5. */
  .lugares-texto { max-width: 32em; margin-top: var(--e-2); }
  /* Os endereços como line-up de festival: três faixas de tamanho, centralizadas, com a barra da marca entre os nomes */
  .lineup { margin: var(--e-4) var(--margem) 0; display: grid; gap: var(--e-3); font-weight: 800; text-transform: uppercase; }
  .lineup p { display: flex; flex-wrap: wrap; align-items: center; }
  .lineup span, .cidades span { display: inline-flex; align-items: flex-start; }
  /* Alinhamento ótico das barras: a barra é inclinada, então o ponto mais à esquerda dela é
     o topo. O recuo de 0,18em põe esse topo na mesma vertical do texto da página, em qualquer
     corpo. O espaço entre um nome e a barra seguinte fica no fim do nome, para a barra que
     abre uma linha não herdar recuo nenhum. */
  /* A barra acompanha a primeira linha do nome: quando o nome quebra, ela não desce para o meio. */
  .lineup span, .cidades span, .nomes span { margin-right: 0.3em; }
  .lineup span::before, .cidades span::before { content: ''; flex: none; width: 0.14em; height: 0.72em; margin: 0.14em 0.4em 0 0.18em; margin-top: calc((1lh - 0.72em) / 2); background: var(--destaque); transform: skewX(26.5deg); }
  .lineup-1 { gap: 0.1em 0; font-size: var(--t-5); line-height: 1; letter-spacing: -0.045em; }
  .lineup-2 { gap: 0.2em 0; font-size: var(--t-4); line-height: 1; letter-spacing: -0.03em; }
  .lineup-3 { gap: 0.35em 0; font-size: clamp(0.9375rem, 1.35vw, 1.3125rem); line-height: 1.1; letter-spacing: 0.02em; color: var(--suave); }
  .casas-nota { margin: var(--e-2) var(--margem) 0; }
  .improvaveis-topo { display: flex; align-items: center; justify-content: space-between; gap: var(--e-3); margin-top: var(--e-5); }
  .improvaveis-topo .titulo-secao { margin-bottom: 0; }
  .improvaveis-setas { display: flex; gap: 0.6rem; }
  .improvaveis-setas button { width: 3rem; aspect-ratio: 1; padding: 0; border: 1.5px solid currentColor; border-radius: 50%; background: none; color: inherit; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .improvaveis-setas button:hover { background: var(--texto); color: var(--fundo); }
  .improvaveis-setas svg { width: 40%; margin: auto; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .improvaveis { display: flex; gap: var(--e-3); margin-top: var(--e-3); padding: 1rem var(--margem) 1.25rem; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding-left: var(--margem); scrollbar-width: none; }
  .improvaveis::-webkit-scrollbar { display: none; }
  /* Cartões grandes: a foto ocupa quase a tela, o ano vira selo e o nome invade a foto por baixo */
  .improvaveis li { flex: none; width: min(84vw, 46rem); scroll-snap-align: start; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .improvaveis li.torto { transform: rotate(1deg) translateY(0.75rem); }
  .improvaveis li:hover { transform: rotate(-0.6deg) translateY(-0.25rem); }
  .improvavel-foto { position: relative; }
  .improvavel-foto :global(.capa) { border-radius: clamp(1rem, 2.2vw, 2rem); }
  /* O ano é um adesivo sobre a foto e se lê: superfície viva, com leitura garantida (4,5:1). */
