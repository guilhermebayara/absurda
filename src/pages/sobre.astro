---
import Base from '../layouts/Base.astro';
import Capa from '../components/Capa.astro';
import Botao from '../components/Botao.astro';
import marcos from '../data/marcos.json';
import { TEMAS_DE_POSICAO, TEMAS_DO_SITE, atributo } from '../lib/temas';
const reserva = atributo(TEMAS_DO_SITE[0]);

// PÁGINA EM EXERCÍCIO. O conteúdo é guia: o que está marcado com "(a confirmar)" ou
// "(marcação)" veio de pesquisa (matérias, apresentação comercial de 2019, release da
// Parada de 2025, arquivo de eventos) e precisa passar por Gui e Ed antes de valer.

// Aqui os marcos contam a história na ordem em que aconteceram, do primeiro ano ao atual.
// (Na agenda eles aparecem do mais recente para trás, como índice do arquivo.)
type Marco = { id: string; ano: string; titulo: string; texto?: string; tema?: string };
const porAno = new Map<string, Marco[]>();
for (const m of marcos as Marco[]) porAno.set(m.ano, [...(porAno.get(m.ano) ?? []), m]);
const anosDosMarcos = [...porAno.keys()].sort();

const idade = new Date().getFullYear() - 2009;

// Números da abertura. "mais" põe um "+" na frente.
const numeros = [
  { n: idade, rotulo: 'anos de festa' },
  { n: 300, mais: true, rotulo: 'edições', nota: 'a confirmar' },
  { n: 100, mais: true, rotulo: 'endereços em BH', nota: 'a confirmar' },
  { n: 12, rotulo: 'cidades', nota: 'a confirmar' },
];

// Casas por onde a festa passou, em ordem de época.
const casas = ['Velvet Club', 'Up e.music', 'Mary in Hell', 'Mercado das Borboletas', 'Granfinos', 'Deputamadre', 'O Mercado', 'A Central', 'Casa Sapucaí', 'Lab', 'Mira'];

// Lugares improváveis: onde festa LGBTQIA+ não costumava entrar.
const improvaveis = [
  { nome: 'Inhotim', ano: '2014', texto: 'A @bsurda Trip levou a pista para dentro do museu, em Brumadinho.', capa: '/arquivo/sympla-21543.jpg' },
  { nome: 'Uma piscina de clube', ano: '2014', texto: 'O primeiro Tibum, na União Israelita. Boia e canga liberadas, sapatênis proibido.', capa: '/arquivo/sympla-16563.jpg' },
  { nome: 'Hotel Diamante', ano: '2015', texto: 'Os 6 anos, com Elke Maravilha. (a confirmar)' },
  { nome: 'Rua Guaicurus', ano: '2015', texto: 'Os residentes no palco da Virada Cultural de BH. (a confirmar)' },
  { nome: 'Parque das Mangabeiras', ano: '2016', texto: 'QE @bsurda: ar livre, música e gastronomia das 14h às 22h.', capa: '/arquivo/sympla-77360.jpg' },
  { nome: 'Um parque de diversões', ano: '2018', texto: 'Festa para mil pessoas no Ita Park, entre os brinquedos.', capa: '/arquivo/sympla-227150.jpg' },
  { nome: 'Funarte MG', ano: '2025', texto: 'A 5ª Parada da @bsurda fechou um mês de ocupação da cidade.', capa: '/arquivo/sympla-2959783.jpg' },
];

const cidades = ['Vitória', 'São Paulo', 'Rio de Janeiro', 'Brasília', 'Salvador', 'Maringá', 'Sete Lagoas', 'Brumadinho'];
const cidadesAConfirmar = ['Juiz de Fora', 'Montes Claros', 'Londrina'];

const mineirao = [
  { data: '9 jun 2018', nome: 'Edição 200', capa: '/arquivo/sympla-273251-p.jpg' },
  { data: '25 out 2019', nome: 'Halloween de 10 anos', capa: '/arquivo/sympla-563012-p.jpg' },
  { data: '18 jan 2020', nome: 'I Hate Remix', capa: '/arquivo/sympla-721521-p.jpg' },
  { data: '19 out 2024', nome: 'Halloween de 15 anos', capa: '/arquivo/sympla-2232912-p.jpg' },
];

// O trio, ano a ano. A foto troca conforme a página rola.
const trio = [
  { ano: '2016', numero: '12 mil', texto: 'O primeiro. Trio parado no Viaduto Santa Tereza, mais de 6 horas de festa.', foto: '/capas/trio-2016.jpg', arte: true },
  { ano: '2018', numero: '20 mil', texto: 'Trio embargado no dia. A festa aconteceu assim mesmo, na Andradas.', foto: '/sobre/trio-2018.jpg' },
  { ano: '2019', numero: '30 mil', texto: 'Em movimento pela primeira vez: da Praça da Estação, subindo a Bahia até a Afonso Pena.', foto: '/sobre/trio-2019.jpg' },
  { ano: '2020', numero: '60 mil', texto: 'Trio maior, mesmo trajeto. O maior público da nossa história.', foto: '/sobre/trio-2020.jpg' },
  { ano: '2023', numero: 'De volta', texto: 'A rua de novo depois da pandemia, saindo do Viaduto Santa Tereza.', foto: '/sobre/trio-2023.jpg' },
];

// Quem já subiu no palco. "de" marca atração de fora do Brasil.
const palco = [
  { nome: 'Pabllo Vittar' }, { nome: 'Jão' }, { nome: 'Gloria Groove' }, { nome: 'Karol Conká' }, { nome: 'Elke Maravilha' },
  { nome: 'Gretchen' }, { nome: 'Banda Uó' }, { nome: 'Bonde do Rolê' }, { nome: 'Deize Tigrona' }, { nome: 'Rico Dalasam' },
  { nome: 'Jaloo' }, { nome: 'Daniel Peixoto' }, { nome: 'Copacabana Club' }, { nome: 'Pearls Negras' },
  { nome: 'Alyssa Edwards', de: 'EUA' }, { nome: 'Latrice Royale', de: 'EUA' }, { nome: 'Jujubee', de: 'EUA' },
  { nome: 'Coco Montrese', de: 'EUA' }, { nome: 'Sharon Needles', de: 'EUA' }, { nome: 'April Carrión', de: 'Porto Rico' },
];

// Posições tomadas. (Anos a confirmar.)
const posicoes = [
  { ano: '2016', frase: 'Contra o golpe' },
  { ano: '2017', frase: 'Fora Temer' },
  { ano: '2018', frase: 'Contra Bolsonaro' },
  { ano: '2022', frase: 'Com Lula' },
  { ano: '2026', frase: 'Com Lula, de novo' },
];

const alem = [
  { titulo: 'Parada da @bsurda', texto: 'Nasceu virtual em 2020. Em 2025 ocupou 9 espaços de BH durante um mês, com mais de 30 artistas, e terminou em festa na Funarte MG.' },
  { titulo: 'Na quarentena', texto: 'Shows online, campanhas solidárias, podcasts e uma clínica de atendimento psicológico.' },
  { titulo: 'Ações sociais', texto: 'Arrecadação de fundos, roupas e alimentos para grupos como o Lá da Favelinha e o Transvest.' },
  { titulo: 'Oficinas e cursos', texto: 'Vogue, drag e produção cultural para pessoas LGBTQIA+.' },
];

const premios = [
  { titulo: 'Melhor balada LGBT de BH', de: 'Bhaz, 2017 e 2018' },
  { titulo: 'Melhor festa', de: 'Guia Gay BH, 2015 a 2018' },
  { titulo: 'Melhor festa', de: 'Prêmio Gayzada, 2018' },
  { titulo: 'Melhor DJ do carnaval', de: 'BH Folia, 2019 (Ed Luiz)' },
];
---
<Base titulo="Sobre">
  <!-- 1. Abertura: título curto, a frase que resume, e a rua em foto -->
  <header class="abre abre-cima sobre-abre">
    <h1 class="t-gigante ecoa ecoa-cima ecoa-direita" data-eco="Desde 2009">Desde 2009</h1>
    <p class="t-apoio">Uma festa pop LGBTQIA+ de Belo Horizonte que ganhou a rua e virou produtora. Sem frescuras desde a primeira noite.</p>
  </header>
  <figure class="janela" data-paralaxe>
    <img src="/sobre/trio-2019.jpg" alt="Multidão no Trio da @bsurda, na Rua da Bahia, em 2019" />
  </figure>

  <!-- 2. Como começou, e o tamanho que tomou -->
  <section class="origem" aria-labelledby="t-origem">
    <h2 id="t-origem" class="titulo-secao" data-anima="sobe">Como começou</h2>
    <div class="origem-grade">
      <p class="t-grande origem-frase" data-anima="surge">Uma festa que tocasse de tudo, para todo mundo se sentir bem.</p>
      <div class="origem-texto" data-anima="surge">
        <p>Em 2009, as festas de BH tocavam ou só rock ou só pop. O Ed Luiz quis uma que juntasse as duas pistas e as pessoas das duas. O “sem frescuras” saiu daí.</p>
        <p>Ela quase se chamou Candy. Virou @bsurda, com arroba, porque o Twitter estava começando a bombar. <small>(a confirmar)</small></p>
      </div>
    </div>
    <ul class="numeros">
      {numeros.map((x) => (
        <li>
          <p class="numero">{x.mais && <span>+</span>}<b data-conta={x.n}>{x.n}</b></p>
          <p class="numero-rotulo">{x.rotulo}{x.nota && <small> ({x.nota})</small>}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. Por onde passou: casas, lugares improváveis, estrada -->
  <section class="lugares" aria-labelledby="t-lugares" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-lugares" class="t-grande" data-anima="sobe">Sem endereço fixo</h2>
    <p class="t-apoio lugares-texto" data-anima="surge">A @bsurda circula. Passou por mais de cem endereços de Belo Horizonte, de inferninho a galpão, de parque a estádio. Cada mudança abriu uma porta nova para a nossa pista.</p>
    <p class="casas" aria-label="Casas por onde a festa passou">
      {casas.map((c) => <span>{c}</span>)}
    </p>

    <div class="improvaveis-topo">
      <h3 class="titulo-secao">Lugares improváveis</h3>
      <p class="improvaveis-setas">
        <button type="button" data-rolar="-1" aria-label="Anterior"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" /></svg></button>
        <button type="button" data-rolar="1" aria-label="Próximo"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg></button>
      </p>
    </div>
    <ul class="improvaveis">
      {improvaveis.map((l, i) => (
        <li class:list={{ torto: i % 2 === 1 }}>
          <Capa src={l.capa} proporcao="16 / 10" />
          <p class="improvavel-ano">{l.ano}</p>
          <h4>{l.nome}</h4>
          <p>{l.texto}</p>
        </li>
      ))}
    </ul>

    <div class="estrada">
      <h3 class="titulo-secao">E pegou estrada</h3>
      <p class="cidades">
        {cidades.map((c) => <span>{c}</span>)}
        {cidadesAConfirmar.map((c) => <span class="incerta">{c}</span>)}
      </p>
      <p class="t-pequeno">As três últimas ainda a confirmar.</p>
    </div>
  </section>

  <!-- 4. Mineirão: bloco invertido, o estádio como palavra -->
  <section class="mineirao" aria-labelledby="t-mineirao">
    <p class="mineirao-palavra" aria-hidden="true">Mineirão</p>
    <div class="mineirao-grade">
      <div>
        <h2 id="t-mineirao" class="t-grande">A primeira festa LGBT dentro do Mineirão.</h2>
        <p class="t-apoio">Para muita gente da nossa pista, foi também a primeira vez dentro de um estádio de futebol. Voltamos outras três.</p>
      </div>
      <ol class="mineirao-vezes">
        {mineirao.map((m, i) => (
          <li style={`--i:${i}`}>
            <img src={m.capa} alt="" loading="lazy" />
            <p><span>{m.data}</span>{m.nome}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Marcos: o ano fica preso na tela, gigante, e vira conforme a história passa ao lado.
       Mesmo universo da agenda (número grande, barra inclinada, etiquetas), outra leitura:
       lá é índice que se abre, aqui é uma narrativa contínua. -->
  <section class="marcos" aria-labelledby="t-marcos" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-marcos" class="titulo-secao" data-anima="sobe">Marcos</h2>
    <div class="marcos-grade">
      <div class="marcos-ano" aria-hidden="true">
        <p class="marcos-num">{anosDosMarcos[0].split('').map((d) => <span>{d}</span>)}</p>
        <p class="marcos-conta"><span class="marcos-barra"></span><span class="marcos-idade"></span></p>
      </div>
      <ol class="marcos-lista">
        {anosDosMarcos.map((ano) => (
          <li class="marcos-grupo" data-ano={ano}>
            <h3 class="marcos-rotulo">{ano}</h3>
            <ul>
              {porAno.get(ano)!.map((m) => (
                <li class="marcos-item">
                  <p class="marcos-titulo"><strong>{m.titulo}</strong>{m.tema && <b>{m.tema}</b>}</p>
                  {m.texto && <p class="marcos-texto">{m.texto}</p>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. A rua: o trio ano a ano. A foto fica presa e troca conforme a página rola. -->
  <section class="trio" aria-labelledby="t-trio" style={`--n:${trio.length}`}>
    <div class="trio-pino">
      <h2 id="t-trio" class="trio-titulo">Trio da @bsurda</h2>
      <ol class="trio-quadros">
        {trio.map((t, i) => (
          <li class:list={['trio-quadro', { ativo: i === 0, arte: t.arte }]}>
            <img src={t.foto} alt="" loading="lazy" />
            <div class="trio-legenda">
              <p class="trio-ano">{t.ano}</p>
              <p class="trio-numero">{t.numero}</p>
              <p class="trio-texto">{t.texto}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="trio-regra">Sempre no último domingo antes do carnaval.</p>
    </div>
  </section>

  <!-- 7. O palco -->
  <section class="palco" aria-labelledby="t-palco" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-palco" class="titulo-secao" data-anima="sobe">Quem já subiu no palco</h2>
    <p class="palco-nomes">
      {palco.map((a) => <span>{a.nome}{a.de && <sup>{a.de}</sup>}</span>)}
    </p>
    <p class="t-pequeno">Lista em construção.</p>
  </section>

  <!-- 8. Posicionamento. Paleta fechada (TEMAS_DE_POSICAO em lib/temas.ts): enquanto este trecho
       está na tela, a página usa só as cores permitidas. Aqui o destaque trabalha de verdade:
       faixa cheia e adesivos, para nenhuma das paletas ficar apagada. Rascunho a revisar. -->
  <section class="posicao" aria-labelledby="t-posicao" data-tema={atributo(TEMAS_DE_POSICAO[0])} data-tema-lista={TEMAS_DE_POSICAO.map(atributo).join(';')}>
    <div class="posicao-faixa">
      <h2 id="t-posicao" class="titulo-secao">De que lado a gente está</h2>
      <p class="t-gigante posicao-frase">LGBTQIA+ e de esquerda.</p>
      <p class="posicao-sub">Sempre foi, e a gente nunca escondeu.</p>
    </div>
    <ol class="adesivos">
      {posicoes.map((x, i) => (
        <li style={`--giro:${[-2.5, 1.5, -1, 2.5, -1.8][i % 5]}deg`}><span>{x.ano}</span>{x.frase}</li>
      ))}
    </ol>
    <div class="posicao-grade">
      <div class="posicao-texto" data-anima="surge">
        <p>Existir em público já é tomar posição, e a gente ocupa a pista e a rua desde 2009. Quando o país cobrou que cada um dissesse de que lado estava, a gente disse: contra o golpe que tirou Dilma e contra o governo Temer que saiu dele. Depois, contra Bolsonaro e tudo o que ele representou para quem é LGBTQIA+.</p>
        <p>Nas eleições de 2022 e de 2026 fizemos campanha por Lula, e mais de uma vez fomos atração voluntária em manifestações nas ruas de Belo Horizonte. Apoiamos com frequência candidaturas do PT e do PSOL.</p>
        <p>É pelo mesmo motivo que já levamos o nosso trio para a Parada do Orgulho LGBTQIA+ de BH e que criamos a nossa própria Parada, em 2020. Festa, para nós, sempre foi um jeito de fazer política.</p>
      </div>
      <ul class="posicao-fotos" aria-label="Fotos de atos e Paradas (marcação)">
        {['Ato (marcação)', 'Parada de BH (marcação)', 'Ato (marcação)', 'Parada da @bsurda (marcação)'].map((rotulo, i) => (
          <li class:list={{ torto: i % 2 === 0 }}><Capa proporcao="4 / 5" /><p>{rotulo}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. Além da pista, e o reconhecimento -->
  <section class="alem" aria-labelledby="t-alem" data-tema="sorteio" data-reserva={reserva}>
    <h2 id="t-alem" class="t-grande" data-anima="sobe">Além da pista</h2>
    <ul class="alem-lista">
      {alem.map((a) => (
        <li data-anima="surge"><h3>{a.titulo}</h3><p>{a.texto}</p></li>
      ))}
    </ul>
    <h3 class="titulo-secao premios-titulo">Reconhecimento</h3>
    <ul class="premios">
      {premios.map((x) => <li><strong>{x.titulo}</strong><span>{x.de}</span></li>)}
    </ul>
  </section>

  <!-- 10. Fecho -->
  <section class="fecho">
    <figure class="janela janela-baixa" data-paralaxe>
      <img src="/sobre/pista-1.jpg" alt="Pista de uma festa da @bsurda" loading="lazy" />
    </figure>
    <p class="t-grande">A próxima página dessa história já tem data.</p>
    <p class="fecho-botoes"><Botao href="/agenda" tipo="cheio">Ver a agenda</Botao><Botao href="/equipe" tipo="linha">Quem faz a @bsurda</Botao></p>
  </section>
</Base>

<script>
  // O número preso mostra o ano do grupo que está no meio da tela. Só os algarismos
  // que mudam se movem, como um contador. O marco em leitura acende.
  const num = document.querySelector<HTMLElement>('.marcos-num');
  const idade = document.querySelector<HTMLElement>('.marcos-idade');
    const itens = [...document.querySelectorAll<HTMLElement>('.marcos-item')];
  if (num && itens.length > 0) {
    document.documentElement.classList.add('marcos-vivos');
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)');
    const casas = [...num.querySelectorAll('span')];
    let atual = num.textContent ?? '';
    const mostrar = (ano: string) => {
      if (ano === atual) return;
      const sobe = Number(ano) > Number(atual);
      [...ano].forEach((d, i) => {
        const casa = casas[i];
        if (!casa || casa.textContent === d) return;
        casa.textContent = d;
        if (!calmo.matches) casa.animate([{ transform: `translateY(${sobe ? 28 : -28}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
      });
      atual = ano;
      if (idade) { const n = Number(ano) - 2009; idade.textContent = n === 0 ? 'o começo' : n === 1 ? '1 ano de festa' : `${n} anos de festa`; }
    };
    if (idade) idade.textContent = 'o começo';
    let pedido = 0;
    const medir = () => {
      pedido = 0;
      const meio = window.innerHeight * 0.45;
      let perto: HTMLElement | null = null, menor = Infinity;
      for (const it of itens) {
        const r = it.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - meio);
        if (d < menor) { menor = d; perto = it; }
      }
      for (const it of itens) it.classList.toggle('aceso', it === perto);
      // O ano do número é sempre o do marco aceso, para os dois nunca se desencontrarem.
      mostrar(perto?.closest<HTMLElement>('.marcos-grupo')?.dataset.ano ?? atual);
    };
    const pedir = () => { if (!pedido) pedido = requestAnimationFrame(medir); };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    medir();
  }

  // ---------- O resto da página ----------
  const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Números da abertura: contam de zero até o valor, uma vez, quando entram na tela.
  const contadores = document.querySelectorAll<HTMLElement>('[data-conta]');
  if (contadores.length > 0 && !semMovimento.matches) {
    const ver = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        ver.unobserve(e.target);
        const el = e.target as HTMLElement;
        const alvo = Number(el.dataset.conta);
        const inicio = performance.now();
        const passo = (agora: number) => {
          const t = Math.min(1, (agora - inicio) / 1400);
          el.textContent = String(Math.round(alvo * (1 - Math.pow(1 - t, 4))));
          if (t < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      }
    }, { threshold: 0.6 });
    contadores.forEach((c) => ver.observe(c));
  }

  // Carrossel dos lugares improváveis: as setas andam um cartão por vez.
  const fila = document.querySelector<HTMLElement>('.improvaveis');
  document.querySelectorAll<HTMLButtonElement>('[data-rolar]').forEach((b) => {
    b.addEventListener('click', () => {
      const cartao = fila?.querySelector('li');
      if (!fila || !cartao) return;
      fila.scrollBy({ left: Number(b.dataset.rolar) * (cartao.getBoundingClientRect().width + 24), behavior: semMovimento.matches ? 'auto' : 'smooth' });
    });
  });

  // Fotos em paralaxe e o trio: tudo no mesmo passo de rolagem.
  const janelas = [...document.querySelectorAll<HTMLElement>('[data-paralaxe]')];
  const secaoTrio = document.querySelector<HTMLElement>('.trio');
  const quadros = [...document.querySelectorAll<HTMLElement>('.trio-quadro')];
  let quadroAtual = 0;
  let naFila = 0;
  const rolar = () => {
    naFila = 0;
    const tela = window.innerHeight;
    if (!semMovimento.matches) {
      for (const j of janelas) {
        const r = j.getBoundingClientRect();
        if (r.bottom < 0 || r.top > tela) continue;
        // De -1 (entrando por baixo) a 1 (saindo por cima)
        const p = (r.top + r.height / 2 - tela / 2) / (tela / 2 + r.height / 2);
        j.style.setProperty('--desvio', `${(p * -7).toFixed(2)}%`);
      }
    }
    if (secaoTrio && quadros.length > 0) {
      const r = secaoTrio.getBoundingClientRect();
      const curso = r.height - tela;
      const p = curso > 0 ? Math.min(0.999, Math.max(0, -r.top / curso)) : 0;
      const i = Math.floor(p * quadros.length);
      if (i !== quadroAtual) {
        quadros[quadroAtual]?.classList.remove('ativo');
        quadros[i]?.classList.add('ativo');
        quadroAtual = i;
      }
