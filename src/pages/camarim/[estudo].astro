---
import Base from '../../layouts/Base.astro';
import Temas from '../../components/camarim/Temas.astro';
import { TEMAS_DO_SITE } from '../../lib/temas';

export function getStaticPaths() {
  return process.env.WORKERS_CI_BRANCH === 'tst-camarim' ? [{ params: { estudo: 'temas-em-lista' } }] : [];
}
---

<Base titulo="Camarim · Temas em lista" descricao="Estudo de apresentação das paletas da @bsurda." tema={TEMAS_DO_SITE[0]} semIndice>
  <div class="estudo">
    <h1 class="t-grande" id="site">Camarim</h1>
    <Temas lista />
  </div>
</Base>

<style>
  .estudo { width: min(100% - 2 * var(--margem), 80rem); margin-inline: auto; padding-block: var(--e-5); }
  h1 { margin-bottom: var(--e-4); }
</style>
