---
import Base from '../layouts/Base.astro';
import Eco from '../components/Eco.astro';
import Faixa from '../components/Faixa.astro';
import PainelEvento from '../components/PainelEvento.astro';
import CartaoEvento from '../components/CartaoEvento.astro';
import Arroba from '../components/marca/Arroba.astro';
import { SITE } from '../config';
import { getEventos } from '../lib/eventos';
import Botao from '../components/Botao.astro';
import { atributo, temaPara, TEMAS_DO_SITE } from '../lib/temas';
import { getCollection } from 'astro:content';
import palavras from '../data/palavras.json';

const { proximos, passados } = await getEventos();
const [destaque, ...outros] = proximos;
// Na Home entram o destaque e até mais três.
const seguintes = outros.slice(0, 3);
const projetos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
// Parede de palavras: a lista fica em src/data/palavras.json, uma linha por fileira.
const fileiras: string[][] = palavras;
// Cada palavra é cheia, na cor de destaque ou só em contorno. A sequência é
// irregular de propósito, para não virar listra (cor sim, cor não).
const estilos = ['', 'cor', '', 'vazada', '', '', 'cor', 'vazada', '', 'cor', '', '', 'vazada', 'cor', '', 'vazada', '', 'cor', 'cor', '', 'vazada', '', '', 'cor', '', 'vazada', '', ''];
// Imagens que flutuam pela parede: as capas das edições mais recentes.
// Cada uma tem posição, velocidade de subida e a camada (entre quais fileiras passa).
const capas = passados.filter((e) => e.capa).slice(0, 5);
// "lado" vai de 0 (encostada à esquerda) a 1 (à direita); "camada" diz entre quais fileiras passa.
const flutuantes = [
  { lado: 0.08, giro: -3, camada: 3 },
  { lado: 0.9, giro: 2.5, camada: 9 },
  { lado: 0.42, giro: 1.5, camada: 5 },
  { lado: 0.78, giro: -2, camada: 13 },
  { lado: 0.16, giro: 3, camada: 7 },
];
// A abertura do site veste as cores do próximo evento.
const temaInicial = destaque?.tema ?? TEMAS_DO_SITE[0];
---
<Base tema={temaInicial}>
  <section class="abertura" data-tema={atributo(temaInicial)}>
    <Eco />
    <p class="lema"><span aria-hidden="true"></span><span class="lema-texto">Festa pop LGBTQIA+ de Belo Horizonte.<br />{SITE.lema}, desde 2009.</span><span aria-hidden="true"></span></p>
  </section>

  {destaque
    ? <PainelEvento evento={destaque} destaque />
    : (
      <section class="secao">
        <p class="t-grande">Nenhuma data anunciada no momento.</p>
        <p class="t-apoio" style="margin-top:1.5rem">As próximas aparecem aqui assim que os ingressos abrirem. Enquanto isso, acompanhe pelo <a href={SITE.redes.instagram}>Instagram</a>.</p>
      </section>
    )}

  <!-- Depois do destaque, os próximos em cartões compactos, lado a lado.
       Se houver só mais um, ele continua no bloco grande. -->
  {seguintes.length === 1 && <PainelEvento evento={seguintes[0]} />}
  {seguintes.length > 1 && (
    <section class="seguintes" aria-labelledby="t-seguintes">
      <h2 id="t-seguintes" class="titulo-secao" data-anima="sobe">Próximas datas</h2>
      <div class="seguintes-fila" style={`--n:${seguintes.length}`}>
        {seguintes.map((e) => <CartaoEvento evento={e} />)}
      </div>
    </section>
  )}

  {proximos.length > 0 && (
    <p class="ver-agenda"><Botao href="/agenda" tipo="linha">Agenda completa e eventos passados</Botao></p>
  )}

  <!-- Daqui para baixo a página fica num único tema do site, sorteado a cada visita. -->
  <div data-tema="sorteio" data-reserva={atributo(TEMAS_DO_SITE[0])}>
  <Faixa texto={`${SITE.lema} desde 2009`} />

  <!-- Parede em movimento. A seção fica presa na tela enquanto se rola: as fileiras
       correm para lados opostos e as capas das últimas edições surgem de baixo,
       atravessam as fileiras (por cima de umas, por baixo de outras) e somem no topo. -->
  <section class="historia" aria-labelledby="t-sobre" data-parede>
    <div class="historia-pino">
      <div class="historia-grupo">
        <h2 id="t-sobre" class="historia-titulo" data-anima="sobe">17 anos de @bsurda</h2>
        <p class="so-leitor">{fileiras.flat().join('. ')}.</p>
        <div class="parede" aria-hidden="true">
          {fileiras.map((linha, i) => (
            <div class="parede-fileira" style={`z-index:${i * 2 + 2}`}>
              <div class:list={['parede-trilho', { contra: i % 2 === 0 }]} style={`--dur:${30 + (i * 11) % 17}s`}>
                {[0, 1, 2].map(() => (
                  <div class="parede-grupo">
                    {linha.map((p, j) => <span class={estilos[(i * 4 + j) % estilos.length]}>{p}<i></i></span>)}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      {capas.map((e, i) => (
        <img class="parede-foto" src={e.capa} alt="" loading="lazy" data-flutua={i}
          style={`--lado:${flutuantes[i].lado};--giro:${flutuantes[i].giro}deg;--topo:${8 + i * 17}%;z-index:${flutuantes[i].camada}`} />
      ))}
      <div class="historia-fim">
        <p class="t-apoio">{SITE.descricao}</p>
        <Botao href="/sobre">A história da @bsurda</Botao>
      </div>
    </div>
  </section>

  <section class="secao projetos" aria-labelledby="t-projetos">
    <h2 id="t-projetos" class="titulo-secao" data-anima="sobe">Projetos</h2>
    <ul class="indice">
      {projetos.map((p, i) => (
        <li data-anima="linha" style={`--i:${i}`}>
          <a href={`/projetos/${p.id}`} data-espia={p.data.capa ?? ''} data-espia-cores={atributo(temaPara(p.id))}>
            <span class="indice-nome"><span data-anima="sobe" style={`--i:${i}`}>{p.data.nome}</span></span>
            <span class="indice-resumo">{p.data.resumo}</span>
          </a>
        </li>
      ))}
    </ul>
    <!-- Prévia que acompanha o cursor no índice de projetos -->
    <div class="espia" aria-hidden="true"><img alt="" hidden /><Arroba /></div>
    <p class="projetos-fim"><Botao href="/projetos" tipo="linha">Todos os projetos</Botao></p>
  </section>

  <Faixa texto="Foi? Se ache nas fotos" contra />

  <section class="secao fotos" aria-labelledby="t-fotos">
    <h2 id="t-fotos" class="t-gigante ecoa" data-eco="Se ache nas fotos" data-anima="eco">Se ache nas fotos</h2>
    <div class="fotos-fim" data-anima="surge">
      <p class="t-apoio">As fotos de todas as edições ficam no nosso Pixieset, separadas por festa.</p>
      <Botao href={SITE.fotos} externo>Fotos no Pixieset</Botao>
    </div>
  </section>
  </div>
</Base>

<script>
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Parede: cada capa atravessa a tela de baixo para cima, mais rápido que a
  // rolagem, uma depois da outra.
  const parede = document.querySelector<HTMLElement>('[data-parede]');
  const fotos = [...document.querySelectorAll<HTMLElement>('[data-flutua]')];
  if (parede && fotos.length > 0 && !calmo) {
    parede.classList.add('viva');
    const pino = parede.querySelector<HTMLElement>('.historia-pino')!;
    let marcado = false;
    const mover = () => {
      marcado = false;
      const r = parede.getBoundingClientRect();
      const tela = window.innerHeight;
      if (r.bottom < -tela || r.top > tela * 2) return;
      // O percurso começa com a seção ainda entrando (topo no meio da tela) e
      // termina com ela já saindo: a parada em si é curta.
      const p = (tela * 0.5 - r.top) / r.height;
      const topoDoPino = pino.getBoundingClientRect().top;
      for (const foto of fotos) {
        const i = Number(foto.dataset.flutua);
        const q = (p - i * 0.13) / 0.48;
        foto.style.translate = `0 ${tela - q * (tela + foto.offsetHeight * 1.2) - topoDoPino}px`;
      }
    };
    window.addEventListener('scroll', () => { if (!marcado) { marcado = true; requestAnimationFrame(mover); } }, { passive: true });
    window.addEventListener('resize', mover);
    mover();
  }

  // Blocos de evento: a capa inclina de leve acompanhando o cursor.
  if (!calmo && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.ev').forEach((bloco) => {
      const capa = bloco.querySelector<HTMLElement>('.ev-capa img');
      if (!capa) return;
      bloco.addEventListener('pointermove', (e) => {
        const r = bloco.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        capa.style.transform = `perspective(900px) rotateY(${x * 7}deg) rotateX(${-y * 7}deg)`;
      });
      bloco.addEventListener('pointerleave', () => { capa.style.transform = ''; });
    });
  }

  // Índice de projetos: uma prévia acompanha o cursor, nas cores do projeto.
  // A página em si não muda de cor.
  const espia = document.querySelector<HTMLElement>('.espia');
  const imagem = espia?.querySelector('img');
  if (espia && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-espia-cores]').forEach((el) => {
      el.addEventListener('pointerenter', () => {
        const [fundo, , destaque] = el.dataset.espiaCores!.split('|');
        espia.style.setProperty('--espia-fundo', fundo);
        espia.style.setProperty('--espia-cor', destaque);
        if (imagem) { imagem.hidden = !el.dataset.espia; if (el.dataset.espia) imagem.src = el.dataset.espia; }
        espia.classList.add('visivel');
      });
      el.addEventListener('pointerleave', () => espia.classList.remove('visivel'));
      el.addEventListener('pointermove', (e) => {
        espia.style.setProperty('--x', `${e.clientX}px`);
        espia.style.setProperty('--y', `${e.clientY}px`);
        espia.style.setProperty('--giro', `${Math.max(-8, Math.min(8, e.movementX * 0.6))}deg`);
      });
    });
  }
</script>

<style>
  .abertura { padding: 0 var(--margem) clamp(2rem, 5vw, 4rem); }
  .lema { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: clamp(0.5rem, 2vw, 1.5rem); text-align: center; font-size: clamp(0.8125rem, 1.5vw, 1.125rem); font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; line-height: 1.9; }
  /* Barras inclinadas nas pontas, no ângulo das letras do logo */
  .lema > span:not(.lema-texto) { flex: none; width: clamp(0.55rem, 1vw, 0.9rem); height: clamp(2.75rem, 5vw, 4.5rem); background: currentColor; transform: skewX(26.5deg); }

  :global(.js) .lema { animation: lema-abre 1s cubic-bezier(0.62, 0.05, 0.01, 0.99) 0.25s both; }
  :global(.js) .lema-texto { animation: lema-texto 0.8s ease 0.75s both; }
  @keyframes lema-abre { from { padding-inline: 38%; opacity: 0; } 30% { opacity: 1; } to { padding-inline: 0; } }
  @keyframes lema-texto { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { :global(.js) .lema, :global(.js) .lema-texto { animation: none; } }

  .seguintes { padding: var(--e-4) var(--margem) 0; }
  .seguintes-fila { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--e-3); }
  /* No celular os cartões viram uma fila que se arrasta para o lado: o próximo
     aparece pela metade para mostrar que tem mais. */
  @media (max-width: 820px) {
    .seguintes { padding-right: 0; }
    .seguintes-fila { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-right: var(--margem); padding-bottom: 0.5rem; }
    .seguintes-fila::-webkit-scrollbar { display: none; }
    .seguintes-fila > :global(*) { flex: none; width: 78vw; scroll-snap-align: start; }
  }
  .ver-agenda { padding: var(--e-3) var(--margem) var(--e-5); text-align: center; }

  .historia { position: relative; }
  .historia-pino { position: relative; isolation: isolate; overflow: clip; display: flex; flex-direction: column; justify-content: center; gap: var(--e-4); padding: var(--e-5) 0; }
  /* Com movimento: a seção prende por pouco tempo (meia tela de rolagem) */
  .historia.viva { height: 150vh; height: calc(100svh + 50vh); }
  .historia.viva .historia-pino { position: sticky; top: 0; height: 100vh; height: 100svh; padding: var(--e-3) 0; }
  .historia-titulo, .historia-fim { position: relative; padding: 0 var(--margem); }
  /* O título anda junto com as palavras: é a primeira linha da parede */
  .historia-titulo { z-index: 20; margin-bottom: var(--e-2); font-size: var(--t-4); font-weight: 800; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; }
  .parede { display: grid; }
  .parede-fileira { position: relative; }
  /* Cada fileira são três grupos iguais andando juntos: quando um sai, o outro já entrou */
  .parede-trilho { display: flex; width: max-content; }
  .parede-grupo { flex: none; display: flex; animation: parede-corre var(--dur, 34s) linear infinite; will-change: transform; }
  .parede-trilho.contra .parede-grupo { animation-direction: reverse; }
  .parede-grupo span { display: flex; align-items: center; font-size: clamp(2.75rem, 9.2vw, 9.5rem); font-weight: 800; line-height: 0.92; letter-spacing: -0.045em; text-transform: uppercase; white-space: nowrap; }
  /* Presa na tela, a parede se mede pela altura: sete fileiras enchem a tela */
  .historia.viva .parede-grupo span { font-size: clamp(2.25rem, 9vh, 9rem); font-size: clamp(2.25rem, 9svh, 9rem); }
  .parede-grupo span.cor { color: var(--destaque); }
  .parede-grupo span.vazada { color: transparent; -webkit-text-stroke: 0.022em var(--texto); }
  /* Entre as palavras, a barra inclinada do logo */
  .parede-grupo i { flex: none; width: 0.13em; height: 0.66em; margin: 0 0.3em; background: var(--texto); opacity: 0.45; transform: skewX(26.5deg); }
  @keyframes parede-corre { to { transform: translateX(-100%); } }
  .parede-foto { --w: clamp(11rem, 25vw, 24rem); position: absolute; top: var(--topo); left: calc((100% - var(--w)) * var(--lado)); width: var(--w); aspect-ratio: 16 / 9; object-fit: cover; border-radius: clamp(0.6rem, 1.2vw, 1rem); box-shadow: 0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.55); rotate: var(--giro); pointer-events: none; will-change: translate; }
  .historia.viva .parede-foto { top: 0; translate: 0 110vh; }
  @media (max-width: 720px) { .parede-foto { --w: 52vw; } }
  @media (prefers-reduced-motion: reduce) { .parede-grupo { animation: none; } }
  .historia-fim { z-index: 20; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--e-3) var(--e-4); }

  /* Índice de projetos. As linhas se desenham ao entrar na tela. Ao passar o
     mouse, duas barras inclinadas entram pelas laterais, sem deslocar o texto. */
  .indice li { border-top: 1.5px solid transparent; }
  :global(html:not(.js)) .indice li { border-top-color: var(--texto); }
  .indice li:last-child { border-bottom: 1.5px solid var(--texto); }
  .indice { position: relative; }
  .indice a { position: relative; z-index: 2; display: grid; grid-template-columns: 1.7fr 1fr; gap: 0.5rem 2rem; align-items: center; padding: clamp(0.9rem, 2vw, 1.6rem) clamp(1.75rem, 3.2vw, 3.25rem); text-decoration: none; }
  .indice a::before, .indice a::after { content: ''; position: absolute; top: 22%; bottom: 22%; width: clamp(0.5rem, 0.9vw, 0.85rem); background: var(--destaque); opacity: 0; transition: transform 0.5s cubic-bezier(0.62, 0.05, 0.01, 0.99), opacity 0.3s; }
  .indice a::before { left: 0.35rem; transform: translateX(-3rem) skewX(26.5deg); }
  .indice a::after { right: 0.35rem; transform: translateX(3rem) skewX(26.5deg); }
  .indice a:hover::before, .indice a:hover::after, .indice a:focus-visible::before, .indice a:focus-visible::after { opacity: 1; transform: translateX(0) skewX(26.5deg); }
  /* A prévia fica atrás dos nomes e à frente das linhas divisórias */
  .projetos { isolation: isolate; }
  .projetos-fim { margin-top: var(--e-4); text-align: right; }
  .indice-nome { font-size: clamp(2rem, 6.2vw, 5.75rem); font-weight: 800; line-height: 0.92; letter-spacing: -0.04em; text-transform: uppercase; }
  .indice-nome > span { display: block; }
  .indice-resumo { max-width: 24em; }
  @media (max-width: 720px) { .indice a { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .indice a::before, .indice a::after { transition: none; } }

  .espia { border-radius: clamp(0.6rem, 1.2vw, 1rem); position: fixed; left: 0; top: 0; z-index: 1; width: clamp(11rem, 18vw, 17rem); aspect-ratio: 4 / 5; display: grid; place-items: center; overflow: hidden; background: var(--espia-fundo, var(--texto)); color: var(--espia-cor, var(--fundo)); pointer-events: none; opacity: 0; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(0.85); transition: opacity 0.2s, transform 0.18s ease-out; }
  .espia.visivel { opacity: 1; transform: translate(calc(var(--x, 0px) + 1.5rem), calc(var(--y, 0px) - 50%)) rotate(var(--giro, 0deg)) scale(1); }
  .espia img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .espia :global(svg) { width: 46%; }

  .fotos h2 { max-width: 9em; }
  .fotos-fim { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--e-3) var(--e-4); margin-top: var(--e-4); }

  .so-leitor { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
