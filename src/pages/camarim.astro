---
import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
import Marca from '../components/camarim/Marca.astro';
import Site from '../components/camarim/Site.astro';
import { partes } from '../components/camarim/capitulos';
import { TEMAS_DO_SITE } from '../lib/temas';
---
<Base titulo="Camarim" descricao="A marca e o sistema visual da @bsurda." tema={TEMAS_DO_SITE[0]} temas={[TEMAS_DO_SITE[0]]} semIndice>
  <header class="abre abre-cima">
    <div class="abertura">
      <div>
        <p class="etiqueta">@bsurda</p>
        <h1 class="t-gigante ecoa ecoa-cima" data-eco="Camarim">Camarim</h1>
        <p class="t-apoio">Guia de bastidor de quem monta a @bsurda. Aqui você baixa a marca, prova as cores e encontra as peças do site.</p>
      </div>
      <div class="original">
        <p class="etiqueta">Marca completa · 2024</p>
        <img src="/marca/absurda_principal_completo.svg" width="884" height="141" alt="Assinatura horizontal da @bsurda" />
        <Botao tipo="linha" href="/marca/absurda_principal_completo.svg" download>Baixar SVG escuro</Botao>
      </div>
    </div>
    <nav aria-labelledby="indice">
      <h2 id="indice" class="etiqueta">Índice</h2>
      <div class="partes">
        {partes.map(({ nome, capitulos }) => (
          <div>
            <p class="titulo-secao">{nome}</p>
            <ol start={Number(capitulos[0].numero)}>
              {capitulos.map(({ id, titulo, numero }) => <li><a href={'#' + id}><span class="etiqueta">{numero}</span><span class="t-medio">{titulo}</span></a></li>)}
            </ol>
          </div>
        ))}
      </div>
    </nav>
  </header>
  <Marca />
  <Site />
</Base>
<style>
  .abertura { display: grid; grid-template-columns: minmax(0, 2.6fr) minmax(0, 1fr); gap: var(--e-4); align-items: end; }
  .abertura .t-apoio { max-width: min(31em, 100%); }
  .original { display: grid; justify-items: start; gap: var(--e-3); align-content: space-between; background: #f5f5f5; color: #231f20; --botao-fundo: #231f20; --botao-destaque: #231f20; padding: var(--e-3); border-radius: var(--raio-cartao); rotate: 1deg; }
  .original img { width: 100%; height: auto; }
  nav { margin-top: var(--e-5); }
  .partes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--e-4); margin-top: var(--e-2); }
  ol { margin-top: var(--e-2); }
  li { border-top: 1px solid var(--linha); }
  li:last-child { border-bottom: 1px solid var(--linha); }
  li a { display: grid; grid-template-columns: 2.5em 1fr; gap: var(--e-1); align-items: baseline; padding-block: var(--e-1); text-decoration: none; }
  li a:hover, li a:focus-visible { color: var(--destaque-texto); }
  li a:hover span:last-child, li a:focus-visible span:last-child { text-decoration: underline; text-underline-offset: .14em; }
  @media (max-width: 800px) {
    .abertura, .partes { grid-template-columns: 1fr; gap: var(--e-3); }
    .original { gap: var(--e-2); }
  }
</style>
