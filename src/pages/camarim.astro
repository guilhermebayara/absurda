---
import Base from '../layouts/Base.astro';
import Marca from '../components/camarim/Marca.astro';
import Site from '../components/camarim/Site.astro';
import { partes } from '../components/camarim/capitulos';
import { TEMAS_DO_SITE } from '../lib/temas';
---
<Base titulo="Camarim" descricao="A marca e o sistema visual da @bsurda." tema={TEMAS_DO_SITE[0]} temas={[TEMAS_DO_SITE[0]]} semIndice>
  <header class="abre abre-cima">
    <p class="etiqueta">@bsurda</p>
    <h1 class="t-gigante ecoa ecoa-cima" data-eco="Camarim">Camarim</h1>
    <p class="t-apoio">Guia de trabalho de quem monta a @bsurda, com a marca para baixar e as peças do site para consultar. Só chega aqui quem tem o endereço.</p>
    <nav aria-labelledby="indice">
      <h2 id="indice" class="etiqueta">Índice</h2>
      <div class="partes">
        {partes.map(({ nome, capitulos }) => (
          <div>
            <p class="t-medio">{nome}</p>
            <ol start={Number(capitulos[0].numero)}>
              {capitulos.map(({ id, titulo, numero }) => <li><a href={'#' + id}><span class="etiqueta">{numero}</span>{titulo}<span aria-hidden="true">↗</span></a></li>)}
            </ol>
          </div>
        ))}
      </div>
    </nav>
  </header>
  <Marca />
  <Site />
</Base>
<style>
  nav { margin-top: var(--e-4); }
  .partes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--e-3); margin-top: var(--e-2); }
  ol { margin-top: var(--e-2); }
  li { border-top: 1px solid var(--linha); }
  li:last-child { border-bottom: 1px solid var(--linha); }
  a { display: flex; gap: var(--e-2); align-items: baseline; padding-block: var(--e-1); text-decoration: none; font-weight: 700; }
  a:hover, a:focus-visible { color: var(--destaque-texto); text-decoration: underline; }
  a span:last-child { margin-left: auto; }
</style>
