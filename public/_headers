# Cabeçalhos que a Cloudflare acrescenta às respostas do site.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Arquivos gerados pelo build (CSS, fontes, scripts): o nome muda quando o conteúdo muda,
# então o navegador pode guardar por um ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Capas do arquivo de eventos: uma vez guardadas, não mudam mais.
/arquivo/*
  Cache-Control: public, max-age=2592000

/estado.json
  X-Robots-Tag: noindex
/arquivo-pendente.json
  X-Robots-Tag: noindex
